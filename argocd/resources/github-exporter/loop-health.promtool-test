              description: "2500 hosted-runner minutes this month (3000 included, resets monthly). Per repo: sum by (repo, sku) (github_billing_usage{product=~\"(?i)actions\", unit=~\"(?i)min.*\"})."
      # THE WITNESS: same restart, same 33 minutes
      - eval_time: 61m
