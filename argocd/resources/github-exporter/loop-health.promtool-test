  # ── GithubRateLimitLow 3/3 — THE PRICE: a refilled pool keeps reading drained for ≤10m ───────
  # The mirror image of choosing `min`. GitHub resets the pool on the hour; for up to a range
  # window afterwards `min_over_time` still reports the low-water sample, so the alert clears late
  # and `{{ $value }}` reads the worst of the window rather than the newest. Bounded and exact —
  # the last drained sample (t=20m) leaves the range at t=30m.
  - interval: 1m
    name: "accepted cost: a pool that resets keeps reading drained for ≤10m"
    input_series:
      - series: 'github_rate_limit_remaining{token="coordinator-git",resource="graphql",endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "400+0x20 5000+0x100"
      - series: 'github_rate_limit_limit{token="coordinator-git",resource="graphql",endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "5000+0x120"
    promql_expr_test:
      - expr: min by (token, resource) (min_over_time(github_rate_limit_remaining[10m]) / max_over_time(github_rate_limit_limit[10m]))
        eval_time: 29m
        exp_samples:
          - labels: '{token="coordinator-git", resource="graphql"}'
            value: 0.08
      - expr: min by (token, resource) (min_over_time(github_rate_limit_remaining[10m]) / max_over_time(github_rate_limit_limit[10m]))
        eval_time: 30m
        exp_samples:
          - labels: '{token="coordinator-git", resource="graphql"}'
            value: 1
    alert_rule_test:
      # both forms page while the pool is genuinely drained
      - eval_time: 6m
        alertname: GithubRateLimitLowPre331
        exp_alerts:
          - exp_labels:
              severity: warning
              token: coordinator-git
              resource: graphql
            exp_annotations:
              summary: "GitHub rate-limit pool under 10% (coordinator-git/graphql)"
      # the pool resets at 21m: the pre-#331 form clears at once, the shipped one holds ≤10m
      - eval_time: 25m
        alertname: GithubRateLimitLowPre331
        exp_alerts: []
      - eval_time: 25m
        alertname: GithubRateLimitLow
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              token: coordinator-git
              resource: graphql
            exp_annotations:
              summary: "GitHub rate-limit pool under 10% (coordinator-git/graphql)"
              description: "coordinator-git has 8% of its graphql pool left — consumers of this installation will start erroring \"API rate limit exceeded\" when it reaches 0; the pool resets at github_rate_limit_reset_timestamp."
      - eval_time: 31m
        alertname: GithubRateLimitLow
        exp_alerts: []

  # ── GithubPaidUsage — the roll, and the DOUBLE COUNT a bare `sum(max_over_time(…))` produces ──
  # `sum()` is label-less, so this alert never had an identity to churn — but what it sums does:
  # every billing series carries `pod`/`instance`, so for the ≤10m the range holds both pod
  # generations a bare `sum(max_over_time(…))` counts each SKU TWICE. The promql assertions below
  # are that claim, executed at the overlap instant: 2.50 from the mechanical port against the real
  # 1.25. On a $1 threshold that is a page a roll invented, and a money figure reported at 2x in
  # the annotation the operator reads. Dropping identity INSIDE the sum is what makes it 1.25.
  # The `for: 1h` half is the ordinary one: a 2-minute hole used to throw away a full hour.
  - interval: 1m
    name: "a poller roll neither re-clocks GithubPaidUsage's `for: 1h` nor doubles the bill"
    input_series:
      - series: 'github_billing_net_amount{org="teststuffstash",product="Actions",sku="Actions Linux",unit="Minutes",repo="homelab",visibility="private",endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "0.75+0x30 stale"
      - series: 'github_billing_net_amount{org="teststuffstash",product="Packages",sku="Packages Storage",unit="GigabyteHours",repo="oracle-fleet",visibility="private",endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "0.5+0x30 stale"
      - series: 'github_billing_net_amount{org="teststuffstash",product="Actions",sku="Actions Linux",unit="Minutes",repo="homelab",visibility="private",endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-p7t2r",service="github-exporter"}'
        values: "_x33 0.75+0x120"
      - series: 'github_billing_net_amount{org="teststuffstash",product="Packages",sku="Packages Storage",unit="GigabyteHours",repo="oracle-fleet",visibility="private",endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-p7t2r",service="github-exporter"}'
        values: "_x33 0.5+0x120"
    promql_expr_test:
      # the shipped expr, at an instant where both pod generations are inside the range
      - expr: sum(max without (instance, pod) (max_over_time(github_billing_net_amount[10m])))
        eval_time: 35m
        exp_samples:
          - labels: "{}"
            value: 1.25
      # the mechanical port at the same instant — every SKU counted once per pod generation
      - expr: sum(max_over_time(github_billing_net_amount[10m]))
        eval_time: 35m
        exp_samples:
          - labels: "{}"
            value: 2.5
    alert_rule_test:
      - eval_time: 59m
        alertname: GithubPaidUsage
        exp_alerts: []
      - eval_time: 61m
        alertname: GithubPaidUsage
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
            exp_annotations:
              summary: "GitHub is billing real money this month"
              description: "Month-to-date net spend is $1.25 (expected $0 — everything inside included usage). Break it down by SKU: sum by (product, sku, repo) (github_billing_net_amount)."
      # THE WITNESS: `sum()` over an empty vector is empty, an empty expr is a resolved alert, and
      # a resolved alert restarts `for: 1h` — 33 minutes late off a 2-minute roll
      - eval_time: 61m
        alertname: GithubPaidUsagePre331
        exp_alerts: []
      - eval_time: 92m
        alertname: GithubPaidUsagePre331
        exp_alerts: []
      - eval_time: 94m
        alertname: GithubPaidUsagePre331
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "GitHub is billing real money this month"

  # ── GithubActionsMinutesHigh — the same shape on the quota alert, plus the selector ──────────
  # Identical mechanism to GithubPaidUsage (the two are one idiom), so this case carries the parts
  # that are NOT identical: the selector has to keep excluding the storage SKUs (`unit=~"(?i)min.*"`)
  # and public-repo usage (`visibility="private"`), and the annotation prints the deduped total —
  # 2500 minutes, not the 5000 the mechanical port would report mid-roll. The two decoy series
