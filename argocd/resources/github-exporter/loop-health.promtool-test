        values: "5000+0x120"
    alert_rule_test:
      # shipped: condition true from 46m, `for: 5m` → 51m
      - eval_time: 50m
        alertname: GithubRateLimitLow
        exp_alerts: []
      - eval_time: 52m
        alertname: GithubRateLimitLow
        exp_alerts:
