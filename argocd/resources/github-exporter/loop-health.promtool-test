        values: "_x33 1300+0x120"
      - series: 'github_billing_usage{org="teststuffstash",product="Actions",sku="Actions Linux",unit="Minutes",repo="oracle-fleet",visibility="private",endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-p7t2r",service="github-exporter"}'
        values: "_x33 1200+0x120"
      # decoys: the storage SKU under the same product, and a public repo's minutes
      - series: 'github_billing_usage{org="teststuffstash",product="Actions",sku="Actions Storage",unit="GigabyteHours",repo="homelab",visibility="private",endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-p7t2r",service="github-exporter"}'
        values: "9000+0x160"
      - series: 'github_billing_usage{org="teststuffstash",product="Actions",sku="Actions Linux",unit="Minutes",repo="oracle-prober",visibility="public",endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-p7t2r",service="github-exporter"}'
        values: "9000+0x160"
    promql_expr_test:
      - expr: sum(max without (instance, pod) (max_over_time(github_billing_usage{product=~"(?i)actions", unit=~"(?i)min.*", visibility="private"}[10m])))
        eval_time: 35m
        exp_samples:
          - labels: "{}"
            value: 2500
      - expr: sum(max_over_time(github_billing_usage{product=~"(?i)actions", unit=~"(?i)min.*", visibility="private"}[10m]))
        eval_time: 35m
        exp_samples:
