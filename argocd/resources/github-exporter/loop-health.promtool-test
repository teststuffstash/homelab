# Behaviour fixture for github-exporter's loop/poller liveness alerts (FU-158 behaviour half,
# homelab#288). The second fixture over this rule file; queued-age.promtool-test (#284) was first.
#
#   devbox run -- promtool test rules argocd/resources/github-exporter/loop-health.promtool-test
#
# Named .promtool-test, not .yaml: manifest-lint kubeconforms every *.yaml under argocd/resources.
# CLOCK: promtool's test clock starts at 0, so a "last successful poll at epoch 0" simply means
# "never since the test began" and `time() - it` is the age. CI-enforced since 2026-08-11:
# .github/workflows/ci.yaml runs `devbox run prometheus-rules-lint`, which runs `promtool test
# rules` over every *.promtool-test under argocd/.
#
# ✅ THE HEADLINE FINDING OF THIS FILE IS RESOLVED (homelab#312): AgentQueueStalled (FU-091) used
# to be unable to fire in production. Both of its "zero" conjuncts are aggregates over metrics
# emitted PER OBJECT — one series per live worker pod, one per OPEN PR (github-exporter.py, "1 per
# open PR") — so an idle loop means zero series, and `sum()` over no series is EMPTY, not 0: the
# bare `sum(...) == 0` form left the `and` chain nothing to match, precisely in the state the
# alert was built for. Live confirmation, 2026-08-11: the worker-pod aggregate was present at only
# 343 of 865 five-minute steps over three days — absent 60% of the time, and absent exactly when
# the loop is idle. The fix is the `or vector(0)` idiom RetroReportOverdue already uses
# (argocd/resources/pushgateway/prometheusrule.yaml); `or vector(0)` collapses labels, but both
# conjuncts were already label-less `sum()`s, so the `and` chain still matches. Tests 1/3 and 2/3
# below are the regression pins: they assert the two production shapes now FIRE, and they fail if
# the defaults are ever dropped again.
#
# ✅ THE FILE'S SECOND FINDING IS ALSO RESOLVED (homelab#313): GithubExporterStale carried the #288
# restart-gap class — a scraped, single-replica gauge under a `for:` window, so a poller roll
# mid-staleness restarted the clock under a new pod identity. Fixed with #288's two-part shape
# (`max by (job)` + `max_over_time([10m])`); the test that used to PIN the defect now pins the fix,
# and the pre-#313 expr rides along as GithubExporterStalePre313 (loop-health.promtool-rules
# §regression-witness-pre-313) so the contrast, the [10m] ceiling and the cost of aggregating are
# all executed rather than claimed.
rule_files:
  - loop-health.promtool-rules

evaluation_interval: 1m

tests:
  # ── AgentQueueStalled 1/3 — the real idle-loop shape: queued work, nothing running ───────────
  # 5 queued issues, no worker pods in existence, no open PRs. This IS the 2026-07-21 wedge
  # (a sidecar zombie held project-WIP for three days), and it is the shape that used to be
  # invisible: neither zero-conjunct has any series to aggregate, so both rest entirely on their
  # `or vector(0)` default. THE regression pin for homelab#312 — drop either default and this
  # test goes silent again.
  - interval: 1m
    name: "queued issues + a genuinely idle loop fires (both zero-conjuncts default via `or vector(0)`)"
    input_series:
      - series: 'github_agent_issue_labels{label="agent/queued",owner="teststuffstash",repo="oracle-fleet"}'
        values: "3+0x400"
      - series: 'github_agent_issue_labels{label="agent/queued",owner="teststuffstash",repo="circles"}'
        values: "2+0x400"
    alert_rule_test:
      # `for: 2h` honoured — silent before it elapses
      - eval_time: 1h59m
        alertname: AgentQueueStalled
        exp_alerts: []
      - eval_time: 2h1m
        alertname: AgentQueueStalled
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Agent queue stalled — queued issues but a fully idle loop"
              description: "5 agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape."
      # …and stays firing while the wedge lasts (the 2026-07-21 wedge ran for days)
      - eval_time: 6h
        alertname: AgentQueueStalled
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Agent queue stalled — queued issues but a fully idle loop"
              description: "5 agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape."

  # ── AgentQueueStalled 2/3 — the mixed shape: one conjunct real, one defaulted ────────────────
  # Lingering Succeeded pod objects DO give the pod-phase conjunct its series (kube-state-metrics
  # emits every phase for every existing pod, so Running/Pending read 0) — that half aggregates
  # to a real 0. The PR conjunct still has no series and rides `or vector(0)`. Firing here proves
  # the two paths compose: a real label-less `sum()` of 0 and a synthetic `vector(0)` match each
  # other in the `and` chain (both have an empty label set, which is why the idiom is safe here).
  - interval: 1m
    name: "pod objects present and reading 0, open-PR conjunct defaulted — still fires"
    input_series:
      - series: 'github_agent_issue_labels{label="agent/queued",owner="teststuffstash",repo="oracle-fleet"}'
        values: "5+0x400"
      - series: 'kube_pod_status_phase{namespace="oracle-agents",phase="Running",pod="agent-oracle-fleet-issue-30-r1",uid="a1"}'
        values: "0+0x400"
      - series: 'kube_pod_status_phase{namespace="oracle-agents",phase="Pending",pod="agent-oracle-fleet-issue-30-r1",uid="a1"}'
        values: "0+0x400"
    alert_rule_test:
      - eval_time: 2h1m
        alertname: AgentQueueStalled
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Agent queue stalled — queued issues but a fully idle loop"
              description: "5 agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape."
      - eval_time: 6h
        alertname: AgentQueueStalled
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Agent queue stalled — queued issues but a fully idle loop"
              description: "5 agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape."

  # ── AgentQueueStalled 3/3 — every conjunct backed by a real series, and the recovery edge ────
  # Before #312 this was the only shape that could fire, because it is the one where the PR
  # conjunct has a series to aggregate: a `github_pull_request_open` valued 0. The exporter never
  # emits that (it appends `github_pull_request_open{...} 1` per open PR and nothing otherwise),
  # which is exactly why 1/3 and 2/3 were dead — but the shape is still worth keeping: it pins
  # that adding the `or vector(0)` defaults did not change behaviour when the series ARE present,
  # and it is the only fixture here that exercises the way DOWN (a worker pod goes Running at
  # 2h4m and the alert clears immediately — there is no `for:` on the falling edge).
  - interval: 1m
    name: "unchanged with real series on every conjunct, and one live worker pod clears it"
    input_series:
      - series: 'github_agent_issue_labels{label="agent/queued",owner="teststuffstash",repo="oracle-fleet"}'
        values: "5+0x400"
      # …and a worker pod finally starts at 2h4m, which is what ends the alert
      - series: 'kube_pod_status_phase{namespace="oracle-agents",phase="Running",pod="agent-oracle-fleet-issue-30-r1",uid="a1"}'
        values: "0+0x123 1+0x50"
      - series: 'github_pull_request_open{number="259",owner="teststuffstash",repo="oracle-fleet"}'
        values: "0+0x400"
    alert_rule_test:
      # `for: 2h` honoured
      - eval_time: 1h59m
        alertname: AgentQueueStalled
        exp_alerts: []
      - eval_time: 2h1m
        alertname: AgentQueueStalled
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Agent queue stalled — queued issues but a fully idle loop"
              description: "5 agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape."
      # one live worker pod ends it immediately — there is no `for:` on the way down
      - eval_time: 2h5m
        alertname: AgentQueueStalled
        exp_alerts: []

  # ── GithubExporterDown — scrape liveness, `for: 15m` ─────────────────────────────────────────
  # The companion to GithubExporterStale: a dead pod has no last_success gauge to age, so only
  # `up == 0` can see that case. Both are needed and neither covers the other.
  - interval: 1m
    name: a 5m scrape blip stays silent; 15m of down fires
    input_series:
      - series: 'up{endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "1+0x10 0+0x5 1+0x10 0+0x60"
    alert_rule_test:
      # the 5-minute blip (11m…16m) never reaches 15m
      - eval_time: 16m
        alertname: GithubExporterDown
        exp_alerts: []
      - eval_time: 25m
        alertname: GithubExporterDown
        exp_alerts: []
      # down again from 27m; 14m in, still pending
      - eval_time: 40m
        alertname: GithubExporterDown
        exp_alerts: []
      - eval_time: 43m
        alertname: GithubExporterDown
        exp_alerts:
          - exp_labels:
              severity: warning
              endpoint: http-metrics
              instance: 10.244.2.91:9504
              job: github-exporter
              namespace: monitoring
              pod: github-exporter-5c6d9f4f76-kcmdn
              service: github-exporter
            exp_annotations:
              summary: "github-exporter is not being scraped"
              description: "The GitHub poller pod is down or unreachable for 15m — no CI-failure or billing alerts until it's back. Usually the token Secret is missing (ExternalSecret github-exporter-token) or the pod crashed."

  # ── GithubExporterStale — the PAT-expiry reminder, `for: 30m` on top of a 30m threshold ──────
  # The base case, unchanged by #313: the pod is up and scraping, it just cannot complete a poll.
  # Total time to page is ~60m by construction (30m of staleness before the condition is true, then
  # `for: 30m`). The alert now carries only `severity` + `job` — dropping `pod`/`instance` from the
  # alert's identity is half of the #313 fix, and this is where that shows.
  - interval: 1m
    name: a poller that stops succeeding pages at ~60m
    input_series:
      # never succeeded since the test clock began
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "0+0x120"
    alert_rule_test:
      # 30m: the condition has just turned true, `for: 30m` has not run
      - eval_time: 31m
        alertname: GithubExporterStale
        exp_alerts: []
      - eval_time: 59m
        alertname: GithubExporterStale
        exp_alerts: []
      - eval_time: 62m
        alertname: GithubExporterStale
        exp_alerts:
          - exp_labels:
              severity: warning
              job: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
              description: "No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens)."

  # ── GithubExporterStale — a healthy poller never fires ───────────────────────────────────────
  # The other half of the old base-case test, split out because after #313 a healthy instance and a
  # stuck one can no longer be asserted in the SAME test (see the masking case below — that is now
  # its own, deliberate, assertion). A timestamp that tracks the clock (60s per sample) has an age
  # of ~0 and never approaches the 1800s threshold.
  - interval: 1m
    name: a poller that keeps succeeding never fires
    input_series:
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.99:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-hh8vq",service="github-exporter"}'
        values: "0+60x120"
    alert_rule_test:
      - eval_time: 62m
        alertname: GithubExporterStale
        exp_alerts: []
      - eval_time: 120m
        alertname: GithubExporterStale
        exp_alerts: []

  # ── GithubExporterStale — ✅ the #288 restart-gap class, FIXED here (homelab#313) ─────────────
  # `github_exporter_last_success_timestamp` carries `pod`/`instance`, so before #313 a poller roll
  # during a stale spell restarted the 30m window under a new identity and the page slipped from
  # ~60m to ~72m — further in production, where staleness markers kill the old series at the roll
  # instead of 5m later. This test used to PIN that defect; it now pins the fix, with the pre-#313
  # expr kept beside it as GithubExporterStalePre313 so the contrast is executed on every run:
  # at 65m the witness has nothing (its window died with the old pod) while the shipped alert has
  # been firing since ~61m, and at 73m the witness finally re-pages 12 minutes late.
  - interval: 1m
    name: "a poller roll mid-staleness no longer restarts the `for:` window (the #288 class, fixed)"
    input_series:
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "0+0x40"
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.93:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-p7t2r",service="github-exporter"}'
        values: "_x42 0+0x80"
    alert_rule_test:
      # `for: 30m` is still honoured across the roll — the window runs from 31m, not from 0m
      - eval_time: 60m
        alertname: GithubExporterStale
        exp_alerts: []
      # ~60m, on time, straight through the 2m hole: max_over_time([10m]) bridged it and
      # `max by (job)` kept the identity, so this is one continuous alert instance.
      - eval_time: 62m
        alertname: GithubExporterStale
        exp_alerts:
          - exp_labels:
              severity: warning
              job: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
              description: "No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens)."
      - eval_time: 65m
        alertname: GithubExporterStale
        exp_alerts:
          - exp_labels:
              severity: warning
              job: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
              description: "No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens)."
      # …and the witness is silent at that same moment: without the roll it would have fired at
      # ~60m, but the old pod's window died with it.
      - eval_time: 65m
        alertname: GithubExporterStalePre313
        exp_alerts: []
      - eval_time: 73m
        alertname: GithubExporterStale
        exp_alerts:
          - exp_labels:
              severity: warning
              job: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
              description: "No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens)."
      # the witness pages 30m after the NEW pod's first sample (42m + 30m), 12m late and under a
      # different identity — the cost this fix removes, still measured rather than asserted away.
      - eval_time: 73m
        alertname: GithubExporterStalePre313
        exp_alerts:
          - exp_labels:
              severity: warning
              endpoint: http-metrics
              instance: 10.244.2.93:9504
              job: github-exporter
              namespace: monitoring
              pod: github-exporter-5c6d9f4f76-p7t2r
              service: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"

  # ── GithubExporterStale — THE CEILING, asserted rather than assumed ──────────────────────────
  # [10m] is a bridge, not immunity — the same accepted limit #288 wrote down. A hole longer than
  # the range (crash-loop, image pull off a cold mirror, node drain) empties the vector for real
  # and costs the full 30m again. Widening the range would not be free either: it is also how long
  # a stale reading keeps being believed after the poller is replaced.
  - interval: 1m
    name: a 13m hole DOES reset the window — the accepted limit of [10m]
    input_series:
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.94:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-ccc31",service="github-exporter"}'
        values: "0+0x30"
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.95:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-6d7e8a9b1c-ddd42",service="github-exporter"}'
        values: "_x43 0+0x60"
    alert_rule_test:
      # 42m: the [10m] range window holds no sample at all — the alert resolves, exactly as the
      # pre-#313 form would have
      - eval_time: 42m
        alertname: GithubExporterStale
        exp_alerts: []
      # …and it re-fires 30m after the new pod's first sample (43m + 30m), not before
      - eval_time: 72m
        alertname: GithubExporterStale
        exp_alerts: []
      - eval_time: 74m
        alertname: GithubExporterStale
        exp_alerts:
          - exp_labels:
              severity: warning
              job: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
              description: "No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens)."

  # ── GithubExporterStale — the PRICE of `max by (job)`: a healthy instance masks a stuck one ───
  # The reverse face of the fix, asserted so the trade is a fact in a test rather than a claim in a
  # comment. Two instances, one stuck and one healthy: the shipped alert stays silent (the freshest
  # success in the job wins), while the pre-#313 per-pod expr pages for the stuck pod.
  # This is UNREACHABLE in production — the Deployment is `replicas: 1` — and it is the same
  # property that makes a roll safe, because a fresh pod publishes `..._last_success_timestamp 0`
  # until its first successful poll and must NOT outrank the outgoing pod's real value. If this
  # exporter is ever scaled out, this test is the one that has to change first.
  - interval: 1m
    name: "accepted cost: a healthy instance masks a stuck one (unreachable at replicas: 1)"
    input_series:
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.91:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-kcmdn",service="github-exporter"}'
        values: "0+0x120"
      - series: 'github_exporter_last_success_timestamp{endpoint="http-metrics",instance="10.244.2.99:9504",job="github-exporter",namespace="monitoring",pod="github-exporter-5c6d9f4f76-hh8vq",service="github-exporter"}'
        values: "0+60x120"
    alert_rule_test:
      - eval_time: 62m
        alertname: GithubExporterStale
        exp_alerts: []
      - eval_time: 120m
        alertname: GithubExporterStale
        exp_alerts: []
      # the pre-#313 expr did page here — this is what the aggregation costs, in full
      - eval_time: 62m
        alertname: GithubExporterStalePre313
        exp_alerts:
          - exp_labels:
              severity: warning
              endpoint: http-metrics
              instance: 10.244.2.91:9504
              job: github-exporter
              namespace: monitoring
              pod: github-exporter-5c6d9f4f76-kcmdn
              service: github-exporter
            exp_annotations:
              summary: "github-exporter polls are failing"
