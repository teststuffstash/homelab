# Behaviour fixture for GithubCiWallTimeDrift (prometheusrule.yaml, group github-ci-drift — the
# group comment there is the alert's one home for WHY; this file pins WHAT it does).
#
#   devbox run -- promtool test rules argocd/resources/github-exporter/loop-health-ci-drift.promtool-test
#
# Its own pair, not loop-health.promtool-test: the 21–28-day baseline puts the eval clock at
# 1008h (6 weeks), and promtool evaluates every rule in rule_files at every step out to that.
# evaluation_interval 1h = the production group's `interval: 1h`, so the `for: 6h` edge below is
# pinned at the cadence it really runs at.
#
# INPUT SCHEME (every series below follows it — check any expectation against it):
#   run i starts at hour h(i) = 8i + 1 and its series carries 3 hourly samples (h, h+1, h+2)
#   (a real run's series lives ~24h in the poll window; its length does not matter, because
#   max_over_time collapses each series to one value). One series per run id, labels trimmed to
#   the ones the expr reads (+ pod where the dedupe is the point).
#   A window "(T−7d, T]" contains run i iff h(i)+2 > T−168 and h(i) ≤ T (ranges are left-open).
#
# CLOCK: promtool's test clock starts at 0, so `offset 21d` before day 21 reads nothing.
rule_files:
  - loop-health-ci-drift.promtool-rules

evaluation_interval: 1h

tests:
  # ── 1 — THE W33→W41 SHAPE: weekly medians 100 → 125 → 155 → 190 → 235 → 290 s ─────────────
  # Week w = hours [168w, 168w+168); a run takes its week's value. 126 runs, i = 0..125.
  #  • 656h: baseline (−16h, 152h] holds runs with h(i) ≤ 152 → i = 0..18 = 19 runs < 20 —
  #    silent on the RUN-COUNT GUARD, though the ratio is already 1.9×.
  #  • 657h: i = 0..19 = 20 runs → guard met. Baseline median 100 (all week 0); current
  #    (489h, 657h] = i = 61..82: 2 × 155 (week 2) + 20 × 190 (week 3) → median 190 > 1.5 × 100,
  #    > 120 floor, current count 22 ≥ 20 → condition TRUE, pending.
  #  • 662h: pending 5h < for: 6h → not yet. 663h: firing. Value: current (495h, 663h] =
  #    i = 62..82: 1 × 155 + 20 × 190 → 190 s = "3m 10s".
  #  • 1008h (day 42): current (840h, 1008h] = i = 105..125, all week 5 → 290 s ("4m 50s");
  #    baseline (336h, 504h] = i = 42..62, all week 2 → 155 s; 290 > 232.5 → firing.
  - interval: 1h
    name: "a W33→W41-shaped creep fires once both windows hold 20 runs, after for: 6h"
