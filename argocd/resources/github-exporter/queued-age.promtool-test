# Behaviour fixture for CiDispatchStalled (FU-150 OURS half, homelab#284) — replays the two
# recorded "CI cannot dispatch" incidents against the committed alert.
#
#   devbox run -- promtool test rules argocd/resources/github-exporter/queued-age.promtool-test
#
# `devbox run prometheus-rules-lint` checks that every alert PARSES; this checks that this one
# FIRES on the shapes it was written for and stays quiet on the shapes that look like them. It is
# not wired into CI yet — homelab#288 (FU-158) owns the harness + wiring, and the two paths that
# would wire it here (.github/** and devbox.json) are outside this issue's surface. Run it by
# hand until then; the rules file it loads is drift-pinned by `devbox run exporter-self-test`.
#
# Named .promtool-test, not .yaml: manifest-lint kubeconforms every *.yaml under
# argocd/resources, and a non-manifest there would fail it.
#
# CLOCK: promtool's test clock starts at 0, so a run "created at t" carries the value t (seconds)
# rather than a real epoch — `time() - queued_since` is unaffected, which is the whole point of
# publishing a timestamp instead of a precomputed age.
rule_files:
  - queued-age.promtool-rules

evaluation_interval: 1m

tests:
  # ── Shape 1 — 2026-08-07, the ARC listener wedge ────────────────────────────────────────────
  # GitHub recovered at ~01:00 and our CI did not: the listener held the name of an
  # EphemeralRunnerSet deleted during the outage, so every ARC-backed run sat `queued` from 01:05
  # to 03:25 and homelab's queue grew 3 → 7. `in_progress` was 0 fleet-wide, no run ever failed,
  # and nothing alerted for five hours (docs/incidents/2026-08-07-arc-listener-wedge.md).
  - interval: 1m
    name: 2026-08-07 listener wedge — runs queued forever, zero failures
    input_series:
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="homelab",workflow="CI",branch="fix/issue-101-a",event="pull_request",number="41",attempt="1",id="30111111111",status="queued",conclusion="",runner="self-hosted"}'
        values: "0+0x180"
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="homelab",workflow="CI",branch="master",event="push",number="42",attempt="1",id="30122222222",status="queued",conclusion="",runner="self-hosted"}'
        values: "_x9 600+0x171"
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="oracle-fleet",workflow="CI",branch="fix/issue-60-b",event="pull_request",number="7",attempt="1",id="30133333333",status="queued",conclusion="",runner="self-hosted"}'
        values: "_x19 1200+0x161"
    alert_rule_test:
      - eval_time: 5m
        alertname: CiDispatchStalled
        exp_alerts: []
      # 14m of queue is still under the threshold — the alert does not ring on slow, it rings on stuck.
      - eval_time: 14m
        alertname: CiDispatchStalled
        exp_alerts: []
      # Threshold crossed at 15m, so `for: 10m` still holds it here — pending, not firing.
      - eval_time: 25m
        alertname: CiDispatchStalled
        exp_alerts: []
      # 26m: fired. THREE runs stuck across TWO repos produce exactly ONE alert — the
      # max by (owner, runner) collapse, so one root cause files one issue (the FU-133 class).
      - eval_time: 26m
        alertname: CiDispatchStalled
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              owner: teststuffstash
              runner: self-hosted
            exp_annotations:
              summary: "CI cannot dispatch: self-hosted runs queued 26m 0s"
              description: 'The oldest self-hosted workflow run in teststuffstash has waited 26m 0s for a runner (normal pickup ~20s). A queued run never fails, so no CI-failure alert can see this. Which runs: github_workflow_run_queued_since_timestamp{runner!="hosted"}. Check in this order: (1) githubstatus.com / GithubVendorOutage — vendor-side, and do NOT re-run queued work; (2) saturation vs breakage — a saturated pool has jobs RUNNING, a broken one has workers WAITING (maxRunners is 4, argocd/platform/arc-runners.yaml); (3) kubectl -n arc-runners get pods,ephemeralrunnersets,autoscalinglisteners, then the LISTENER POD''s own log — the 2026-08-07 wedge (docs/incidents/2026-08-07-arc-listener-wedge.md) was visible ONLY there; (4) WAN reachability from each runner node — 2026-08-11 (docs/incidents/2026-08-11-wk-metal-02-default-route-loss.md) was one node''s missing default route with the listener healthy.'
      # …and it keeps ringing for as long as the queue is dead (the real one ran 2h20m).
      - eval_time: 150m
        alertname: CiDispatchStalled
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              owner: teststuffstash
              runner: self-hosted
            exp_annotations:
              summary: "CI cannot dispatch: self-hosted runs queued 2h 30m 0s"
              description: 'The oldest self-hosted workflow run in teststuffstash has waited 2h 30m 0s for a runner (normal pickup ~20s). A queued run never fails, so no CI-failure alert can see this. Which runs: github_workflow_run_queued_since_timestamp{runner!="hosted"}. Check in this order: (1) githubstatus.com / GithubVendorOutage — vendor-side, and do NOT re-run queued work; (2) saturation vs breakage — a saturated pool has jobs RUNNING, a broken one has workers WAITING (maxRunners is 4, argocd/platform/arc-runners.yaml); (3) kubectl -n arc-runners get pods,ephemeralrunnersets,autoscalinglisteners, then the LISTENER POD''s own log — the 2026-08-07 wedge (docs/incidents/2026-08-07-arc-listener-wedge.md) was visible ONLY there; (4) WAN reachability from each runner node — 2026-08-11 (docs/incidents/2026-08-11-wk-metal-02-default-route-loss.md) was one node''s missing default route with the listener healthy.'

  # ── Shape 2 — 2026-08-11, wk-metal-02's lost default route ──────────────────────────────────
  # The discriminating case, and the reason this half is queued-age and not listener-zero: the
  # ARC listener was ALIVE and scaling the whole time. All CI concurrency was binpacked on one
  # node, that node lost its IPv4 default route, `acquirejob` failed, and the scale set deadlocked
  # at assigned=4 on stale broker assignments while every job read "Waiting for a runner" — across
  # three repos at once, ~09:02Z → ~11:00Z, with nothing alerting
  # (docs/incidents/2026-08-11-wk-metal-02-default-route-loss.md).
  - interval: 1m
    name: 2026-08-11 route loss — listener alive, queue starved across repos, then drained
    input_series:
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="snore-recorder",workflow="CI",branch="fix/issue-15-x",event="pull_request",number="15",attempt="1",id="31411111111",status="queued",conclusion="",runner="self-hosted"}'
        values: "0+0x118"
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="homelab",workflow="CI",branch="fix/issue-250-y",event="pull_request",number="250",attempt="1",id="31422222222",status="queued",conclusion="",runner="self-hosted"}'
        values: "_x14 900+0x104"
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="circles",workflow="CI",branch="fix/issue-79-z",event="pull_request",number="79",attempt="1",id="31433333333",status="mixed",conclusion="",runner="mixed"}'
        values: "_x29 1740+0x89"
    alert_rule_test:
      # Still inside threshold + `for:` — the first ~26 minutes of a stall are indistinguishable
      # from a busy queue, and that is deliberate.
      - eval_time: 10m
        alertname: CiDispatchStalled
        exp_alerts: []
      # Fires ~26m in, i.e. ~09:28Z against the recorded 09:02Z start — the incident was
      # diagnosed at 10:5xZ and resolved ~11:00Z, so this is ~90 minutes earlier than the human.
      # `runner="mixed"` is a SECOND alert series: not hosted, so not the vendor's, and a
      # mixed-runner run that cannot start is still our dispatch failing.
      - eval_time: 30m
        alertname: CiDispatchStalled
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              owner: teststuffstash
              runner: self-hosted
            exp_annotations:
              summary: "CI cannot dispatch: self-hosted runs queued 30m 0s"
              description: 'The oldest self-hosted workflow run in teststuffstash has waited 30m 0s for a runner (normal pickup ~20s). A queued run never fails, so no CI-failure alert can see this. Which runs: github_workflow_run_queued_since_timestamp{runner!="hosted"}. Check in this order: (1) githubstatus.com / GithubVendorOutage — vendor-side, and do NOT re-run queued work; (2) saturation vs breakage — a saturated pool has jobs RUNNING, a broken one has workers WAITING (maxRunners is 4, argocd/platform/arc-runners.yaml); (3) kubectl -n arc-runners get pods,ephemeralrunnersets,autoscalinglisteners, then the LISTENER POD''s own log — the 2026-08-07 wedge (docs/incidents/2026-08-07-arc-listener-wedge.md) was visible ONLY there; (4) WAN reachability from each runner node — 2026-08-11 (docs/incidents/2026-08-11-wk-metal-02-default-route-loss.md) was one node''s missing default route with the listener healthy.'
      # The remediation (cordon → drop the runner pods and the listener → queue drains) removes
      # the series, and the alert resolves on its own — no staleness handling anywhere.
      - eval_time: 130m
        alertname: CiDispatchStalled
        exp_alerts: []

  # ── Guard 1 — a hosted-runner queue is GitHub's problem, not ours ────────────────────────────
  # 2026-08-06/07 began as a genuine GitHub Actions major outage, and `update-pr-branch` (hosted)
  # kept running right through our own wedge. GithubVendorOutage owns that half; this alert must
  # stay silent so the two never contradict each other on one screen.
  - interval: 1m
    name: hosted runners queueing does not ring the OURS-side alert
    input_series:
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="homelab",workflow="update-pr-branch",branch="master",event="push",number="9",attempt="1",id="31500000000",status="queued",conclusion="",runner="hosted"}'
        values: "0+0x180"
    alert_rule_test:
      - eval_time: 30m
        alertname: CiDispatchStalled
        exp_alerts: []
      - eval_time: 150m
        alertname: CiDispatchStalled
        exp_alerts: []

  # ── Guard 2 — a slow-but-healthy pickup never rings, INCLUDING its phantom tail ──────────────
  # This is the false positive the design has to make impossible rather than merely unlikely: the
  # apparent queue age keeps climbing for a while AFTER the run is actually picked up, and it can
  # cross 900s without anything being wrong.
  #
  # Two tails stack up, and this case models the longer of them. In production the exporter
  # republishes its exposition every POLL_INTERVAL (120s) and serves the cached body in between,
  # so a run picked up at 12m50s is still advertised as queued until 14m50s — then the series
  # leaves the exposition, Prometheus writes a staleness marker, and the age stops dead. promtool
  # has no staleness marker: a series that simply ends stays readable for the full 5m PromQL
  # lookback, so this fixture keeps aging the run to 19m50s. That is a STRICTLY LONGER tail than
  # production can produce, which is what makes passing it meaningful.
  # On the rule's own 1m evaluation grid that leaves at most four consecutive pending evaluations
  # (16m…19m; at 20m the lookback is spent), so any `for:` above 5m is structurally safe and
  # `for: 10m` has margin. `for: 3m` fires here — that is the assertion below doing its job.
  - interval: 10s
    name: a pickup at 12m50s (worst-case phantom tail) never fires
    input_series:
      - series: 'github_workflow_run_queued_since_timestamp{owner="teststuffstash",repo="homelab",workflow="CI",branch="renovate/actions-checkout",event="pull_request",number="88",attempt="1",id="31600000000",status="queued",conclusion="",runner="self-hosted"}'
        values: "0+0x89"
    alert_rule_test:
      - eval_time: 14m50s
        alertname: CiDispatchStalled
        exp_alerts: []
      # the last evaluation the phantom survives to — pending at its longest, still not firing
      - eval_time: 19m
        alertname: CiDispatchStalled
        exp_alerts: []
      # lookback spent: the alert is gone without ever having fired
      - eval_time: 20m
        alertname: CiDispatchStalled
        exp_alerts: []
      - eval_time: 30m
        alertname: CiDispatchStalled
        exp_alerts: []
