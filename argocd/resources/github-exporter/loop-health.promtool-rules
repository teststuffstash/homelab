# witness-only: AgentQueueStalledPre330, GithubActionsMinutesHighPre331, GithubAppPermissionDriftPre331, GithubExporterStalePre313, GithubPaidUsagePre331, GithubRateLimitLowMaxDirection, GithubRateLimitLowPre331, GithubVendorOutagePre331
# The github-exporter alerts that carry a `for:` window over a single-replica scrape — the "is the
# loop / the poller alive" three plus the five persistent-condition alerts hardened in homelab#331
# — plus GithubWorkflowRunFailed (homelab#508: the no-`for:` latest-run expr, folded into this
# fixture so its suppression arms are behaviour-tested) — lifted VERBATIM out of
# prometheusrule.yaml (comments stripped, the manifest is their one home).
# This is the rules file that loop-health.promtool-test loads. Not a manifest and not applied to
# anything: `promtool test rules` needs upstream-format rules (top-level `groups:`), and a
# PrometheusRule keeps them under `.spec`, so the CR cannot be loaded directly. Named
# .promtool-rules rather than .yaml on purpose — manifest-lint kubeconforms EVERY *.yaml under
# argocd/resources and a non-manifest there would fail it.
#
# This is the SECOND fixture over github-exporter's rule file (queued-age.promtool-* was the
# first, FU-150/#284) and it covers 9 of the file's 13 alerts. The other 4 have no behaviour test
# yet — honest remaining work, listed in #331's PR body.
#
# ⚠ NOT DRIFT-PINNED (unlike queued-age.promtool-rules, which `devbox run exporter-self-test`
# checks): the general harness that would extract `.spec.groups` at run time lives in `scripts/**`
# + `.github/**`, outside the fixer lane's tier (homelab#337). Re-copy after editing an alert:
#
#   yq -o=json '{"groups": [{"name": "github", "rules": [.spec.groups[].rules[] | select(.alert == "AgentQueueStalled" or .alert == "GithubExporterDown" or .alert == "GithubExporterStale" or .alert == "GithubAppPermissionDrift" or .alert == "GithubVendorOutage" or .alert == "GithubRateLimitLow" or .alert == "GithubPaidUsage" or .alert == "GithubActionsMinutesHigh" or .alert == "GithubWorkflowRunFailed")]}]}' argocd/resources/github-exporter/prometheusrule.yaml | yq -P '.'
#
# ONE LINE on purpose — yq 4.x's lexer rejects a newline inside the expression ("lexer: invalid
# input text"), so the pretty-wrapped form this header carried until homelab#344 did not run as
# written (agent-router.promtool-rules' header states the same constraint). Verified by RUNNING
# the line above on 2026-08-12: its output is byte-identical to the `github` group below.
#
# …that command regenerates the `github` group ONLY. The `regression-witness-*` groups at the
# bottom are not in the CR and must survive the re-copy — re-append them (see their own headers).
groups:
  - name: github
    rules:
      - alert: GithubAppPermissionDrift
        expr: max by (app) (max_over_time(github_app_permission_drift[10m])) == 1
        for: 30m
        labels:
          severity: warning
          platform_machinery: "true"
        annotations:
          summary: GitHub App {{ $labels.app }} permissions differ from the declared state
          description: 'Live permissions of {{ $labels.app }} do not match docs/github-apps.yaml (github_app_permission_mismatch{app="{{ $labels.app }}"} carries the per-permission detail: declared vs live). Either finish the pending grant (UI click + approve on each installation) or PR the declaration.'
      - alert: GithubWorkflowRunFailed
        expr: >-
          (time() - github_workflow_run_updated_timestamp{conclusion=~"failure|startup_failure|timed_out", branch=~"master|main"}) < 3600
          unless (max by (repo, workflow, branch) (github_workflow_run_updated_timestamp{conclusion="success"})
          > on (repo, workflow, branch) group_right () github_workflow_run_updated_timestamp{conclusion=~"failure|startup_failure|timed_out"})
        labels:
          severity: warning
        annotations:
          summary: GitHub workflow {{ $labels.repo }}/{{ $labels.workflow }} failed
          description: 'Run #{{ $labels.number }} ({{ $labels.event }} on {{ $labels.branch }}) concluded {{ $labels.conclusion }}: https://github.com/{{ $labels.owner }}/{{ $labels.repo }}/actions/runs/{{ $labels.id }} — auto-resolves 1h after the run, or as soon as a newer run on the same branch succeeds (vendor blip).'
      - alert: GithubVendorOutage
        expr: max by (component) (max_over_time(github_vendor_component_status{component=~"Actions|API Requests|Git Operations|Webhooks|Packages"}[10m])) >= 2
        for: 10m
        labels:
          severity: warning
          triage: none
        annotations:
          summary: 'GitHub-side outage: {{ $labels.component }}'
          description: githubstatus.com reports {{ $labels.component }} at status index {{ $value }} (2=partial_outage, 3=major_outage). Vendor-side — in-cluster CI signals will LOOK broken (idle runners, frozen queues, no failures). Do NOT re-run queued work (re-runs deepen a dead queue) and do NOT change capacity settings off this state. https://www.githubstatus.com
      - alert: GithubPaidUsage
        expr: sum(max without (instance, pod) (max_over_time(github_billing_net_amount[10m]))) > 1
        for: 1h
        labels:
          severity: warning
          platform_machinery: "true"
        annotations:
          summary: GitHub is billing real money this month
          description: 'Month-to-date net spend is ${{ $value | printf "%.2f" }} (expected $0 — everything inside included usage). Break it down by SKU: sum by (product, sku, repo) (github_billing_net_amount).'
      - alert: GithubActionsMinutesHigh
        expr: sum(max without (instance, pod) (max_over_time(github_billing_usage{product=~"(?i)actions", unit=~"(?i)min.*", visibility="private"}[10m]))) > 2400
        for: 1h
        labels:
          severity: warning
          platform_machinery: "true"
        annotations:
          summary: GitHub Actions hosted minutes at 80% of included quota
          description: '{{ $value | printf "%.0f" }} hosted-runner minutes this month (3000 included, resets monthly). Per repo: sum by (repo, sku) (github_billing_usage{product=~"(?i)actions", unit=~"(?i)min.*"}).'
      - alert: GithubExporterDown
        expr: up{job="github-exporter"} == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: github-exporter is not being scraped
          description: The GitHub poller pod is down or unreachable for 15m — no CI-failure or billing alerts until it's back. Usually the token Secret is missing (ExternalSecret github-exporter-token) or the pod crashed.
      - alert: GithubExporterStale
        expr: time() - max by (job) (max_over_time(github_exporter_last_success_timestamp[10m])) > 1800
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: github-exporter polls are failing
          description: 'No fully successful GitHub poll for 30m+ — likely the PAT expired/was revoked. Re-mint: scripts/github-exporter-pat-bootstrap.sh (docs/github-setup.md §Tokens).'
      - alert: AgentQueueStalled
        expr: sum(max_over_time(github_agent_issue_labels{label="agent/queued"}[10m])) > 0 and (sum(kube_pod_status_phase{phase=~"Running|Pending", pod=~"agent-.+-(issue|pr)-[0-9]+-r[0-9]+|agent-.+-[0-9]{6}"}) or vector(0)) == 0 and (sum(github_pull_request_open) or vector(0)) == 0
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: Agent queue stalled — queued issues but a fully idle loop
          description: '{{ $value }} agent/queued issue(s) with zero live workers and zero open PRs for 2h — check the coordinate ticks (kubectl -n oracle-agents get wf), the WIP holds in the scan report, and agents/coordinator/TICK-LOG.md for the last incident shape.'
      - alert: GithubRateLimitLow
        expr: |-
          min by (token, resource) (
            min_over_time(github_rate_limit_remaining[10m]) / max_over_time(github_rate_limit_limit[10m])
          ) < 0.10
        for: 5m
        labels:
          severity: warning
          platform_machinery: "true"
        annotations:
          summary: GitHub rate-limit pool under 10% ({{ $labels.token }}/{{ $labels.resource }})
          description: '{{ $labels.token }} has {{ $value | humanizePercentage }} of its {{ $labels.resource }} pool left — consumers of this installation will start erroring "API rate limit exceeded" when it reaches 0; the pool resets at github_rate_limit_reset_timestamp.'

  # ── REGRESSION WITNESS — NOT a deployed rule, and deliberately not in prometheusrule.yaml ─────
  # The pre-#313 GithubExporterStale expr, kept verbatim so the fixture can assert the FAILURE it
  # fixes instead of merely asserting the fix. The roll cases in loop-health.promtool-test check
  # both alerts at the same eval times: this one goes silent across the roll and re-pages 12m late
  # under the new pod's identity, the shipped one never notices. Same device #288 used
  # (openrouter-proxy/subscription.promtool-rules §regression-witness-pre-288), and for the same
  # reason: it makes the contrast executed rather than claimed.
  # If GithubExporterStale's expr is revisited, this stays as it is — it is a fossil of what must
  # not come back, not a copy of the live rule. It is also why a STALE hand copy of the group above
  # cannot pass vacuously: with the old expr in both places the two alerts would agree, and every
  # roll assertion below fails.
  - name: regression-witness-pre-313
    rules:
      - alert: GithubExporterStalePre313
        expr: time() - github_exporter_last_success_timestamp > 1800
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: github-exporter polls are failing

  # ── REGRESSION WITNESS — the same device for homelab#330, and NOT a deployed rule ─────────────
  # AgentQueueStalled's expr as it stood AFTER #312 and BEFORE #330: both idle conjuncts already
  # carry `or vector(0)`, the queued conjunct is still bare. It is the strongest form the alert
  # ever had while still being unable to hold its window across a scrape gap, which is exactly the
  # claim #330 makes — pairing the fixed alert against THIS (rather than against the pre-#312 form)
  # is what keeps the contrast attributable to the bridge alone.
  # The gap case in loop-health.promtool-test checks both at the same eval times: the shipped alert
  # rides straight through two 3-minute holes and pages on schedule at 2h, this one restarts its
  # `for: 2h` at each hole and pages 2h33m late.
  # A fossil, not a copy: if AgentQueueStalled's expr is revisited again, this stays as it is.
  - name: regression-witness-pre-330
    rules:
      - alert: AgentQueueStalledPre330
        expr: sum(github_agent_issue_labels{label="agent/queued"}) > 0 and (sum(kube_pod_status_phase{phase=~"Running|Pending", pod=~"agent-.+-(issue|pr)-[0-9]+-r[0-9]+|agent-.+-[0-9]{6}"}) or vector(0)) == 0 and (sum(github_pull_request_open) or vector(0)) == 0
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: Agent queue stalled — queued issues but a fully idle loop

  # ── REGRESSION WITNESS — the same device for homelab#331, and NOT a deployed rule ─────────────
  # The five pre-#331 exprs, verbatim, one per alert the PR hardened. Each is checked at the SAME
  # eval times as its shipped twin in loop-health.promtool-test, so every claim the manifest makes
  # about the class ("the hole restarted this window") is executed against the form that had the
  # defect rather than asserted about it. `for:`, thresholds and `severity` are carried unchanged —
  # only the expr differs, which is what keeps the contrast attributable to the bridge alone.
  # These are fossils, not copies: if any of the five exprs is revisited, this group stays as it
  # is. It is also what stops a STALE hand copy of the `github` group above from passing vacuously
  # — with the old expr in both places the pairs would agree and every roll assertion fails.
  # Annotations are trimmed to `summary` (the same convention as the two witness groups above):
  # the fixture asserts WHEN each witness fires, and the description templates are pinned on the
  # shipped side.
  - name: regression-witness-pre-331
    rules:
      - alert: GithubAppPermissionDriftPre331
        expr: github_app_permission_drift == 1
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: GitHub App {{ $labels.app }} permissions differ from the declared state
      - alert: GithubVendorOutagePre331
        expr: github_vendor_component_status{component=~"Actions|API Requests|Git Operations|Webhooks|Packages"} >= 2
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'GitHub-side outage: {{ $labels.component }}'
      - alert: GithubPaidUsagePre331
        expr: sum(github_billing_net_amount) > 1
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: GitHub is billing real money this month
      - alert: GithubActionsMinutesHighPre331
        expr: sum(github_billing_usage{product=~"(?i)actions", unit=~"(?i)min.*", visibility="private"}) > 2400
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: GitHub Actions hosted minutes at 80% of included quota
      - alert: GithubRateLimitLowPre331
        expr: min by (token, resource) (github_rate_limit_remaining / github_rate_limit_limit) < 0.10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: GitHub rate-limit pool under 10% ({{ $labels.token }}/{{ $labels.resource }})
      # NOT a pre-fix form and NOT a proposal: the mechanical port, i.e. what GithubRateLimitLow
      # would be if the #313 idiom had been copied without asking which direction preserves the
      # alert. On a draining pool `max_over_time` reads the HEALTHIEST sample of the last 10m, so
      # the fixture's direction case shows it paging 9 minutes after the shipped alert — nearly
      # two of its `for: 5m` windows. Kept here so the manifest's claim (ii) is executed.
      - alert: GithubRateLimitLowMaxDirection
        expr: min by (token, resource) (max_over_time(github_rate_limit_remaining[10m]) / max_over_time(github_rate_limit_limit[10m])) < 0.10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: GitHub rate-limit pool under 10% ({{ $labels.token }}/{{ $labels.resource }})
