# Behaviour fixture for RegistryMirrorBlob5xxRate (homelab#1297 — the per-blob poison signature
# detection via registry debug metrics, same restart-gap class as RegistryMirrorProbeFailing).
#
#   devbox run -- promtool test rules argocd/resources/registry-cache/mirror-debug.promtool-test
#
# `devbox run prometheus-rules-lint` runs this in CI (it executes `promtool test rules` over every
# *.promtool-test under argocd/), so a red fixture here is a red required check. Named
# .promtool-test, not .yaml: manifest-lint kubeconforms every *.yaml under argocd/resources.
#
# WHAT IS BEING PINNED, in the order the argument runs:
#   1. THE HOLE — each mirror is `replicas: 1` and a roll gaps the registry's own metrics, so
#      the raw expr's `for: 10m` restarts. The [5m] range on rate() bridges the gap.
#   2. THE CEILING — a hole wider than [5m] still restarts it. Accepted, so asserted.
#   3. THE DIRECTION — rate(), because >0 is the bad reading. The class's default `max_over_time`
#      is loaded as a witness and shown arriving late.
#   4. THE PRICE — recovery is up to 5m late, asserted rather than claimed.
#   5. EACH MIRROR FIRES INDEPENDENTLY — three targets, one alertname, no cross-talk.
#
# ⚠ FIXTURE NOTE: `stale` in an input series injects a real staleness marker, which is exactly
# what Prometheus writes when a scrape fails — so the holes below bite instantly, with no 5m-
# lookback cushion, the way a real mirror roll does.
#
# CLOCK: promtool's test clock starts at 0 and `interval: 1m` matches the ServiceMonitor's own
# 60s interval, so one step here is one scrape.
#
# COUNTER MODEL: `registry_http_requests_total` is a counter. The input series values represent
# the cumulative count of 5xx blob responses. A value of "0+1x60" means the counter increases by
# 1 per minute (one 5xx per scrape), giving rate(5m) ≈ 0.0033/s > 0. A flat counter ("0+0x60")
# means no 5xx, rate = 0.
rule_files:
  - mirror-debug.promtool-rules

evaluation_interval: 1m

tests:
  # ── 1. THE HOLE: a mirror roll mid-outage does not restart the window ─────────────────────────
  # mirror-docker-io is genuinely returning 5xx on blob requests from t=0. At t=21 the mirror is
  # replaced — the scrape fails, Prometheus staleness-marks the counter series, and four minutes
  # pass before a real sample lands again. The mirror never recovered; only the measurement went
  # away. The [5m] range on rate() bridges the gap because samples from before the hole are still
  # in the range.
  - interval: 1m
    name: a mirror roll mid-outage does not restart the 10m window
    input_series:
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.20:5001",job="mirror-debug"}'
        values: "0+1x20 stale _x2 21+1x60"
    alert_rule_test:
      # `for: 10m` has not elapsed yet
      - eval_time: 9m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []
      - eval_time: 10m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: &docker_alert
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.20:5001
              job: mirror-debug
      # mid-hole, past the staleness marker: rate() still sees samples from t=16-20 in the [5m]
      # range, so the rate is still > 0 and the alert keeps firing.
      - eval_time: 21m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      - eval_time: 23m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      # …and it never stopped firing, so the recovery of the SCRAPE is a non-event
      - eval_time: 30m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      - eval_time: 80m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert

  # ── 2. THE CEILING — a hole wider than [5m] does still restart the window ─────────────────────
  # Accepted, not fixed: a crash-loop, cold image pull off a mirror, or a node drain outruns the
  # bridge. Asserted here so the limit is executed rather than assumed (the #313/#333 discipline).
  # Nine minutes of hole: last real sample t=20, first one after t=28.
  - interval: 1m
    name: a hole wider than the [5m] bridge does reset the 10m window (accepted ceiling)
    input_series:
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.20:5001",job="mirror-debug"}'
        values: "0+1x20 stale _x6 28+1x60"
    alert_rule_test:
      # still inside the bridge — t=20 is the newest sample in (15,20]
      - eval_time: 24m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      # past it: (15,25] holds nothing at all, and the alert really does drop
      - eval_time: 25m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []
      - eval_time: 26m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []
      # the counter returns at t=28 and pays a full fresh 10m
      - eval_time: 37m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []
      - eval_time: 38m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert

  # ── 3. THE DIRECTION — `max_over_time` is the class's default and the wrong function here ──────
  # Class rule (ii): max is alert-PRESERVING only where HIGH is the bad reading. Here >0 is bad,
  # so max holds the LOWEST rate of the window, and the range must fill entirely with 5xx before
  # it flips — delaying the page.
  # This test uses a witness rule loaded alongside the shipped one. The shipped expr uses rate()
  # and fires at t=15; the max_over_time witness is still pending at t=18.
  - interval: 1m
    name: rate() fires on schedule; max_over_time delays by nearly the whole range
    input_series:
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.20:5001",job="mirror-debug"}'
        values: "0+0x4 1+1x60"
    alert_rule_test:
      - eval_time: 14m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []
      - eval_time: 15m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      # the wrong direction is still pending here — 5xx happening since t=5, unreported
      - eval_time: 15m
        alertname: RegistryMirrorBlob5xxRateMaxDirection
        exp_alerts: []
      - eval_time: 18m
        alertname: RegistryMirrorBlob5xxRateMaxDirection
        exp_alerts: []
      - eval_time: 19m
        alertname: RegistryMirrorBlob5xxRateMaxDirection
        exp_alerts:
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.20:5001
              job: mirror-debug

  # ── 4. THE PRICE — recovery is up to 5m late, asserted rather than claimed ────────────────────
  # rate() means "5xx in the last 5m", so a recovered mirror leaves the alert ringing for up to
  # 5m after the first clean scrape. Against `for: 10m` on a mirror that was genuinely poisoned,
  # that is the cheaper fault — but it is a real cost, so it is asserted.
  - interval: 1m
    name: a recovered mirror clears the alert, up to 5m late
    input_series:
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.20:5001",job="mirror-debug"}'
        values: "0+1x29 29+0x40"
    alert_rule_test:
      - eval_time: 20m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      # 5xx stopped at t=29 (counter flat from t=29 onward) and STILL ringing: the bridge's cost
      - eval_time: 33m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: *docker_alert
      # ...and gone once the range window clears, ~5m after the fix
      - eval_time: 36m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts: []

  # ── 5. EACH MIRROR FIRES INDEPENDENTLY — no cross-talk between targets ────────────────────────
  # Three mirrors share the same alertname and job. A failure on one must not suppress or delay
  # the others. Here docker-io is 5xx-ing, ghcr is clean, and mcr is 5xx-ing — exactly two alerts.
  - interval: 1m
    name: each mirror fires independently — two failing, one clean, two alerts
    input_series:
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.20:5001",job="mirror-debug"}'
        values: "0+1x60"
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.21:5001",job="mirror-debug"}'
        values: "0+0x60"
      - series: 'registry_http_requests_total{handler="blob",code="500",instance="http://192.168.40.31:5001",job="mirror-debug"}'
        values: "0+1x60"
    alert_rule_test:
      - eval_time: 10m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts:
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.20:5001
              job: mirror-debug
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.31:5001
              job: mirror-debug
      - eval_time: 30m
        alertname: RegistryMirrorBlob5xxRate
        exp_alerts:
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.20:5001
              job: mirror-debug
          - exp_labels:
              severity: warning
              handler: blob
              code: "500"
              instance: http://192.168.40.31:5001
              job: mirror-debug