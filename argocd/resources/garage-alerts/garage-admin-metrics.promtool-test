# Behaviour fixture for the garage-admin-metrics alerts (FU-093 last unmetered tier).
#
#   devbox run -- promtool test rules argocd/resources/garage-alerts/garage-admin-metrics.promtool-test
#
# CLOCK: promtool's test clock starts at 0. Range selectors are LEFT-OPEN in Prometheus 3.x, so
# `[10m]` at t sees (t-10m, t] — a last real sample at T stays in range through T+9m at a 1m
# interval and is gone at T+10m. Every boundary claim below is pinned by a promql_expr_test rather
# than counted in a comment.
rule_files:
  - garage-admin-metrics.promtool-rules

evaluation_interval: 1m

tests:
  # ── 1/4 — DISK FILLING UP: the >80% threshold ───────────────────────────────────────────────
  # Garage's data disk is at 85% (avail/total = 0.15). The alert should fire after `for: 30m`.
  - interval: 1m
    name: "GarageDiskFillingUp fires after 30m when disk is >80% full"
    input_series:
      - series: 'garage_local_disk_avail{pod="garage-0",volume="data"}'
        values: "15+0x120"
      - series: 'garage_local_disk_total{pod="garage-0",volume="data"}'
        values: "100+0x120"
    alert_rule_test:
      # `for: 30m` honoured — silent before the window
      - eval_time: 29m
        alertname: GarageDiskFillingUp
        exp_alerts: []
      # fires at 30m
      - eval_time: 31m
        alertname: GarageDiskFillingUp
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              volume: data
            exp_annotations:
              summary: "Garage disk is 85% full on data"
              description: "Garage's disk has less than 20% available. The ledger's >80% threshold (docs/storage-ledger.md). Check the node's disk usage and whether the Longhorn volume or the underlying pve thin pool is filling. A full disk makes Garage go read-only — the 2026-08-24 meta wipe started this way."

  # ── 2/4 — DISK RECOVERS: the alert resolves when avail rises above 20% ──────────────────────
  # Disk was at 85% (avail=15), then space is freed and avail goes to 25. The alert should
  # resolve at the next evaluation after the condition clears.
  - interval: 1m
    name: "GarageDiskFillingUp resolves when disk drops below 80%"
    input_series:
      - series: 'garage_local_disk_avail{pod="garage-0",volume="data"}'
        values: "15+0x40 25+0x120"
      - series: 'garage_local_disk_total{pod="garage-0",volume="data"}'
        values: "100+0x200"
    alert_rule_test:
      # fires at 30m as before
      - eval_time: 31m
        alertname: GarageDiskFillingUp
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              volume: data
            exp_annotations:
              summary: "Garage disk is 85% full on data"
              description: "Garage's disk has less than 20% available. The ledger's >80% threshold (docs/storage-ledger.md). Check the node's disk usage and whether the Longhorn volume or the underlying pve thin pool is filling. A full disk makes Garage go read-only — the 2026-08-24 meta wipe started this way."
      # avail jumps to 25 at t=41m → ratio = 0.25, condition clears → alert resolves
      - eval_time: 42m
        alertname: GarageDiskFillingUp
        exp_alerts: []

  # ── 3/4 — TABLE EMPTY: the wipe detector ────────────────────────────────────────────────────
  # A table that held data drops to zero (the meta-wipe pattern). The alert should fire after
  # `for: 5m` from the drop, and only for the dropped table.
  - interval: 1m
    name: "GarageTableEmpty fires after 5m when a table drops to zero"
    input_series:
      - series: 'table_size{pod="garage-0",table_name="block"}'
        values: "1048576+0x20 0+0x60"
      - series: 'table_size{pod="garage-0",table_name="object"}'
        values: "1048576+0x60"
    alert_rule_test:
      # `for: 5m` honoured — silent before the drop window
      - eval_time: 25m
        alertname: GarageTableEmpty
        exp_alerts: []
      # fires at 5m after the drop (t=20) for the dropped table only
      - eval_time: 27m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: block
            exp_annotations:
              summary: "Garage table block is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."

  # ── 4/4 — TABLE RECOVERS: the alert resolves when data reappears ────────────────────────────
  # A table had data, dropped to zero (wipe), then data is restored (e.g. from snapshot). The
  # alert should fire after the drop and resolve at the next evaluation after the condition clears.
  - interval: 1m
    name: "GarageTableEmpty resolves when data reappears after a drop"
    input_series:
      - series: 'table_size{pod="garage-0",table_name="block"}'
        values: "1048576+0x20 0+0x20 1048576+0x120"
    alert_rule_test:
      # fires at 5m after the drop (t=20)
      - eval_time: 27m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: block
            exp_annotations:
              summary: "Garage table block is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."
      # data restored at t=40 → table_size=1048576 → condition clears → alert resolves
      - eval_time: 42m
        alertname: GarageTableEmpty
        exp_alerts: []
  # ── 5/8 — TABLE ALWAYS EMPTY: the false-positive guard ──────────────────────────────────────
  # A table that was always empty (by-design, like admin_token, k2v_index_counter_v2, etc.)
  # must NOT fire the alert — it never held data, so max_over_time(table_size[7d]) > 0 is
  # false for the entire window. This is the case that the old is-zero expr got wrong.
  - interval: 1m
    name: "GarageTableEmpty does NOT fire for a table that was always empty"
    input_series:
      - series: 'table_size{pod="garage-0",table_name="admin_token"}'
        values: "0+0x60"
    alert_rule_test:
      # never fires — no prior data means max_over_time is always 0
      - eval_time: 30m
        alertname: GarageTableEmpty
        exp_alerts: []

  # ── 6/9 — MPU CYCLING: a transient table that cycles 2→0 must NOT fire ────────────────────
  # multipart_upload and bucket_mpu_counter are transient by design — an in-flight multipart
  # upload makes them non-zero, and completing it returns them to zero. This is a normal 2→0
  # transition, and "held data in the last 7d" cannot distinguish it from the wipe pattern.
  # The deny-list (table_name !~ "multipart_upload|bucket_mpu_counter") is what drops them.
  - interval: 1m
    name: "GarageTableEmpty does NOT fire for a transient MPU table cycling 2→0"
    input_series:
      - series: 'table_size{pod="garage-0",table_name="multipart_upload"}'
        values: "2+0x10 0+0x60"
    alert_rule_test:
      # never fires — the deny-list excludes multipart_upload from matching
      - eval_time: 30m
        alertname: GarageTableEmpty
        exp_alerts: []

  # ── 7/9 — 7D WINDOW GUARD: a wipe still unrecovered past 24h keeps firing (the regression guard)
  # A table held data, then dropped to zero (the meta-wipe pattern), and stays empty for over a
  # week. The alert must keep firing at 48h (which the round-1 24h window would have missed) and
  # at 6d, and only stop after the 7d rolling window slides past the drop. This case pins the
  # documented tradeoff — the rolling window is not "was ever populated", and a wipe still
  # unrecovered 7 days after the drop stops alerting.
  - interval: 1m
    name: "GarageTableEmpty keeps firing on a wipe that stays unrecovered for days (the 24h-window regression guard)"
    input_series:
      - series: 'table_size{table_name="object",pod="garage-0"}'
        values: '100+0x120 0+0x2880'
    alert_rule_test:
      # fires at 3h — well within the 7d window
      - eval_time: 180m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."
      # fires at 48h — the load-bearing assertion: fails against 24h window, passes against 7d
      - eval_time: 2880m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."

  # ── 8/9 — 7D BOUNDARY: the rolling window slides past the drop after 7 days ────────────────
  # A table held data, dropped to zero, and stays empty. After 7 days the max_over_time window
  # no longer includes any sample > 0, so the alert stops firing. This case pins the documented
  # tradeoff — the rolling window is not "was ever populated".
  # ⚠ The alert_rule_test at the 7d boundary uses promql_expr_test rather than alert_rule_test
  # because promtool's range-query memory limit (~9900 samples) prevents a series long enough to
  # be alive at t=10260. The promql_expr_test directly evaluates the max_over_time clause that
  # distinguishes the new expr from the old one, proving the window has slid past the drop.
  - interval: 1m
    name: "GarageTableEmpty stops firing after the 7d rolling window slides past the drop"
    input_series:
      - series: 'table_size{table_name="object",pod="garage-0"}'
        values: '100+0x120 0+0x9850'
    alert_rule_test:
      # fires at 3h — well within the 7d window
      - eval_time: 180m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."
    promql_expr_test:
      # The max_over_time clause at 7d+1m: the window (121, 10201] excludes the last >0 sample
      # at t=120, so the expression returns no data — the alert would not fire.
      - expr: max_over_time(table_size[7d]) > 0
        eval_time: 10201m
        exp_samples: []

  # ── 9/9 — COVERAGE GUARD: a dead scrape is a page, not calm (seat, PR#965 gate read) ────────
  # Neither family exists (ServiceMonitor mismatch / metrics token / name drift). The two belts
  # above are structurally blind in this state; the guard is what says so.
  - interval: 1m
    name: "GarageAdminMetricsAbsent fires when the scrape serves neither family"
    input_series: []
    alert_rule_test:
      - eval_time: 29m
        alertname: GarageAdminMetricsAbsent
        exp_alerts: []
      - eval_time: 31m
        alertname: GarageAdminMetricsAbsent
        exp_alerts:
          - exp_labels:
              severity: warning
            exp_annotations:
              summary: "Garage admin-metrics families are absent — the disk/table belts are blind"
              description: "The garage-admin-metrics belts (GarageDiskFillingUp, GarageTableEmpty) read garage_local_disk_total and table_size, and at least one family is absent from Prometheus — the scrape is not working (ServiceMonitor selector, metrics token, or a metric-name drift), so those belts cannot fire regardless of Garage's state. Fix the scrape; do not silence this without confirming both families exist."

  # ── 9/9 — COVERAGE GUARD stays silent when both families are served ────────────────────────
  - interval: 1m
    name: "GarageAdminMetricsAbsent silent when both families exist"
    input_series:
      - series: 'garage_local_disk_avail{pod="garage-0",volume="data"}'
        values: "80+0x60"
      - series: 'garage_local_disk_total{pod="garage-0",volume="data"}'
        values: "100+0x60"
      - series: 'table_size{pod="garage-0",table_name="block"}'
        values: "1048576+0x60"
    alert_rule_test:
      - eval_time: 40m
        alertname: GarageAdminMetricsAbsent
        exp_alerts: []
