    {
      "id": 6,
      "type": "graph",
      "title": "Meta Volume Used Ratio",
      "description": "Alert at >80% (GarageDiskFillingUp). Trigger: rotate zone if >80% for 30m (ADR-114)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "garage:meta_volume_used_ratio",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.8}
            ]
          },
          "custom": {
            "hideFrom": {"legend": false}
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "0.8"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {"dash": [5, 5], "fill": "dash"}
              }
            ]
          }
        ]
      },
      "options": {
        "seriesOverrides": [
          {
            "alias": "80% threshold",
            "stroke": "rgba(242,102,102,0.7)",
            "dashLength": 5,
            "spaceLength": 5
          }
        ]
      }
    },
