# Behaviour fixture for GarageTableEmpty's 7d rolling window — cases 7/9 and 8/9 of
# garage-admin-metrics.promtool-test.
#
#   devbox run -- promtool test rules argocd/resources/garage-alerts/garage-admin-metrics-table-empty.promtool-test
#
# CLOCK: promtool's test clock starts at 0. Range selectors are LEFT-OPEN in Prometheus 3.x, so
# `[10m]` at t sees (t-10m, t] — a last real sample at T stays in range through T+9m at a 1m
# interval and is gone at T+10m.
#
# WHY A SEPARATE PAIR: `promtool test rules` evaluates EVERY rule in its rule_files once per
# evaluation_interval from 0 to each test group's last eval_time. GarageTableEmpty's 7-day window
# puts these cases at 2880m and 10201m — inside garage-admin-metrics.promtool-test that was every
# one of that file's 10 rules at each 1m step. Here the rules file carries GarageTableEmpty ALONE.
# Moved verbatim from garage-admin-metrics.promtool-test (CI wall time, 2026-10-09) — same inputs,
# same eval_times, same assertions.
rule_files:
  - garage-admin-metrics-table-empty.promtool-rules

evaluation_interval: 1m

tests:
  # ── 7/9 — 7D WINDOW GUARD: a wipe still unrecovered past 24h keeps firing (the regression guard)
  # A table held data, then dropped to zero (the meta-wipe pattern), and stays empty for over a
  # week. The alert must keep firing at 48h (which the round-1 24h window would have missed) and
  # at 6d, and only stop after the 7d rolling window slides past the drop. This case pins the
  # documented tradeoff — the rolling window is not "was ever populated", and a wipe still
  # unrecovered 7 days after the drop stops alerting.
  - interval: 1m
    name: "GarageTableEmpty keeps firing on a wipe that stays unrecovered for days (the 24h-window regression guard)"
    input_series:
      - series: 'table_size{table_name="object",pod="garage-0"}'
        values: '100+0x120 0+0x2880'
    alert_rule_test:
      # fires at 3h — well within the 7d window
      - eval_time: 180m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
              triage: now
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."
      # fires at 48h — the load-bearing assertion: fails against 24h window, passes against 7d
      - eval_time: 2880m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
              triage: now
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."

  # ── 8/9 — 7D BOUNDARY: the rolling window slides past the drop after 7 days ────────────────
  # A table held data, dropped to zero, and stays empty. After 7 days the max_over_time window
  # no longer includes any sample > 0, so the alert stops firing. This case pins the documented
  # tradeoff — the rolling window is not "was ever populated".
  # ⚠ The alert_rule_test at the 7d boundary uses promql_expr_test rather than alert_rule_test
  # because promtool's range-query memory limit (~9900 samples) prevents a series long enough to
  # be alive at t=10260. The promql_expr_test directly evaluates the max_over_time clause that
  # distinguishes the new expr from the old one, proving the window has slid past the drop.
  - interval: 1m
    name: "GarageTableEmpty stops firing after the 7d rolling window slides past the drop"
    input_series:
      - series: 'table_size{table_name="object",pod="garage-0"}'
        values: '100+0x120 0+0x9850'
    alert_rule_test:
      # fires at 3h — well within the 7d window
      - eval_time: 180m
        alertname: GarageTableEmpty
        exp_alerts:
          - exp_labels:
              severity: warning
              pod: garage-0
              table_name: object
              triage: now
            exp_annotations:
              summary: "Garage table object is empty on garage-0"
              description: "A Garage meta table that should hold data reports zero size. This is the pattern from the 2026-08-24 meta wipe (docs/incidents/2026-08-24-pve-thin-pool-garage-meta-wipe.md): the LMDB came back with empty tables after a hard VM stop. Check Garage's health (`garage status`), the meta volume, and the pod logs. If multiple tables are empty simultaneously the meta store may need recovery from the snapshot belt (metadataAutoSnapshotInterval: 6h, snapshots in /mnt/data/meta_snapshots). This belt only fires within 7 days of the drop — if it resolves without the table refilling, the window has slid past the drop rather than the store having recovered; check `table_size` directly."
    promql_expr_test:
      # The max_over_time clause at 7d+1m: the window (121, 10201] excludes the last >0 sample
      # at t=120, so the expression returns no data — the alert would not fire.
      - expr: max_over_time(table_size[7d]) > 0
        eval_time: 10201m
        exp_samples: []
