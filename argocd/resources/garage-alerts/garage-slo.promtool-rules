# Garage SLO recording rules (FU-093).
# Drift-pinned copy: hand-copy recording rules into argocd/resources/garage-alerts/prometheusrule.yaml
# (the canonical home), then re-render this file from it for promtool testing.
#
# Objectives (measured 2026-09-09 post-rotation):
# - Error ratio: < 0.1% / 30 days
# - Write p99 latency: < 10 s (measured: 4.6 s)
# - Read p99 latency: < 2 s (measured: 0.4 s)
# - List p99 latency: < 5 s (measured: 1.5 s)
# - Availability: ≥99.95% (2026-09-09 read: 99.95% request-level, 99.87% scrape-level since 2026-08-28;
#   ⚠ 2026-09-10, 30-day window per pod: garage-1 99.90 %, garage-0 98.0 %, garage-2 98.1 % — breached)
groups:
  - name: garage-slo
    rules:
      - record: garage:s3_requests:rate5m
        expr: |
          sum by (api_endpoint) (rate(api_s3_request_duration_count[5m]))

      # The two-sided form (#1569) — the expr below is byte-identical to the CR's
      # `garage:s3_server_error_ratio:rate5m` (prometheusrule.yaml). The drift pin does not cover
      # recording rules yet (#1563), so that equality is checked BY HAND in the PR, not by the lint.
      # Why it is two-sided: the old bare `/` needed a 5xx counter series to exist for the endpoint,
      # and Garage only exports one after a 5xx — so a healthy store had no ratio at all. See the
      # CR's comment for the measured evidence and the per-endpoint zero-floor's reasoning.
      - record: garage:s3_server_error_ratio:rate5m
        expr: |
          (
            sum by (api_endpoint) (rate(api_s3_error_counter{status_code=~"500|503"}[5m]))
            or
            sum by (api_endpoint) (rate(api_s3_request_duration_count[5m]) * 0)
          )
          / on (api_endpoint) group_left
          clamp_min(
            sum by (api_endpoint) (rate(api_s3_request_duration_count[5m]))
            or
            sum by (api_endpoint) (rate(api_s3_error_counter{status_code=~"500|503"}[5m])),
            1e-9
          )

      - record: garage:s3_latency_seconds:p99_5m
        expr: |
          histogram_quantile(0.99,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"GetObject|HeadObject"}[5m]),
                "endpoint_class",
                "read",
                "__name__",
                ".*"
              )
            )
          )
          or
          histogram_quantile(0.99,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"PutObject|UploadPart|CompleteMultipartUpload|DeleteObject"}[5m]),
                "endpoint_class",
                "write",
                "__name__",
                ".*"
              )
            )
          )
          or
          histogram_quantile(0.99,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"ListObjectsV2|ListParts"}[5m]),
                "endpoint_class",
                "list",
                "__name__",
                ".*"
              )
            )
          )

      - record: garage:s3_latency_seconds:p50_5m
        expr: |
          histogram_quantile(0.50,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"GetObject|HeadObject"}[5m]),
                "endpoint_class",
                "read",
                "__name__",
                ".*"
              )
            )
          )
          or
          histogram_quantile(0.50,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"PutObject|UploadPart|CompleteMultipartUpload|DeleteObject"}[5m]),
                "endpoint_class",
                "write",
                "__name__",
                ".*"
              )
            )
          )
          or
          histogram_quantile(0.50,
            sum by (endpoint_class, api_endpoint, le) (
              label_replace(
                rate(api_s3_request_duration_bucket{api_endpoint=~"ListObjectsV2|ListParts"}[5m]),
                "endpoint_class",
                "list",
                "__name__",
                ".*"
              )
            )
          )

      - record: garage:cluster_health:availability_ratio_1h
        expr: |
          avg_over_time(
            (probe_http_status_code{job="blackbox-garage-health"} == bool 200)[1h:1m]
          )

      - record: garage:meta_volume_used_ratio
        expr: |
          1 - garage_local_disk_avail{volume="metadata"} / garage_local_disk_total{volume="metadata"}

      - record: garage:data_volume_used_ratio
        expr: |
          1 - garage_local_disk_avail{volume="data"} / garage_local_disk_total{volume="data"}

      # ── 30-DAY SLO WINDOWS (2026-09-10) — the objectives above are stated over 30 days, but
      # every rule so far is a 5m rate or a 1h window, so the doc's "measured" figures were
      # short-window reads. These are the series the objectives are actually judged on. (The
      # availability one averages the recorded 1h series rather than re-running a 30d subquery.)
      - record: garage:cluster_health:availability_ratio_30d
        expr: |
          avg_over_time(garage:cluster_health:availability_ratio_1h[30d])

      - record: garage:s3_server_error_ratio:30d
        expr: |
          sum(increase(api_s3_error_counter{status_code=~"500|503"}[30d]))
          / sum(increase(api_s3_request_duration_count[30d]))
