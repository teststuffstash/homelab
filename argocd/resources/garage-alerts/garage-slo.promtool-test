# Behaviour fixtures for garage-slo recording rules (FU-093).
# Tests that:
# 1. Request rate calculation works
# 2. Availability ratio calculation works
# 3. Volume utilization ratio calculation works
#
#   devbox run -- promtool test rules argocd/resources/garage-alerts/garage-slo.promtool-test
#
rule_files:
  - garage-slo.promtool-rules

evaluation_interval: 1m

tests:
  # ── Request rate by endpoint ───────────────────────────────────────────────────────────────────
  - interval: 1m
    name: request rate calculation
    input_series:
      # Cumulative request counts over 5m (simulating increasing counts)
      - series: 'api_s3_request_duration_count{api_endpoint="GetObject"}'
        values: "1000+100x5"
      - series: 'api_s3_request_duration_count{api_endpoint="PutObject"}'
        values: "500+50x5"
    promql_expr_test:
      - expr: garage:s3_requests:rate5m
        eval_time: 5m
        exp_samples:
          # GetObject: 100 requests/min over 5m interval ≈ 1.6667 req/s
          - labels: '{__name__="garage:s3_requests:rate5m",api_endpoint="GetObject"}'
            value: 1.6666666666666667
          # PutObject: 50 requests/min ≈ 0.8333 req/s
          - labels: '{__name__="garage:s3_requests:rate5m",api_endpoint="PutObject"}'
            value: 0.8333333333333334

  # ── Cluster health availability ratio over 1h ───────────────────────────────────────────────
  - interval: 1m
    name: cluster health availability calculation
    input_series:
      # Simulating successful probes for garage-0: all 60 minutes successful
      - series: 'probe_success{job="blackbox-garage-health",instance="garage-0"}'
        values: "1+0x60"
      # Simulating probes for garage-1: 45 successes, 15 failures over 60m
      - series: 'probe_success{job="blackbox-garage-health",instance="garage-1"}'
        values: "1+0x45 0+0x15"
    promql_expr_test:
      - expr: garage:cluster_health:availability_ratio_1h
        eval_time: 60m
        exp_samples:
          # garage-0: 60/60 = 1.0 (100%)
          - labels: '{__name__="garage:cluster_health:availability_ratio_1h",instance="garage-0",job="blackbox-garage-health"}'
            value: 1.0
          # garage-1: 45/60 = 0.75 (75%)
          - labels: '{__name__="garage:cluster_health:availability_ratio_1h",instance="garage-1",job="blackbox-garage-health"}'
            value: 0.75

  # ── Volume utilization ratios ────────────────────────────────────────────────────────────────
  - interval: 1m
    name: volume utilization calculation
    input_series:
      # Meta volume: 400GB total, 350GB available (350/400 = 0.875 = 87.5% used)
      - series: 'garage_local_disk_total{pod="garage-0",volume="metadata"}'
        values: "400+0x10"
      - series: 'garage_local_disk_avail{pod="garage-0",volume="metadata"}'
        values: "50+0x10"
      # Data volume: 1000GB total, 200GB available (800/1000 = 0.8 = 80% used)
      - series: 'garage_local_disk_total{pod="garage-0",volume="data"}'
        values: "1000+0x10"
      - series: 'garage_local_disk_avail{pod="garage-0",volume="data"}'
        values: "200+0x10"
    promql_expr_test:
      - expr: garage:meta_volume_used_ratio
        eval_time: 5m
        exp_samples:
          # Meta: 1 - 50/400 = 0.875 (87.5% used)
          - labels: '{__name__="garage:meta_volume_used_ratio",pod="garage-0",volume="metadata"}'
            value: 0.875
      - expr: garage:data_volume_used_ratio
        eval_time: 5m
        exp_samples:
          # Data: 1 - 200/1000 = 0.8 (80% used)
          - labels: '{__name__="garage:data_volume_used_ratio",pod="garage-0",volume="data"}'
            value: 0.8

  # ── Server error ratio ─────────────────────────────────────────────────────────────────────────
  - interval: 1m
    name: server error ratio calculation
    input_series:
      # GetObject: 1000 requests, 5 errors (0.5% error ratio)
      - series: 'api_s3_request_duration_count{api_endpoint="GetObject"}'
        values: "1000+100x5"
      - series: 'api_s3_error_counter{api_endpoint="GetObject",status_code="500"}'
        values: "5+0.5x5"
      # PutObject: 500 requests, 0 errors (0% error ratio)
      - series: 'api_s3_request_duration_count{api_endpoint="PutObject"}'
        values: "500+50x5"
      - series: 'api_s3_error_counter{api_endpoint="PutObject",status_code="500"}'
        values: "0+0x5"
      # ListObjectsV2: 200 requests, 1 error (0.5% error ratio)
      - series: 'api_s3_request_duration_count{api_endpoint="ListObjectsV2"}'
        values: "200+20x5"
      - series: 'api_s3_error_counter{api_endpoint="ListObjectsV2",status_code="503"}'
        values: "1+0x5"
    promql_expr_test:
      - expr: garage:s3_server_error_ratio:rate5m
        eval_time: 5m
        exp_samples:
          # GetObject: 0.5 errors/min / 100 requests/min ≈ 0.005 (0.5%)
          - labels: '{__name__="garage:s3_server_error_ratio:rate5m",api_endpoint="GetObject"}'
            value: 0.005
          # PutObject: 0 errors / 50 requests/min = 0
          - labels: '{__name__="garage:s3_server_error_ratio:rate5m",api_endpoint="PutObject"}'
            value: 0.0
          # ListObjectsV2: 0 errors/min / 20 requests/min = 0 (at eval_time 5m, counter increments start at t=0, so sum is 1 over 5m)
          - labels: '{__name__="garage:s3_server_error_ratio:rate5m",api_endpoint="ListObjectsV2"}'
            value: 0.0

  # ── S3 latency by endpoint class ───────────────────────────────────────────────────────────────
  # Note: These fixtures validate that quantiles are computed correctly per endpoint and filtered
  # by class. The endpoint_class label is added by label_replace but not validated in promtool
  # tests due to framework limitations. In production, the rules will produce endpoint_class
  # labels for dashboard consumption.
  - interval: 1m
    name: latency percentiles by endpoint class
    input_series:
      # GetObject (read class): histogram with p99 around 1.0s, p50 around 0.1s
      - series: 'api_s3_request_duration_bucket{api_endpoint="GetObject",le="0.01"}'
        values: "100+10x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="GetObject",le="0.1"}'
        values: "300+30x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="GetObject",le="0.5"}'
        values: "490+49x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="GetObject",le="1.0"}'
        values: "495+49.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="GetObject",le="+Inf"}'
        values: "500+50x5"
      # HeadObject (read class): similar histogram
      - series: 'api_s3_request_duration_bucket{api_endpoint="HeadObject",le="0.01"}'
        values: "80+8x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="HeadObject",le="0.1"}'
        values: "240+24x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="HeadObject",le="0.5"}'
        values: "390+39x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="HeadObject",le="1.0"}'
        values: "395+39.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="HeadObject",le="+Inf"}'
        values: "400+40x5"
      # PutObject (write class): higher latency
      - series: 'api_s3_request_duration_bucket{api_endpoint="PutObject",le="0.1"}'
        values: "30+3x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="PutObject",le="1.0"}'
        values: "300+30x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="PutObject",le="5.0"}'
        values: "475+47.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="PutObject",le="10.0"}'
        values: "495+49.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="PutObject",le="+Inf"}'
        values: "500+50x5"
      # ListObjectsV2 (list class): moderate latency
      - series: 'api_s3_request_duration_bucket{api_endpoint="ListObjectsV2",le="0.1"}'
        values: "50+5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="ListObjectsV2",le="0.5"}'
        values: "300+30x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="ListObjectsV2",le="2.0"}'
        values: "475+47.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="ListObjectsV2",le="5.0"}'
        values: "495+49.5x5"
      - series: 'api_s3_request_duration_bucket{api_endpoint="ListObjectsV2",le="+Inf"}'
        values: "500+50x5"
    promql_expr_test:
      - expr: garage:s3_latency_seconds:p99_5m
        eval_time: 5m
        exp_samples:
          # p99 values by endpoint and class
          - labels: '{__name__="garage:s3_latency_seconds:p99_5m",api_endpoint="GetObject",endpoint_class="read"}'
            value: 1.0
          - labels: '{__name__="garage:s3_latency_seconds:p99_5m",api_endpoint="HeadObject",endpoint_class="read"}'
            value: 1.0
          - labels: '{__name__="garage:s3_latency_seconds:p99_5m",api_endpoint="PutObject",endpoint_class="write"}'
            value: 10.0
          - labels: '{__name__="garage:s3_latency_seconds:p99_5m",api_endpoint="ListObjectsV2",endpoint_class="list"}'
            value: 5.0
      - expr: garage:s3_latency_seconds:p50_5m
        eval_time: 5m
        exp_samples:
          # p50 values by endpoint and class (computed via interpolation from bucket data)
          - labels: '{__name__="garage:s3_latency_seconds:p50_5m",api_endpoint="GetObject",endpoint_class="read"}'
            value: 0.0775
          - labels: '{__name__="garage:s3_latency_seconds:p50_5m",api_endpoint="HeadObject",endpoint_class="read"}'
            value: 0.07749999999999999
          - labels: '{__name__="garage:s3_latency_seconds:p50_5m",api_endpoint="PutObject",endpoint_class="write"}'
            value: 0.8333333333333334
          - labels: '{__name__="garage:s3_latency_seconds:p50_5m",api_endpoint="ListObjectsV2",endpoint_class="list"}'
            value: 0.42000000000000004
