# Hand copy of the garage-disruption group from prometheusrule.yaml.
# Regenerate after every expr edit with:
#
#   yq -o=json '{"groups": [.spec.groups[] | select(.name == "garage-disruption")]}' argocd/resources/garage-alerts/prometheusrule.yaml | yq -P '.'
#
# ⚠ THE RECIPE ABOVE DOES NOT ROUND-TRIP COMMENTS: re-add this header BY HAND after every
# regenerate. Drift-pinned by scripts/prometheus-rules-lint.sh (expr+for equality per alert name;
# the recording rule is not pinned there, so re-copy it with the alerts).
groups:
  - name: garage-disruption
    rules:
      - record: garage:disruption_allowed
        expr: |
          min_over_time((
            (
                (min(cluster_healthy) == bool 1)
              * (max(block_resync_queue_length) <= bool 1000)
              * (count(block_resync_queue_length) >= bool max(cluster_storage_nodes))
            ) or on() vector(0)
          )[10m:1m])
      - alert: GarageDisruptionBlocked
        expr: |
          kube_poddisruptionbudget_status_pod_disruptions_allowed{namespace="garage",poddisruptionbudget="garage"} == 0
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: Garage has refused voluntary disruption for 2h, so no zone node can be drained
      - alert: GarageDisruptionBudgetOpenAgainstSignal
        expr: |
          (
              kube_poddisruptionbudget_status_expected_pods{namespace="garage",poddisruptionbudget="garage"}
            - kube_poddisruptionbudget_status_desired_healthy{namespace="garage",poddisruptionbudget="garage"}
          ) > 0
          unless on() (garage:disruption_allowed == 1)
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: The garage PodDisruptionBudget lets a zone go while Garage's signal says it must not
