# Hand copy of the garage-bucket-quota group from prometheusrule.yaml — re-copy after every expr
# edit (the same drift rule as garage-admin-metrics.promtool-rules; the yq recipe there applies
# with the group name swapped, and it does not round-trip this header).
groups:
  - name: garage-bucket-quota
    rules:
      - alert: GarageBucketQuotaNear
        expr: |
          garage_bucket_bytes / garage_bucket_quota_bytes > 0.8
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Garage bucket {{ $labels.bucket }} is at {{ $value | humanizePercentage }} of its size quota"
          description: >-
            The bucket's size counter is over 80% of its max_size (ADR-089: every bucket claim
            states one). The next object that does not fit is refused by Garage with
            AccessDenied "Bucket size quota is reached" — at COMMIT for multipart uploads, so a
            consumer can spend a whole upload before learning it. Either the owner prunes
            (its own retention) or the claim's max_size grows — per-zone headroom is
            `garage stats` DataAvail, and every zone holds a full copy at rf=3.
      - alert: GarageBucketGaugesAbsent
        expr: |
          absent(garage_bucket_quota_bytes)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "garage_bucket_* gauges are absent — the bucket-quota belts are blind"
          description: >-
            No garage_bucket_quota_bytes series for an hour. The garage-meta-rotation CronJob
            (ns garage, every 15 min) pushes them from the admin API's GetBucketInfo; read its
            last Job log for "WARN bucket gauges" (admin token, ListBuckets) or "WARN
            pushgateway" (pushgateway unreachable). Until fixed, GarageBucketQuotaNear and
            RegistryBucketCommitHeadroomLow cannot fire.
