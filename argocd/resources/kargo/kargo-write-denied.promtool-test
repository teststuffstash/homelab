rule_files:
  - kargo-write-denied.promtool-rules

evaluation_interval: 1m

tests:
  # ── a Deny-phase refusal fires; allow counts and other policies never do ─────────────────────
  - interval: 1m
    name: "KargoWriteDenied fires on a kargo-* deny, not on allow or a foreign policy"
    input_series:
      - series: 'apiserver_validating_admission_policy_check_total{policy="kargo-write-guard",policy_binding="kargo-write-guard",enforcement_action="deny",error_type="no_error"}'
        values: "0+0x5 1+0x20"
      - series: 'apiserver_validating_admission_policy_check_total{policy="kargo-write-guard",policy_binding="kargo-write-guard",enforcement_action="allow",error_type="no_error"}'
        values: "0+10x25"
      - series: 'apiserver_validating_admission_policy_check_total{policy="pg-guard",policy_binding="pg-guard",enforcement_action="deny",error_type="no_error"}'
        values: "0+1x25"
    alert_rule_test:
      - eval_time: 4m
        alertname: KargoWriteDenied
        exp_alerts: []
      - eval_time: 8m
        alertname: KargoWriteDenied
        exp_alerts:
          - exp_labels:
              severity: warning
              triage: dig
              policy: kargo-write-guard
              enforcement_action: deny
      # the 10m window has slid past the single increment
      - eval_time: 20m
        alertname: KargoWriteDenied
        exp_alerts: []
  # ── the [Warn, Audit] rollout phase: one violation = warn+audit; the alert fires ONCE (warn) ──
  - interval: 1m
    name: "KargoWriteDenied fires during the Warn soak, counting warn not audit"
    input_series:
      - series: 'apiserver_validating_admission_policy_check_total{policy="kargo-write-guard",policy_binding="kargo-write-guard",enforcement_action="warn",error_type="no_error"}'
        values: "0+0x5 1+0x10"
      - series: 'apiserver_validating_admission_policy_check_total{policy="kargo-write-guard",policy_binding="kargo-write-guard",enforcement_action="audit",error_type="no_error"}'
        values: "0+0x5 1+0x10"
    alert_rule_test:
      - eval_time: 8m
        alertname: KargoWriteDenied
        exp_alerts:
          - exp_labels:
              severity: warning
              triage: dig
              policy: kargo-write-guard
              enforcement_action: warn
