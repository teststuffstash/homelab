# Behaviour fixture for pool-belt.promtool-rules (FU-158 shape): `devbox run prometheus-rules-lint`
# runs it. Each test drives one alert through its `for:` window and asserts the OTHER alerts stay
# quiet on the same input — promtool evaluates every rule in the file at every step.
#
# ⚠ Every series carries a `host` label (2026-09-15): there are TWO hypervisors now, the rules are
# written per series, and PveMetricsAbsent has one arm PER HOST. A test that leaves a host out is
# not a quiet test — it is a firing one.
rule_files:
  - pool-belt.promtool-rules
evaluation_interval: 1m

tests:
  # A pool that climbs 60→85→95 and comes back: warning after 10m above 80, critical after 2m
  # above 90, both clear on the way down. Textfile fresh throughout (mtime tracks time).
  # nx-02's pool sits flat and calm beside it — which is also what keeps PveMetricsAbsent quiet.
  - interval: 1m
    input_series:
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x10 85x15 95x5 60x10'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '12x40'
      - series: 'pve_lvm_thin_pool_metadata_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '3x40'
      - series: 'node_textfile_mtime_seconds{job="pve-node",host="pve",file="/var/lib/prometheus/node-exporter/pve.prom"}'
        values: '0+60x40'
      - series: 'pve_qemu_status{job="pve-node",host="pve",vmid="8112",name="wk-02",status="running",qmpstatus="running"}'
        values: '1x40'
    alert_rule_test:
      - eval_time: 10m
        alertname: PveThinPoolFillingUp
        exp_alerts: []
      - eval_time: 20m
        alertname: PveThinPoolFillingUp
        exp_alerts: []          # 85% since t=11m: 9m in, `for: 10m` not yet met
      - eval_time: 22m
        alertname: PveThinPoolFillingUp
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: pve, vg: pve, lv: data , triage: dig}
            exp_annotations:
              summary: "pve thin pool pve/data at 85.0%"
              description: >-
                An LVM thin pool carrying Talos VMs is above 80%. Check the VG's free extents first
                (`pve_lvm_vg_free_bytes{host="pve",vg="pve"}`): pve's are ~0, so autoextend cannot
                act there and the human IS the autoextend. At 100% every VM on the pool pauses on
                io-error together — on pve that includes the control plane. Return blocks now:
                trigger the fstrim CronJobs (`kubectl -n node-maintenance create job
                --from=cronjob/<node> ...`), then read `lvs -o lv_name,data_percent pve` on pve.
                Recipe: docs/runbook.md §"Reclaiming thin-pool space from a Talos VM".
      - eval_time: 22m
        alertname: PveThinPoolAlmostFull
        exp_alerts: []          # 85% is not >90
      - eval_time: 29m
        alertname: PveThinPoolAlmostFull
        exp_alerts:
          - exp_labels: { severity: critical, job: pve-node, host: pve, vg: pve, lv: data , triage: now}
            exp_annotations:
              summary: "pve thin pool pve/data at 95.0% — VMs pause at 100%"
              description: >-
                Under 10% headroom on a pool carrying Talos VMs — on pve that pool carries the
                control plane. One image pull or one Longhorn rebuild finishes it. Act on pve
                directly: fstrim the guests (runbook recipe), or destroy a sacrificial guest (`qm
                destroy 9001` freed 26 points on 2026-09-03). If VMs are already paused: `qm status
                <vmid> --verbose | grep qmpstatus`, free space, then `qm resume <vmid>`.
      - eval_time: 36m
        alertname: PveThinPoolFillingUp
        exp_alerts: []          # back to 60%
      - eval_time: 36m
        alertname: PveThinPoolAlmostFull
        exp_alerts: []
      - eval_time: 36m
        alertname: PveThinPoolMetadataHigh
        exp_alerts: []
      - eval_time: 36m
        alertname: PveVmIoError
        exp_alerts: []
      - eval_time: 36m
        alertname: PveMetricsStale
        exp_alerts: []
      - eval_time: 36m
        alertname: PveMetricsAbsent
        exp_alerts: []

  # THE SECOND HYPERVISOR (2026-09-15). nx-02's own pool fills while pve's stays calm: the alert
  # must name nx-02 and its VG, and exactly one alert must fire. This is the test that would have
  # failed before the rules were made per-host — the old text sent the reader to the wrong box.
  - interval: 1m
    input_series:
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '70x5 92x20'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '55x25'
    alert_rule_test:
      - eval_time: 20m
        alertname: PveThinPoolFillingUp
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: nx-02, vg: nvme-thin, lv: data , triage: dig}
            exp_annotations:
              summary: "nx-02 thin pool nvme-thin/data at 92.0%"
              description: >-
                An LVM thin pool carrying Talos VMs is above 80%. Check the VG's free extents first
                (`pve_lvm_vg_free_bytes{host="nx-02",vg="nvme-thin"}`): pve's are ~0, so autoextend
                cannot act there and the human IS the autoextend. At 100% every VM on the pool
                pauses on io-error together — on pve that includes the control plane. Return blocks
                now: trigger the fstrim CronJobs (`kubectl -n node-maintenance create job
                --from=cronjob/<node> ...`), then read `lvs -o lv_name,data_percent nvme-thin` on
                nx-02. Recipe: docs/runbook.md §"Reclaiming thin-pool space from a Talos VM".
      - eval_time: 20m
        alertname: PveThinPoolAlmostFull
        exp_alerts:
          - exp_labels: { severity: critical, job: pve-node, host: nx-02, vg: nvme-thin, lv: data , triage: now}
            exp_annotations:
              summary: "nx-02 thin pool nvme-thin/data at 92.0% — VMs pause at 100%"
              description: >-
                Under 10% headroom on a pool carrying Talos VMs — on pve that pool carries the
                control plane. One image pull or one Longhorn rebuild finishes it. Act on nx-02
                directly: fstrim the guests (runbook recipe), or destroy a sacrificial guest (`qm
                destroy 9001` freed 26 points on 2026-09-03). If VMs are already paused: `qm status
                <vmid> --verbose | grep qmpstatus`, free space, then `qm resume <vmid>`.
      - eval_time: 20m
        alertname: PveMetricsAbsent
        exp_alerts: []

  # A guest paused on a failed write (the 2026-09-03 signature) fires the io-error rule after 1m.
  - interval: 1m
    input_series:
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '99.9x10'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '12x10'
      - series: 'node_textfile_mtime_seconds{job="pve-node",host="pve",file="/var/lib/prometheus/node-exporter/pve.prom"}'
        values: '0+60x10'
      - series: 'pve_qemu_status{job="pve-node",host="pve",vmid="8112",name="wk-02",status="running",qmpstatus="io-error"}'
        values: '1x10'
    alert_rule_test:
      - eval_time: 3m
        alertname: PveVmIoError
        exp_alerts:
          - exp_labels: { severity: critical, job: pve-node, host: pve, vmid: "8112", name: wk-02, status: running, qmpstatus: io-error , triage: none}
            exp_annotations:
              summary: "pve guest wk-02 (vmid 8112) is paused on io-error"
              description: >-
                The guest hit a failed write and QEMU paused it — the 2026-09-03 signature (thin
                pool at 100%). `qm list` still says running; the Talos API is "no route to host". On
                pve: `lvs -o lv_name,data_percent`, free pool space, then `qm resume 8112`.

  # The collector stopped: mtime freezes at t=0 while the pool number keeps being served. Stale
  # after 600s + 5m; the pool alerts do NOT fire on the frozen 60%.
  - interval: 1m
    input_series:
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x20'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '12x20'
      - series: 'node_textfile_mtime_seconds{job="pve-node",host="pve",file="/var/lib/prometheus/node-exporter/pve.prom"}'
        values: '0x20'
    alert_rule_test:
      - eval_time: 10m
        alertname: PveMetricsStale
        exp_alerts: []
      - eval_time: 16m
        alertname: PveMetricsStale
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: pve, file: /var/lib/prometheus/node-exporter/pve.prom , triage: none}
            exp_annotations:
              summary: "pve textfile metrics not refreshed for 16m 0s"
              description: >-
                node_exporter on pve is up but pve.prom has stopped advancing — the collector timer
                (pve-textfile-metrics.timer) is failing or stopped, so the pool level above is a
                stale number, not a calm pool. On pve: `systemctl status pve-textfile-metrics.timer
                pve-textfile-metrics.service`; `journalctl -u pve-textfile-metrics`. Re-run
                `ansible/pve-node-exporter.yml` to reassert the units.
      - eval_time: 16m
        alertname: PveMetricsAbsent
        exp_alerts: []

  # ONE hypervisor's meter goes away while the other keeps reporting — the case an unqualified
  # absent() cannot see, and the reason the rule has one arm per host.
  - interval: 1m
    input_series:
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x20'
    alert_rule_test:
      - eval_time: 10m
        alertname: PveMetricsAbsent
        exp_alerts: []
      - eval_time: 16m
        alertname: PveMetricsAbsent
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: nx-02 , triage: dig}
            exp_annotations:
              summary: "nx-02 thin-pool meter absent — that pool is unmetered again"
              description: >-
                No pve_lvm_thin_pool_data_percent series from nx-02 for 15m: node_exporter there is
                down, the ScrapeConfig lost its target, or the textfile is missing. Every pool alert
                for that box is blind while this fires, and the runner-image-prepull gate holds
                pool-VM pulls (fail closed, on the max across BOTH pools). Check `curl
                <host>:9100/metrics | grep pve_lvm` from the LAN (pve 192.168.2.3, nx-02
                192.168.2.59), then the ScrapeConfig (`kubectl -n monitoring get scrapeconfig
                pve-node`) and Prometheus targets.

  # No series at all (Prometheus lost the whole job): BOTH arms fire, one alert per hypervisor.
  - interval: 1m
    input_series: []
    alert_rule_test:
      - eval_time: 10m
        alertname: PveMetricsAbsent
        exp_alerts: []
      - eval_time: 16m
        alertname: PveMetricsAbsent
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: pve, triage: dig }   # absent() keeps the equality matchers' labels
            exp_annotations:
              summary: "pve thin-pool meter absent — that pool is unmetered again"
              description: >-
                No pve_lvm_thin_pool_data_percent series from pve for 15m: node_exporter there is
                down, the ScrapeConfig lost its target, or the textfile is missing. Every pool alert
                for that box is blind while this fires, and the runner-image-prepull gate holds
                pool-VM pulls (fail closed, on the max across BOTH pools). Check `curl
                <host>:9100/metrics | grep pve_lvm` from the LAN (pve 192.168.2.3, nx-02
                192.168.2.59), then the ScrapeConfig (`kubectl -n monitoring get scrapeconfig
                pve-node`) and Prometheus targets.
          - exp_labels: { severity: warning, job: pve-node, host: nx-02 , triage: dig}
            exp_annotations:
              summary: "nx-02 thin-pool meter absent — that pool is unmetered again"
              description: >-
                No pve_lvm_thin_pool_data_percent series from nx-02 for 15m: node_exporter there is
                down, the ScrapeConfig lost its target, or the textfile is missing. Every pool alert
                for that box is blind while this fires, and the runner-image-prepull gate holds
                pool-VM pulls (fail closed, on the max across BOTH pools). Check `curl
                <host>:9100/metrics | grep pve_lvm` from the LAN (pve 192.168.2.3, nx-02
                192.168.2.59), then the ScrapeConfig (`kubectl -n monitoring get scrapeconfig
                pve-node`) and Prometheus targets.

  # Host memory: 12GiB available, then a KSM collapse to 2GiB. Warning only after 15m under
  # 3GiB; clears when it comes back. The pool alerts stay quiet on a calm 60% throughout.
  - interval: 1m
    input_series:
      - series: 'node_memory_MemAvailable_bytes{job="pve-node",host="pve",instance="192.168.2.3:9100"}'
        values: '12884901888x10 2147483648x20 12884901888x10'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x40'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '12x40'
      - series: 'pve_lvm_thin_pool_metadata_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '3x40'
      - series: 'node_textfile_mtime_seconds{job="pve-node",host="pve",file="/var/lib/prometheus/node-exporter/pve.prom"}'
        values: '0+60x40'
    alert_rule_test:
      - eval_time: 20m
        alertname: PveHostMemoryLow
        exp_alerts: []          # under 3GiB since t=11m: 9m in, `for: 15m` not yet met
      - eval_time: 27m
        alertname: PveHostMemoryLow
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: pve, instance: "192.168.2.3:9100" , triage: none}
            exp_annotations:
              summary: "pve memory available 2GiB — below 3GiB"
              description: >-
                A hypervisor is close to committing more VM RAM than it has. pve is the known case
                (65GB of allocations on 62.7GiB since 2026-09-08, FU-225, living on KSM ~11GB
                shared); Talos guests have no virtio_balloon, so when KSM sharing collapses or a
                guest grows, the host swaps and then OOM-kills a VM. On pve: `free -m`, `cat
                /sys/kernel/mm/ksm/pages_sharing`, the per-VM RSS (`ps -o rss= -p $(cat
                /var/run/qemu-server/<vmid>.pid)`); relief is a smaller allocation in
                `tofu/variables.tf` (reboots that VM), or the VM moves to the other hypervisor —
                never a RAM buy for pve (operator direction: the second hypervisor was the answer).
      - eval_time: 27m
        alertname: PveThinPoolFillingUp
        exp_alerts: []
      - eval_time: 36m
        alertname: PveHostMemoryLow
        exp_alerts: []

  # ── FU-289 placement belts. Same shape as the 2026-09-24 nx-02 event: 9 GiB MemAvailable
  # throughout (PveHostMemoryLow must stay quiet), swap crosses 1 GiB at t=10 and stays (SwapUsed
  # after 30m), then a swap-in burst at ~100 pages/s with 20% I/O pressure from t=45 for 10 min
  # (Thrash after 5m, gone once the burst ends). pve sits idle beside it.
  - interval: 1m
    input_series:
      - series: 'node_memory_SwapTotal_bytes{job="pve-node",host="nx-02",instance="192.168.2.59:9100"}'
        values: '8589934592x70'
      - series: 'node_memory_SwapFree_bytes{job="pve-node",host="nx-02",instance="192.168.2.59:9100"}'
        values: '8589934592x10 4294967296x60'
      - series: 'node_memory_MemAvailable_bytes{job="pve-node",host="nx-02",instance="192.168.2.59:9100"}'
        values: '10050000000x70'
      - series: 'node_vmstat_pswpin{job="pve-node",host="nx-02",instance="192.168.2.59:9100"}'
        values: '0x45 0+6000x10 60000x15'
      - series: 'node_pressure_io_waiting_seconds_total{job="pve-node",host="nx-02",instance="192.168.2.59:9100"}'
        values: '0x45 0+12x10 120x15'
      - series: 'node_memory_SwapTotal_bytes{job="pve-node",host="pve",instance="192.168.2.3:9100"}'
        values: '8589934592x70'
      - series: 'node_memory_SwapFree_bytes{job="pve-node",host="pve",instance="192.168.2.3:9100"}'
        values: '8589934592x70'
      - series: 'node_vmstat_pswpin{job="pve-node",host="pve",instance="192.168.2.3:9100"}'
        values: '0x70'
      - series: 'node_pressure_io_waiting_seconds_total{job="pve-node",host="pve",instance="192.168.2.3:9100"}'
        values: '0x70'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x70'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '43x70'
    alert_rule_test:
      - eval_time: 30m
        alertname: PveHostSwapUsed
        exp_alerts: []          # 4 GiB in swap since t=11: 19m in, `for: 30m` not yet met
      - eval_time: 42m
        alertname: PveHostSwapUsed
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: nx-02, instance: "192.168.2.59:9100" , triage: none}
            exp_annotations:
              summary: "nx-02 has 4GiB in swap"
              description: >-
                A hypervisor is paging guest memory out. This is the PRECURSOR with hours of lead:
                nx-02 crossed 1 GiB at 2026-09-24 ~23:00Z and the CI stalls came at 07:24 next morning
                when those pages were needed back (FU-289). PveHostMemoryLow stays quiet for it — the
                box had 9 GiB available globally while kswapd emptied one NUMA node. On nx-02: which
                guest (`pve_qemu_swap_bytes{host="nx-02"}`), which node is starved
                (`node_memory_numa_MemFree{host="nx-02"}`), what is pinned there
                (`pve_qemu_numa_resident_bytes`, `pve_qemu_locked_bytes`). Relief is placement —
                hugepages + `numaN: hostnodes=` on the pinned guest, a restart — or a smaller
                allocation; while the swap lives on a spinning disk this becomes PveHostSwapThrash.
      - eval_time: 42m
        alertname: PveHostMemoryLow
        exp_alerts: []          # the old belt: 9.4 GiB available, blind to this — by design of the event
      - eval_time: 49m
        alertname: PveHostSwapThrash
        exp_alerts: []          # burst began at t=46; the 5m rate still averages in the zeros before it, so the
                                # expr first clears 256 KiB/s at t=49 and `for: 5m` is met at t=54
      - eval_time: 56m
        alertname: PveHostSwapThrash
        exp_alerts:
          - exp_labels: { severity: critical, job: pve-node, host: nx-02, instance: "192.168.2.59:9100" , triage: now}
            exp_annotations:
              summary: "nx-02 swapping in at 400kiB/s with I/O pressure"
              description: >-
                Guest memory is coming back from swap at disk speed and the host is I/O-bound on it —
                every guest on nx-02 crawls (a CI runner in this state took 397 s for a 2 s step,
                FU-289; the 09-25 runs showed ~1 MiB/s swap-in at 20% I/O pressure, i.e. a 5400 rpm
                disk at 98%). It ends when the pages are back, not when memory frees. Now: stop
                adding load on nx-02 (park the runner: `var.ci_runner_0N_running=false`); then the
                cause via PveHostSwapUsed. Structural: swap on the SSD/NVMe, never the spinner.
      - eval_time: 65m
        alertname: PveHostSwapThrash
        exp_alerts: []          # burst over at t=55; the 5m rate window has drained
      - eval_time: 65m
        alertname: PveThinPoolFillingUp
        exp_alerts: []

  # One NUMA node starves while the other is wide open (the 08:21Z reading: node 0 ~12 GiB free,
  # node 1 ~1 GiB with ~0.1 GiB of reclaimable file) → PveNumaNodeMemoryLow after 15m, on node 1
  # only. In the same run ci-runner-02 sits 3.7 GiB in swap from t=10 → PveGuestSwapped after 15m;
  # wk-04 (pinned, 18 MiB swapped) stays quiet.
  - interval: 1m
    input_series:
      - series: 'node_memory_numa_MemFree{job="pve-node",host="nx-02",instance="192.168.2.59:9100",node="0"}'
        values: '12884901888x40'
      - series: 'node_memory_numa_Inactive_file{job="pve-node",host="nx-02",instance="192.168.2.59:9100",node="0"}'
        values: '400000000x40'
      - series: 'node_memory_numa_MemFree{job="pve-node",host="nx-02",instance="192.168.2.59:9100",node="1"}'
        values: '4294967296x10 1073741824x30'
      - series: 'node_memory_numa_Inactive_file{job="pve-node",host="nx-02",instance="192.168.2.59:9100",node="1"}'
        values: '100000000x40'
      - series: 'pve_qemu_swap_bytes{job="pve-node",host="nx-02",vmid="9002",name="ci-runner-02"}'
        values: '0x10 3972844748x30'
      - series: 'pve_qemu_swap_bytes{job="pve-node",host="nx-02",vmid="8114",name="wk-04"}'
        values: '18313216x40'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="pve",vg="pve",lv="data"}'
        values: '60x40'
      - series: 'pve_lvm_thin_pool_data_percent{job="pve-node",host="nx-02",vg="nvme-thin",lv="data"}'
        values: '43x40'
    alert_rule_test:
      - eval_time: 24m
        alertname: PveNumaNodeMemoryLow
        exp_alerts: []          # node 1 under 1.5 GiB since t=11: 13m in, `for: 15m` not yet met
      - eval_time: 27m
        alertname: PveNumaNodeMemoryLow
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: nx-02, instance: "192.168.2.59:9100", node: "1" , triage: none}
            exp_annotations:
              summary: "nx-02 NUMA node 1 down to 1.093GiB free + reclaimable file"
              description: >-
                One physical memory node of a dual-socket hypervisor is nearly exhausted while the
                other may be wide open. MemAvailable hides it, and kswapd works PER NODE: it evicts
                whatever is evictable on that node — the unpinned guests, to swap — to hold its
                watermarks, regardless of free RAM on the other node (FU-289: wk-04 pinned 6/26 GiB
                across the nodes of nx-02, node 1 at ~1 GiB, ci-runner-02 went to the HDD). On nx-02:
                `pve_qemu_numa_resident_bytes{host="nx-02",node="1"}` names the guests on that node,
                `pve_qemu_locked_bytes` which is pinned (VFIO). A pinned guest is rebalanced only by a
                restart with explicit `numaN: hostnodes=` (+ hugepages) —
                docs/spikes/nx-02-numa-placement.md.
      - eval_time: 27m
        alertname: PveGuestSwapped
        exp_alerts:
          - exp_labels: { severity: warning, job: pve-node, host: nx-02, vmid: "9002", name: ci-runner-02 , triage: none}
            exp_annotations:
              summary: "nx-02 guest ci-runner-02 (vmid 9002) has 3.7GiB on host swap"
              description: >-
                The host has paged part of this guest out. The guest cannot know — it sees its RAM as
                present — so every touch of a swapped page is a disk read it did not ask for; a Talos
                node or a CI runner in this state stalls for minutes, and a control-plane guest here
                is an etcd member on a spinning disk. Find the pressure with PveHostSwapUsed /
                PveNumaNodeMemoryLow on nx-02; the guest recovers when its pages are back (`vmstat 1`
                on the host, column si), not when this clears.
