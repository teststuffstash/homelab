        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Go dispatch limited",
      "description": "The /opencode-limit composite verdict the failover ladder consults (0 = routing, 1 = latched). Metered = cluster+jail; operator console = spot-check only. No data = no Go spend.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
