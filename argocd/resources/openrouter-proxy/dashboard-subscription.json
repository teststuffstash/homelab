    {
      "id": 15,
      "type": "timeseries",
      "title": "Anthropic utilization by window (dispatch defers at threshold)",
      "description": "anthropic_subscription_utilization per window vs the per-window deferral threshold the proxy enforces (anthropic_subscription_utilization_threshold; 5h=finish-in-progress guard, 7d=operator weekly headroom). Gaps = no subscription traffic through the proxy (data only refreshes when sessions run).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (window) (anthropic_subscription_utilization)",
          "legendFormat": "{{window}}"
        },
        {
          "refId": "B",
          "datasource": {
