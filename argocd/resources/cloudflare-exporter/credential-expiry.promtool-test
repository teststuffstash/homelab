# Behaviour fixture for the credential-expiry belt (FU-156) — prometheusrule.yaml §credential-expiry.
#
#   devbox run -- promtool test rules argocd/resources/cloudflare-exporter/credential-expiry.promtool-test
#
# CI runs it via `devbox run prometheus-rules-lint` (every *.promtool-test under argocd/).
# CLOCK: promtool's clock starts at 0, so time() == the eval offset and an expiry timestamp of
# N*86400 means "N days from the start of the test". Range selectors are left-open (Prometheus 3.x).
# Pinned here: warning in the 7–30d band, critical under 7d (incl. ALREADY expired), silence over
# 30d, the band hand-over (warning resolves as critical fires — no double page), the Tier-0
# annotation branch, a never-expiring token (no series) firing nothing, a probe roll not
# re-clocking the warning's `for:`, and the blind alert on probe_ok 0 AND on a vanished probe.
rule_files:
  - credential-expiry.promtool-rules

evaluation_interval: 1m

tests:
  # ── 1 — the bands ────────────────────────────────────────────────────────────────────────────
  - interval: 1m
    name: "warning <30d, critical <7d, silence >30d, band hand-over, no series for never-expiring"
    input_series:
      # 40 days out — must never fire (">30d no fire")
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="far-away",job="cloudflare-credential-expiry-probe",pod="p-a"}'
        values: "3456000+0x60"
      # 20 days out — the warning band. Rolls at 8m (stale, 2m hole, new pod): the bridge must
      # keep the `for: 10m` running, so it fires at 15m, not 22m.
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="homelab-acme-dns",job="cloudflare-credential-expiry-probe",pod="p-a"}'
        values: "1728000+0x7 stale"
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="homelab-acme-dns",job="cloudflare-credential-expiry-probe",pod="p-b"}'
        values: "_x10 1728000+0x50"
      # 5 days out — the Tier-0 mint root: critical, with the dashboard-renewal annotation branch
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="Create Additional Tokens",job="cloudflare-credential-expiry-probe",pod="p-a"}'
        values: "432000+0x60"
      # 7d + 30m out — warning first, crosses into critical at 30m; the warning must resolve
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="crossing",job="cloudflare-credential-expiry-probe",pod="p-a"}'
        values: "606600+0x60"
      # (homelab-token-inventory-read never expires: the probe emits NO series for it — nothing
      #  below may mention it, and the count assertion pins that it is not there)
      - series: 'credential_expiry_probe_ok{provider="cloudflare",job="cloudflare-credential-expiry-probe",pod="p-a"}'
        values: "1+0x60"
    promql_expr_test:
      - expr: count(credential_expiry_timestamp_seconds)
        eval_time: 30m
        exp_samples:
          - labels: '{}'
            value: 4
    alert_rule_test:
      - eval_time: 15m
        alertname: CredentialExpiringSoon
        exp_alerts:
          - exp_labels: { provider: cloudflare, credential: homelab-acme-dns, severity: warning, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Credential \"homelab-acme-dns\" (cloudflare) expires in 19d 23h 45m 0s. Renew or RETIRE (a superseded credential is deleted, not renewed — docs/secrets.md §Credential expiry). Cloudflare: bump expires_on in tofu/cloudflare-token/, then on the host `devbox run cloudflare-token-tofu plan` + `apply` (tofu/cloudflare-token/README.md); the wrapper re-stores wallet + cache + Infisical (scripts/cloudflare-token-store.sh) — then refresh any non-ESO consumer the docs/cloudflare.md token matrix names."
              summary: "cloudflare credential \"homelab-acme-dns\" expires in 19d 23h 45m 0s"
          - exp_labels: { provider: cloudflare, credential: crossing, severity: warning, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Credential \"crossing\" (cloudflare) expires in 7d 0h 15m 0s. Renew or RETIRE (a superseded credential is deleted, not renewed — docs/secrets.md §Credential expiry). Cloudflare: bump expires_on in tofu/cloudflare-token/, then on the host `devbox run cloudflare-token-tofu plan` + `apply` (tofu/cloudflare-token/README.md); the wrapper re-stores wallet + cache + Infisical (scripts/cloudflare-token-store.sh) — then refresh any non-ESO consumer the docs/cloudflare.md token matrix names."
              summary: "cloudflare credential \"crossing\" expires in 7d 0h 15m 0s"
      - eval_time: 15m
        alertname: CredentialExpiryImminent
        exp_alerts:
          - exp_labels: { provider: cloudflare, credential: Create Additional Tokens, severity: critical, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Under 7 days (negative = ALREADY EXPIRED). Tier-0 Cloudflare mint-root: DASHBOARD-renewed — tofu/cloudflare-token/README.md §The admin token, re-store in the host admin wallet. Without it no other Cloudflare token can be re-minted."
              summary: "cloudflare credential \"Create Additional Tokens\" expires in 4d 23h 45m 0s — renew NOW"
      # the hand-over: at 45m "crossing" is under 7d — critical, and the warning has resolved
      - eval_time: 45m
        alertname: CredentialExpiringSoon
        exp_alerts:
          - exp_labels: { provider: cloudflare, credential: homelab-acme-dns, severity: warning, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Credential \"homelab-acme-dns\" (cloudflare) expires in 19d 23h 15m 0s. Renew or RETIRE (a superseded credential is deleted, not renewed — docs/secrets.md §Credential expiry). Cloudflare: bump expires_on in tofu/cloudflare-token/, then on the host `devbox run cloudflare-token-tofu plan` + `apply` (tofu/cloudflare-token/README.md); the wrapper re-stores wallet + cache + Infisical (scripts/cloudflare-token-store.sh) — then refresh any non-ESO consumer the docs/cloudflare.md token matrix names."
              summary: "cloudflare credential \"homelab-acme-dns\" expires in 19d 23h 15m 0s"
      - eval_time: 45m
        alertname: CredentialExpiryImminent
        exp_alerts:
          - exp_labels: { provider: cloudflare, credential: Create Additional Tokens, severity: critical, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Under 7 days (negative = ALREADY EXPIRED). Tier-0 Cloudflare mint-root: DASHBOARD-renewed — tofu/cloudflare-token/README.md §The admin token, re-store in the host admin wallet. Without it no other Cloudflare token can be re-minted."
              summary: "cloudflare credential \"Create Additional Tokens\" expires in 4d 23h 15m 0s — renew NOW"
          - exp_labels: { provider: cloudflare, credential: crossing, severity: critical, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Under 7 days (negative = ALREADY EXPIRED). Renew via the mint root's apply on the host (Cloudflare: bump expires_on, `devbox run cloudflare-token-tofu apply` — tofu/cloudflare-token/README.md; the wrapper re-stores) or retire it; consumers in the docs/cloudflare.md token matrix."
              summary: "cloudflare credential \"crossing\" expires in 6d 23h 45m 0s — renew NOW"
      - eval_time: 45m
        alertname: CredentialExpiryProbeBlind
        exp_alerts: []

  # ── 2 — already expired is the loudest case ─────────────────────────────────────────────────
  - interval: 1m
    name: "an already-expired credential (timestamp in the past) is critical, not silent"
    input_series:
      - series: 'credential_expiry_timestamp_seconds{provider="cloudflare",credential="lapsed",pod="p-a"}'
        values: "0+0x30"
      - series: 'credential_expiry_probe_ok{provider="cloudflare",pod="p-a"}'
        values: "1+0x30"
    alert_rule_test:
      - eval_time: 20m
        alertname: CredentialExpiryImminent
        exp_alerts:
          - exp_labels: { provider: cloudflare, credential: lapsed, severity: critical, platform_machinery: "true", triage: none }
            exp_annotations:
              description: "Under 7 days (negative = ALREADY EXPIRED). Renew via the mint root's apply on the host (Cloudflare: bump expires_on, `devbox run cloudflare-token-tofu apply` — tofu/cloudflare-token/README.md; the wrapper re-stores) or retire it; consumers in the docs/cloudflare.md token matrix."
              summary: "cloudflare credential \"lapsed\" expires in -20m 0s — renew NOW"
      - eval_time: 20m
        alertname: CredentialExpiringSoon
        exp_alerts: []

  # ── 3 — blind: probe_ok 0 (failed/stale poll) ───────────────────────────────────────────────
  # The last good expiry series stay exported while the probe is blind — the alert, not the
  # absence of an expiry alert, is what tells the human the belt is not looking.
  - interval: 1m
    name: "probe_ok 0 for 30m fires the blind alert; healthy-before does not"
    input_series:
      - series: 'credential_expiry_probe_ok{provider="cloudflare",pod="p-a"}'
        values: "1+0x9 0+0x60"
    alert_rule_test:
      - eval_time: 35m
        alertname: CredentialExpiryProbeBlind
        exp_alerts: []
      - eval_time: 45m
        alertname: CredentialExpiryProbeBlind
        exp_alerts:
          - exp_labels: { provider: cloudflare, severity: warning, platform_machinery: "true", triage: dig }
            exp_annotations:
              description: "The credential-expiry probe has not completed a fresh poll for 30m — the expiry gauge is UNKNOWN, not clear, and a credential could now expire unannounced. SYMPTOM ONLY. Check: deploy/cloudflare-credential-expiry-probe in monitoring (logs every failed poll), the cloudflare-inventory-read Secret (ESO ← Infisical CLOUDFLARE_INVENTORY_READ), then the token itself (homelab-token-inventory-read, docs/cloudflare.md §Token matrix)."
              summary: "Credential-expiry belt is blind on provider cloudflare"

  # ── 4 — blind: the probe is GONE (absence is never agreement, FU-150) ───────────────────────
  - interval: 1m
    name: "no probe series at all fires the blind alert with the provider label"
    input_series:
      - series: 'unrelated_metric'
        values: "1+0x60"
    alert_rule_test:
      - eval_time: 45m
        alertname: CredentialExpiryProbeBlind
        exp_alerts:
          - exp_labels: { provider: cloudflare, severity: warning, platform_machinery: "true", triage: dig }
            exp_annotations:
              description: "The credential-expiry probe has not completed a fresh poll for 30m — the expiry gauge is UNKNOWN, not clear, and a credential could now expire unannounced. SYMPTOM ONLY. Check: deploy/cloudflare-credential-expiry-probe in monitoring (logs every failed poll), the cloudflare-inventory-read Secret (ESO ← Infisical CLOUDFLARE_INVENTORY_READ), then the token itself (homelab-token-inventory-read, docs/cloudflare.md §Token matrix)."
              summary: "Credential-expiry belt is blind on provider cloudflare"
      - eval_time: 45m
        alertname: CredentialExpiringSoon
        exp_alerts: []

  # ── 5 — a probe roll is not blindness ───────────────────────────────────────────────────────
  - interval: 1m
    name: "a 2m replicas:1 roll of the probe does not fire the blind alert"
    input_series:
      - series: 'credential_expiry_probe_ok{provider="cloudflare",pod="p-a"}'
        values: "1+0x20 stale"
      - series: 'credential_expiry_probe_ok{provider="cloudflare",pod="p-b"}'
        values: "_x23 1+0x60"
    alert_rule_test:
      - eval_time: 70m
        alertname: CredentialExpiryProbeBlind
        exp_alerts: []
