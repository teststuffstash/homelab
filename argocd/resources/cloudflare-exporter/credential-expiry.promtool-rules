# The credential-expiry belt's three alerts (FU-156), lifted VERBATIM out of prometheusrule.yaml's
# `credential-expiry` group (comments stripped — the manifest is their one home). Loaded by
# credential-expiry.promtool-test. Named .promtool-rules, not .yaml: manifest-lint kubeconforms
# every *.yaml under argocd/resources. Drift-pinned against the CR by prometheus-rules-lint
# (homelab#337/#375). Re-copy after every expr edit (one line — dash mangles multi-line args):
#
#   yq -o=json '{"groups": [.spec.groups[] | select(.name == "credential-expiry")]}' argocd/resources/cloudflare-exporter/prometheusrule.yaml | yq -P '.'
groups:
  - name: credential-expiry
    rules:
      - alert: CredentialExpiringSoon
        expr: (min by (provider, credential) (min_over_time(credential_expiry_timestamp_seconds[10m])) - time() < 30 * 86400) unless (min by (provider, credential) (min_over_time(credential_expiry_timestamp_seconds[10m])) - time() < 7 * 86400)
        for: 10m
        labels:
          severity: warning
          platform_machinery: "true"
          triage: none
        annotations:
          summary: '{{ $labels.provider }} credential "{{ $labels.credential }}" expires in {{ $value | humanizeDuration }}'
          description: '{{ if eq $labels.credential "Create Additional Tokens" }}The Tier-0 Cloudflare mint-root expires in {{ $value | humanizeDuration }}. It is DASHBOARD-renewed by construction: re-create it from the recipe in tofu/cloudflare-token/README.md §The admin token, re-store in the host admin wallet (docs/secrets.md §Minting doctrine).{{ else }}Credential "{{ $labels.credential }}" ({{ $labels.provider }}) expires in {{ $value | humanizeDuration }}. Renew or RETIRE (a superseded credential is deleted, not renewed — docs/secrets.md §Credential expiry). Cloudflare: bump expires_on in tofu/cloudflare-token/, then on the host `devbox run cloudflare-token-tofu plan` + `apply` (tofu/cloudflare-token/README.md); the wrapper re-stores wallet + cache + Infisical (scripts/cloudflare-token-store.sh) — then refresh any non-ESO consumer the docs/cloudflare.md token matrix names.{{ end }}'
      - alert: CredentialExpiryImminent
        expr: min by (provider, credential) (min_over_time(credential_expiry_timestamp_seconds[10m])) - time() < 7 * 86400
        for: 10m
        labels:
          severity: critical
          platform_machinery: "true"
          triage: none
        annotations:
          summary: '{{ $labels.provider }} credential "{{ $labels.credential }}" expires in {{ $value | humanizeDuration }} — renew NOW'
          description: 'Under 7 days (negative = ALREADY EXPIRED). {{ if eq $labels.credential "Create Additional Tokens" }}Tier-0 Cloudflare mint-root: DASHBOARD-renewed — tofu/cloudflare-token/README.md §The admin token, re-store in the host admin wallet. Without it no other Cloudflare token can be re-minted.{{ else }}Renew via the mint root''s apply on the host (Cloudflare: bump expires_on, `devbox run cloudflare-token-tofu apply` — tofu/cloudflare-token/README.md; the wrapper re-stores) or retire it; consumers in the docs/cloudflare.md token matrix.{{ end }}'
      - alert: CredentialExpiryProbeBlind
        expr: min by (provider) (min_over_time(credential_expiry_probe_ok[10m])) == 0 or absent_over_time(credential_expiry_probe_ok{provider="cloudflare"}[10m])
        for: 30m
        labels:
          severity: warning
          platform_machinery: "true"
          triage: dig
        annotations:
          summary: Credential-expiry belt is blind on provider {{ $labels.provider }}
          description: 'The credential-expiry probe has not completed a fresh poll for 30m — the expiry gauge is UNKNOWN, not clear, and a credential could now expire unannounced. SYMPTOM ONLY. Check: deploy/cloudflare-credential-expiry-probe in monitoring (logs every failed poll), the cloudflare-inventory-read Secret (ESO ← Infisical CLOUDFLARE_INVENTORY_READ), then the token itself (homelab-token-inventory-read, docs/cloudflare.md §Token matrix).'
