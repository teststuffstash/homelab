  # ── 5/7 — THE CEILING, asserted rather than assumed ──────────────────────────────────────────
  # [10m] is a bridge, not immunity — the same accepted limit #288 measured (ten pod generations,
  # gapped 69-116s of raw samples) and #313/#328/#331 carried unchanged. A hole longer than the
  # range — a crash-loop, an image pull off a cold mirror, a node drain — empties the vector for
  # real and costs the whole `for: 30m` again. Asserted once for the group: all three alerts share
  # one range and one mechanism.
  # The blind alert shows it most sharply, because at the ceiling the two arms hand over: the zone
  # arm empties at exactly the minute the absent arm turns true, so the alert does not go silent —
  # it changes identity and re-clocks, which is the pre-#334 behaviour the bridge merely postpones.
  - interval: 1m
    name: a 13m hole DOES reset the window — the accepted limit of [10m]
    input_series:
      - series: 'cloudflare_zone_spend_probe_ok{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.166:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-7946494648-mp24c",service="cloudflare-spend-probe"}'
        values: "0+0x10 stale"
      - series: 'cloudflare_zone_spend_probe_ok{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.171:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-6b8d5c9f42-q7x2n",service="cloudflare-spend-probe"}'
        values: "_x24 0+0x120"
      - series: 'cloudflare_zone_spend_probe_ok{zone="minutark.ee",container="probe",endpoint="http-metrics",instance="10.244.2.166:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-7946494648-mp24c",service="cloudflare-spend-probe"}'
        values: "0+0x10 stale"
      - series: 'cloudflare_zone_spend_probe_ok{zone="minutark.ee",container="probe",endpoint="http-metrics",instance="10.244.2.171:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-6b8d5c9f42-q7x2n",service="cloudflare-spend-probe"}'
        values: "_x24 0+0x120"
    promql_expr_test:
      # nine gapped scrapes survive: the last real samples (t=10m) are inside (9m, 19m]
      - expr: min by (zone) (min_over_time(cloudflare_zone_spend_probe_ok[10m]))
        eval_time: 19m
        exp_samples:
          - labels: '{zone="teststuff.net"}'
            value: 0
          - labels: '{zone="minutark.ee"}'
            value: 0
      # the tenth does not — and the absent arm takes over in the same evaluation, which is the
      # identity change that re-clocks the window
      - expr: min by (zone) (min_over_time(cloudflare_zone_spend_probe_ok[10m]))
        eval_time: 20m
        exp_samples: []
      - expr: absent(min_over_time(cloudflare_zone_spend_probe_ok[10m]))
        eval_time: 20m
        exp_samples:
          - labels: "{}"
            value: 1
    alert_rule_test:
      # without the hole this pages at 30m; the 19 minutes it had accumulated are gone
      - eval_time: 30m
        alertname: CloudflareSpendProbeBlind
        exp_alerts: []
      # …and it re-pages 30m after the new pod's first sample (24m + 30m), not before — the same
      # cost the pre-#334 form paid for a 2-minute roll in test 3
      - eval_time: 53m
        alertname: CloudflareSpendProbeBlind
        exp_alerts: []
      - eval_time: 55m
        alertname: CloudflareSpendProbeBlind
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              zone: minutark.ee
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone minutark.ee"
              description: "The spend-toggle probe has not read a zone's plan/Argo state for 30m — the gauges above are UNKNOWN, not safe, and a toggle flipped now would go unnoticed. SYMPTOM ONLY. Check: pod + logs (deploy/cloudflare-spend-probe in monitoring, it logs every failed read), the cloudflare-exporter-token Secret (ESO ← Infisical CLOUDFLARE_OBSERVABILITY_READ), then the token's Zone Settings Read on both product zones (docs/cloudflare.md §Token matrix)."
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              zone: teststuff.net
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone teststuff.net"
              description: "The spend-toggle probe has not read a zone's plan/Argo state for 30m — the gauges above are UNKNOWN, not safe, and a toggle flipped now would go unnoticed. SYMPTOM ONLY. Check: pod + logs (deploy/cloudflare-spend-probe in monitoring, it logs every failed read), the cloudflare-exporter-token Secret (ESO ← Infisical CLOUDFLARE_OBSERVABILITY_READ), then the token's Zone Settings Read on both product zones (docs/cloudflare.md §Token matrix)."
      # the witness lands in the same minute — at the ceiling the two forms are indistinguishable,
      # which is exactly what "a bridge, not immunity" means
      - eval_time: 55m
        alertname: CloudflareSpendProbeBlindPre334
        exp_alerts:
          - exp_labels:
              severity: warning
              zone: minutark.ee
              container: probe
              endpoint: http-metrics
              instance: 10.244.2.171:9505
              job: cloudflare-spend-probe
              namespace: monitoring
              pod: cloudflare-spend-probe-6b8d5c9f42-q7x2n
              service: cloudflare-spend-probe
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone minutark.ee"
          - exp_labels:
              severity: warning
              zone: teststuff.net
              container: probe
              endpoint: http-metrics
              instance: 10.244.2.171:9505
              job: cloudflare-spend-probe
              namespace: monitoring
              pod: cloudflare-spend-probe-6b8d5c9f42-q7x2n
