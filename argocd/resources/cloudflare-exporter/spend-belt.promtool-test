  # ── 6/7 — THE PRICE OF DROPPING IDENTITY, which is not the price #313 paid ───────────────────
  # #313 accepted masking: `max by (job)` over a HIGH-is-bad staleness gauge lets a healthy instance
  # hide a stuck one. That does NOT happen here, and copying the claim across would have been wrong.
  # Both aggregations in #334 were chosen alert-preserving — `max` on the HIGH-is-bad Argo toggle,
  # `min` on the LOW-is-bad `plan_is_free`/`spend_probe_ok` — so the BAD replica always wins the
  # aggregation and the belt still fires. Two real costs remain, and both are asserted below:
  #   • the alert can no longer name the pod (the operator's first `kubectl logs` target is gone
  #     from the labels; the runbook line in the description is what replaces it), and
  #   • one stuck replica pages for the whole zone, where the per-pod form paged for one pod.
  # For a spend belt that direction is the right one — fail loud on a card that can be billed.
  # UNREACHABLE today: both Deployments are `replicas: 1` (verified live 2026-08-12). If either is
  # ever scaled out, THIS is the test to revisit first.
  - interval: 1m
    name: "accepted cost: the bad replica wins and the pod name is gone (unreachable at replicas: 1)"
    input_series:
      # a hypothetical second replica: one probe stuck blind, one perfectly healthy, same zone
      - series: 'cloudflare_zone_spend_probe_ok{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.166:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-7946494648-mp24c",service="cloudflare-spend-probe"}'
        values: "0+0x120"
      - series: 'cloudflare_zone_spend_probe_ok{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.171:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-6b8d5c9f42-q7x2n",service="cloudflare-spend-probe"}'
        values: "1+0x120"
      # …and the same split on the HIGH-is-bad gauge: one replica has read the drift, one has not
      - series: 'cloudflare_zone_argo_smart_routing{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.166:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-7946494648-mp24c",service="cloudflare-spend-probe"}'
        values: "1+0x120"
      - series: 'cloudflare_zone_argo_smart_routing{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.171:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-6b8d5c9f42-q7x2n",service="cloudflare-spend-probe"}'
        values: "0+0x120"
    alert_rule_test:
      # LOW-is-bad: `min` keeps the stuck replica's 0, so the belt fires — no masking
      - eval_time: 31m
        alertname: CloudflareSpendProbeBlind
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              zone: teststuff.net
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone teststuff.net"
              description: "The spend-toggle probe has not read a zone's plan/Argo state for 30m — the gauges above are UNKNOWN, not safe, and a toggle flipped now would go unnoticed. SYMPTOM ONLY. Check: pod + logs (deploy/cloudflare-spend-probe in monitoring, it logs every failed read), the cloudflare-exporter-token Secret (ESO ← Infisical CLOUDFLARE_OBSERVABILITY_READ), then the token's Zone Settings Read on both product zones (docs/cloudflare.md §Token matrix)."
      # HIGH-is-bad: `max` keeps the drifted replica's 1, same result from the other direction
      - eval_time: 6m
        alertname: CloudflareZoneSpendToggleEnabled
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              zone: teststuff.net
            exp_annotations:
              summary: "Usage-billed toggle enabled on Cloudflare zone teststuff.net"
              description: "Argo Smart Routing is no longer \"off\" on zone teststuff.net — a per-GB usage-billed feature, which bills the card attached to the account. SYMPTOM ONLY. Check: Cloudflare audit log for who/when (docs/cloudflare.md §Token matrix lists which tokens carry Zone Settings Write), then GET /zones/{id}/argo/smart_routing to confirm the live value."
      # what is actually lost: the pre-#334 forms named the offending pod, and only that pod
      - eval_time: 31m
        alertname: CloudflareSpendProbeBlindPre334
        exp_alerts:
          - exp_labels:
              severity: warning
              zone: teststuff.net
              container: probe
              endpoint: http-metrics
              instance: 10.244.2.166:9505
              job: cloudflare-spend-probe
              namespace: monitoring
              pod: cloudflare-spend-probe-7946494648-mp24c
              service: cloudflare-spend-probe
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone teststuff.net"
      - eval_time: 6m
        alertname: CloudflareZoneSpendToggleEnabledPre334
        exp_alerts:
          - exp_labels:
              severity: warning
              zone: teststuff.net
              container: probe
              endpoint: http-metrics
              instance: 10.244.2.166:9505
              job: cloudflare-spend-probe
              namespace: monitoring
              pod: cloudflare-spend-probe-7946494648-mp24c
              service: cloudflare-spend-probe
            exp_annotations:
              summary: "Usage-billed toggle enabled on Cloudflare zone teststuff.net"

  # ── 7/7 — the SYMMETRY of the range: a fixed condition keeps ringing for ≤10m ────────────────
  # The mirror image of the bridge, and the reason the range cannot simply be widened. For up to a
  # range window after the probe recovers (the token is re-scoped, #231 is fixed) `min_over_time`
  # still reports the blind sample, so the alert clears late. Bounded and exact: the last `0`
  # (t=40m) leaves the range at t=50m.
  # Accepted for the same reason as everywhere else in this class — an alert that rings 10 minutes
  # long costs one glance, an alert whose window restarts on every sync costs the page entirely.
  - interval: 1m
    name: "accepted cost: a probe that recovers keeps reading blind for ≤10m"
    input_series:
      - series: 'cloudflare_zone_spend_probe_ok{zone="teststuff.net",container="probe",endpoint="http-metrics",instance="10.244.2.166:9505",job="cloudflare-spend-probe",namespace="monitoring",pod="cloudflare-spend-probe-7946494648-mp24c",service="cloudflare-spend-probe"}'
        values: "0+0x40 1+0x100"
    promql_expr_test:
      - expr: min by (zone) (min_over_time(cloudflare_zone_spend_probe_ok[10m]))
        eval_time: 49m
        exp_samples:
          - labels: '{zone="teststuff.net"}'
            value: 0
      - expr: min by (zone) (min_over_time(cloudflare_zone_spend_probe_ok[10m]))
        eval_time: 50m
        exp_samples:
          - labels: '{zone="teststuff.net"}'
            value: 1
    alert_rule_test:
      # the probe recovers at t=41m; the pre-#334 form resolves in that same evaluation…
      - eval_time: 45m
        alertname: CloudflareSpendProbeBlindPre334
        exp_alerts: []
      # …while the shipped alert holds the low-water reading until the range rolls over
      - eval_time: 45m
        alertname: CloudflareSpendProbeBlind
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              zone: teststuff.net
            exp_annotations:
              summary: "Cloudflare spend-toggle belt is blind on zone teststuff.net"
              description: "The spend-toggle probe has not read a zone's plan/Argo state for 30m — the gauges above are UNKNOWN, not safe, and a toggle flipped now would go unnoticed. SYMPTOM ONLY. Check: pod + logs (deploy/cloudflare-spend-probe in monitoring, it logs every failed read), the cloudflare-exporter-token Secret (ESO ← Infisical CLOUDFLARE_OBSERVABILITY_READ), then the token's Zone Settings Read on both product zones (docs/cloudflare.md §Token matrix)."
      # …bounded by the range, not open-ended
      - eval_time: 51m
        alertname: CloudflareSpendProbeBlind
        exp_alerts: []
