# Behaviour fixture for the `agent-gateway-codex-headroom` alerts (prometheusrule.yaml beside this file).
#
#   devbox run prometheus-rules-lint      # runs this, and every other *.promtool-test under argocd/
#
# LABELS are the real scraped set of gateway_* (container, endpoint, instance, job, namespace, pod,
# service — read off the live gateway_sessions_active series, 2026-10-17), plus the family's own
# `outcome`. The family is hand-driven here; its values are the gateway's own rows in
# gateway/specs/endpoints/openai-responses.md §Poll (one increment per poll, by outcome; every
# outcome renders from 0 once the rail is declared; absent while the policy omits the rail).
# The deployed poll_interval_s is the policy's; these fixtures poll twice a minute.
rule_files:
  - codex-headroom.promtool-rules

evaluation_interval: 1m

tests:
  # ══ P1 — HEALTHY: two accepted polls a minute, nothing else ═════════════════════════════════
  - interval: 1m
    name: P1 healthy — accepted polls keep both alerts quiet
    input_series:
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="accepted"}'
        values: "0+2x60"
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="upstream-http-error"}'
        values: "0x60"
    alert_rule_test:
      - eval_time: 30m
        alertname: CodexUsagePollStale
        exp_alerts: []
      - eval_time: 30m
        alertname: CodexUsagePollSilent
        exp_alerts: []
      - eval_time: 60m
        alertname: CodexUsagePollSilent
        exp_alerts: []

  # ══ P2 — STALE: the polls run, every one answered 500 ════════════════════════════════════════
  # increase(accepted) is 0 and increase(all) > 0 from the second sample on; for: 5m → firing from
  # ~6m. Silent never: polls are running.
  - interval: 1m
    name: P2 stale — polls run but none is accepted
    input_series:
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="accepted"}'
        values: "0x60"
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="upstream-http-error"}'
        values: "0+2x60"
    alert_rule_test:
      - eval_time: 3m
        alertname: CodexUsagePollStale
        exp_alerts: []
      - eval_time: 10m
        alertname: CodexUsagePollStale
        exp_alerts:
          - exp_labels:
              rail: codex
              severity: warning
              triage: now
            exp_annotations:
              summary: "The gateway's codex usage poll has accepted nothing for 15 m — the codex rail is deferring (quota-stale)"
              description: "gateway_codex_usage_poll_total counts polls but none ended accepted in 15 m, so the headroom report is past rails.codex.headroom.max_age_s and admission answers quota-stale. Check: (1) sum by (outcome) (increase(gateway_codex_usage_poll_total[15m])) names the outcome — upstream-auth = the usage endpoint rejects the credential (not by itself a revocation: see the request log), quota-invalid = the payload no longer matches the profile the poll translates (gateway/src/agent_gateway/codex_usage.py; the shape is docs/spikes/codex-subscription-rail.md §Live usage payload shape), credential-* = the lifecycle (GW-CODEX-OAUTH; credential-recovery-required needs a re-seed: devbox run codex-seed); (2) kubectl -n agent-egress logs deploy/agent-gateway | grep \"codex usage poll\". Clears on the next accepted poll."
      - eval_time: 40m
        alertname: CodexUsagePollSilent
        exp_alerts: []

  # ══ P3 — SILENT: the rail is declared (the family renders 0) but no poll ever runs ══════════
  # The condition holds from the first sample; for: 15m → firing from 15m. Stale never: no polls.
  - interval: 1m
    name: P3 silent — a declared rail whose poll is dark
    input_series:
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="accepted"}'
        values: "0x60"
      - series: 'gateway_codex_usage_poll_total{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",outcome="upstream-http-error"}'
        values: "0x60"
    alert_rule_test:
      - eval_time: 10m
        alertname: CodexUsagePollSilent
        exp_alerts: []
      - eval_time: 20m
        alertname: CodexUsagePollSilent
        exp_alerts:
          - exp_labels:
              rail: codex
              severity: warning
              triage: dig
            exp_annotations:
              summary: "The codex rail is declared but its usage poll has not run for 15 m — the rail sits on quota-unknown"
              description: "gateway_codex_usage_poll_total renders (the policy declares the codex rail) but no poll ran in 15 m. The poll runs only with CODEX_USAGE_URL set AND a credential backend (CODEX_UPSTREAM + CODEX_SEED_FILE with a mounted seed — ESO Secret agent-egress/codex-seed): kubectl -n agent-egress logs deploy/agent-gateway | grep \"codex usage poll dark\" names which is missing; a live schedule that died logs \"codex usage poll: one pass failed\". Until a poll is accepted every codex admission defers quota-unknown."
      - eval_time: 40m
        alertname: CodexUsagePollStale
        exp_alerts: []

  # ══ P4 — UNDECLARED: the family is absent (today's deployed policy) — nothing can fire ═══════
  - interval: 1m
    name: P4 undeclared rail — an absent family fires nothing
    input_series:
      - series: 'gateway_sessions_active{container="gateway",endpoint="http",instance="10.244.7.31:8080",job="agent-gateway",namespace="agent-egress",pod="agent-gateway-6d484cdd96-bb87m",service="agent-gateway",rail="anthropic"}'
        values: "1x60"
    alert_rule_test:
      - eval_time: 40m
        alertname: CodexUsagePollSilent
        exp_alerts: []
      - eval_time: 40m
        alertname: CodexUsagePollStale
        exp_alerts: []
