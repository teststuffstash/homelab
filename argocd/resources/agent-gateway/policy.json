{
  "stacks": {
    "platform": {
      "loop_ns": "platform-agents",
      "openrouter_ref": "homelab/homelab-openrouter",
      "anthropic_ref": "homelab/claude-session"
    },
    "oracle": {
      "loop_ns": "oracle-agents",
      "openrouter_ref": "oracle-fleet/oracle-fleet-openrouter",
      "anthropic_ref": "oracle-fleet/claude-session"
    },
    "sleep": {
      "loop_ns": "sleep-agents",
      "openrouter_ref": "sleep-tracking/sleep-tracking-openrouter",
      "anthropic_ref": "sleep-tracking/claude-session"
    },
    "circles": {
      "loop_ns": "circles-agents",
      "openrouter_ref": "circles/circles-openrouter",
      "anthropic_ref": "circles/claude-session"
    }
  },
  "roles": {
    "worker":      {"rails": ["opencode", "openrouter"],  "tier": "standard", "harness": "opencode"},
    "reviewer":    {"rails": ["anthropic", "opencode"],   "tier": "heavy",    "harness": "claude"},
    "coordinator": {"rails": ["anthropic"],               "tier": "standard", "harness": "claude"},
    "responder":   {"rails": ["anthropic"],               "tier": "standard", "harness": "claude"},
    "retro":       {"rails": ["openrouter"],              "tier": "heavy",    "harness": "opencode"},
    "researcher":  {"rails": ["openrouter"],              "tier": "heavy",    "harness": "opencode"},
    "prober":      {"rails": ["openrouter", "opencode"],  "tier": "light",    "harness": "opencode"}
  },
  "rails": {
    "anthropic": {
      "user_agent": "forward",
      "admission": {
        "_comment": "⚖ the old proxy's values, copied (sessions.md §Capacity): utilization_thresholds 5h = ANTHROPIC_UTIL_THRESHOLD's code default 0.80 (openrouter-proxy.py; unset in its deployment.yaml), 7d = ANTHROPIC_UTIL_THRESHOLD_7D 0.95 (deployment.yaml); latch_429_hold_s = ANTHROPIC_429_HOLD_S 900. reading_stale_s 900 has NO old-proxy precedent (it only drops a reading whose reset passed) — the gateway's own guess, ⚖.",
        "utilization_thresholds": {"5h": 0.80, "7d": 0.95},
        "reading_stale_s": 900,
        "latch_429_hold_s": 900
      },
      "max_sessions": 5,
      "side_models": ["claude/haiku"],
      "models": {
        "light":    ["claude/haiku"],
        "standard": ["claude/sonnet"],
        "heavy":    ["claude/sonnet"]
      }
    },
    "opencode": {
      "user_agent": "fixed",
      "credential_probe": {"method": "POST", "path": "/v1/chat/completions", "body": {"model": "deepseek-v4.1-flash", "max_tokens": 1, "messages": [{"role": "user", "content": "."}]}, "backoff_s": [60, 3600]},
      "admission": {
        "_comment": "Rules only (GW-CATALOG-GO, operator ruling 5, 2026-10-17): prices, peak rows and hours, per-model monthly limits and the window shares come from the Go catalog snapshot, never from here. latch_429_hold_s = openrouter-proxy.py GO_CAPACITY_HOLD_S 900: the hold a Go 429 that names no reset cools its CELL for; latch_scope model = a Go 429 never latches the whole rail (ruling 3: each model has its own limits). windows: the anchors are gometer _GO_WINDOW_DEFAULTS (chain / weekly mon 00:00 / monthly 13 11:30 — self-measured, no vendor source; GO_WINDOW_ANCHORS unset in deployment.yaml), threshold = OPENCODE_UTIL_THRESHOLD's code default 0.80 (unset in deployment.yaml).",
        "latch_429_hold_s": 900,
        "latch_scope": "model",
        "window_draw": {
          "windows": {
            "5h":  {"threshold": 0.80, "anchor": "chain", "span_s": 18000, "chain_lookback_s": 604800},
            "7d":  {"threshold": 0.80, "anchor": "weekly", "weekday": "mon", "hour": 0, "minute": 0},
            "30d": {"threshold": 0.80, "anchor": "monthly", "month_day": 13, "hour": 11, "minute": 30}
          }
        }
      },
      "plan": "go",
      "max_sessions": 3,
      "models": {
        "light":    ["opencode-go/deepseek-v4.1-flash"],
        "standard": ["opencode-go/deepseek-v4.1-flash"],
        "heavy":    ["opencode-go/deepseek-v4.1-flash"]
      }
    },
    "openrouter": {
      "user_agent": "forward",
      "credential_probe": {"method": "GET", "path": "/v1/key", "backoff_s": [60, 3600]},
      "max_sessions": 20,
      "models": {
        "light":    ["deepseek/deepseek-v4-flash"],
        "standard": ["deepseek/deepseek-v4-flash"],
        "heavy":    ["deepseek/deepseek-v4.1-flash"]
      }
    }
  },
  "context_tokens": {
    "opencode-go/deepseek-v4.1-flash": 1000000
  },
  "control_plane_auth": "enforce",
  "callers": {
    "system:serviceaccount:platform-agents:agentstack-loop": {
      "stacks": ["platform"],
      "roles": ["worker"],
      "bind_namespaces": ["agent-runtime", "homelab", "openrouter-operator"]
    },
    "system:serviceaccount:agent-coordinator:agent-coordinator": {
      "stacks": ["platform"],
      "roles": ["reviewer", "worker"],
      "bind_namespaces": []
    }
  },
  "session_ttl_s": 14400,
  "outcome_window_s": 86400
}
