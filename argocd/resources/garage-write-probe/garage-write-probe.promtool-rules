# Alert expressions for garage-write-probe (homelab#1560).
# Manual review and syntax check via: devbox run prometheus-rules-lint
#
# Three belts: Failing (any leg == 0 for 10m), Slow (put p99 > 10s for 15m), Silent (no heartbeat for 10m+).

groups:
  - name: garage-write-probe
    rules:
      - alert: GarageWriteProbeFailing
        expr: |
          (min_over_time(garage_write_probe_success{leg="put"}[5m]) == 0) or
          (min_over_time(garage_write_probe_success{leg="get"}[5m]) == 0) or
          (min_over_time(garage_write_probe_success{leg="delete"}[5m]) == 0)
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Garage write probe failing"
          description: >-
            A write probe operation has failed in every 5m window for 10m.
            This is a client-perspective detector.

      - alert: GarageWriteProbeSlow
        expr: |
          garage_write_probe_seconds{leg="put"} > 10
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Garage write probe PUT latency > 10s"
          description: >-
            The write probe's PUT operation latency > 10s for 15m.

      - alert: GarageWriteProbeSilent
        expr: |
          time() - garage_write_probe_last_run_timestamp > 600
        for: 0m
        labels: { severity: warning }
        annotations:
          summary: "Garage write probe has not run for >10 minutes"
          description: >-
            The write probe has not reported a timestamp in over 10 minutes.
