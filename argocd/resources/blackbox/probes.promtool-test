# Behaviour fixture for EndpointProbeFailing, BOTH COPIES (homelab#336 — the #288/#313/#332
# restart-gap class applied to the single-replica blackbox prober, sized by #349's bound).
#
#   devbox run -- promtool test rules argocd/resources/blackbox/probes.promtool-test
#
# `devbox run prometheus-rules-lint` runs this in CI (it executes `promtool test rules` over every
# *.promtool-test under argocd/), so a red fixture here is a red required check. Named
# .promtool-test, not .yaml: manifest-lint kubeconforms every *.yaml under argocd/resources — and
# it has NO schema for PrometheusRule, so it SKIPS the manifest edit these tests exist to check.
# This file is the gate on that change, not manifest-lint.
#
# WHAT IS BEING PINNED, in the order the argument runs:
#   1. THE HOLE — blackbox-exporter is `replicas: 1` and every probe in the file is scraped
#      THROUGH it, so a roll empties them all at once and the raw expr's `for: 10m` restarts.
#   2. THE CEILING — a hole wider than the range still restarts it. Accepted, so asserted.
#   3. THE SIZE — #349's bound, replayed against the worst flake in Prometheus's retention. The
#      class's mechanical [10m] pages on it; [5m] does not. Both directions are executed, and the
#      boundary between them is ONE missed probe (cases 3 and 4).
#   4. THE DIRECTION — `min_over_time`, because low is the bad reading. The class's default `max`
#      is loaded as a witness and shown arriving late.
#   5. THE PARTITION AND THE LABELS — three rules share the alertname `EndpointProbeFailing`
#      across two manifests; each target must raise exactly ONE of them, with the labels its
#      annotations read still on it (the identity half is deliberately absent — nothing churns).
#
# ⚠ FIXTURE NOTE, and unlike gc-mirrors.promtool-test this one does NOT have to work around it:
# `stale` in an input series injects a real staleness marker, which is exactly what Prometheus
# writes when a scrape fails — so the holes below bite instantly, with no 5m-lookback cushion,
# the way a real prober roll does. Sizes are therefore literal: `_x2` after a marker is a
# four-minute gap between real samples, not a modelled approximation.
#
# CLOCK: promtool's test clock starts at 0 and `interval: 1m` matches the Probe's own 60s
# interval, so one step here is one probe.
#
# THE 2026-08-07 EVENT MODELLED IN CASES 3 AND 4 IS REAL: at 17:06Z every LAN front flaked
# together — argo, specs.oracle and transcripts missed one probe, grafana and mcp.oracle two —
# and it is the only multi-target probe failure in the 8 days Prometheus retains. Replaying the
# candidate ranges over that window gave longest-continuous-truth of 4 minutes at [3m], 6 at [5m]
# and 11 at [10m] against the 11 needed to page, which is why [10m] is the counter-witness here
# and [5m] is what shipped.
rule_files:
  - probes.promtool-rules

evaluation_interval: 1m

tests:
  # ── 1. The hole this bridge exists for: a prober roll mid-outage ──────────────────────────────
  # grafana.teststuff.net is genuinely down from t=0. At t=21 blackbox-exporter is replaced — the
  # scrape fails, Prometheus staleness-marks every probe series, and four minutes pass before a
  # real sample lands again. The endpoint never recovered; only the measurement went away.
  # The un-bridged form (regression-witness-pre-336) resolves on the marker and pays a fresh
  # `for: 10m` on the way out: THIRTEEN minutes of a dead front-door with no alert, bought by a
  # four-minute roll. That gap is the whole point of the change, and it is the assertion pair at
  # t=23 and t=33.
  - interval: 1m
    name: a prober roll mid-outage no longer restarts the window (and costs the un-bridged form 13m)
    input_series:
      - series: 'probe_success{instance="https://grafana.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "0+0x20 stale _x2 0+0x60"
    alert_rule_test:
      # `for: 10m` has not elapsed yet
      - eval_time: 9m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 10m
        alertname: EndpointProbeFailing
        exp_alerts: &grafana_alert
          - exp_labels:
              severity: warning
              instance: https://grafana.teststuff.net
              job: blackbox-lan
              namespace: monitoring
      # mid-hole, past the staleness marker: the raw selector is EMPTY here. The bridged one is
      # not — the range still reaches the samples at t=19,20.
      - eval_time: 21m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      - eval_time: 23m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      # …and it never stopped firing, so the recovery of the SCRAPE is a non-event
      - eval_time: 30m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      - eval_time: 80m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      # THE CONTRAST, same series, same instants: the un-bridged alert fired on schedule…
      - eval_time: 10m
        alertname: EndpointProbeFailingPre336
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: https://grafana.teststuff.net
              job: blackbox-lan
              namespace: monitoring
      # …resolved on the staleness marker…
      - eval_time: 21m
        alertname: EndpointProbeFailingPre336
        exp_alerts: []
      - eval_time: 23m
        alertname: EndpointProbeFailingPre336
        exp_alerts: []
      # …and was still serving out a fresh 10m window here, thirteen minutes after it went quiet
      - eval_time: 33m
        alertname: EndpointProbeFailingPre336
        exp_alerts: []
      - eval_time: 34m
        alertname: EndpointProbeFailingPre336
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: https://grafana.teststuff.net
              job: blackbox-lan
              namespace: monitoring

  # ── 2. THE CEILING — a hole wider than [5m] does still restart the window ─────────────────────
  # Accepted, not fixed: a crash-loop, a cold image pull off a mirror, or a node drain outruns the
  # bridge. Asserted here so the limit is executed rather than assumed (the #313/#333 discipline).
  # Nine minutes of hole: last real sample t=20, first one after t=28.
  - interval: 1m
    name: a hole wider than the [5m] bridge does reset the 10m window (accepted ceiling)
    input_series:
      - series: 'probe_success{instance="https://grafana.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "0+0x20 stale _x6 0+0x60"
    alert_rule_test:
      # still inside the bridge — t=20 is the newest sample in (19,24]
      - eval_time: 24m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      # past it: (20,25] holds nothing at all, and the alert really does drop
      - eval_time: 25m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 26m
        alertname: EndpointProbeFailing
        exp_alerts: []
      # the probe returns at t=28 and pays a full fresh 10m
      - eval_time: 37m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 38m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert

  # ── 3. THE SIZE, upper bound: the real 2026-08-07 flake, TWO missed probes ────────────────────
  # grafana's actual shape at 17:06Z that day — two consecutive failed probes on an endpoint that
  # was fine before and after. This is the input that decides the range, because #349's bound says
  # the effective patience is `for: − B`: at the class's B = 10m it is zero, and this series then
  # holds the expr true for eleven minutes and PAGES. The shipped [5m] peaks at six and cannot.
  # If anyone ever "completes" this port to the class's default, this case is what goes red.
  - interval: 1m
    name: the 2026-08-07 two-probe flake — [5m] silent, the mechanical [10m] port pages
    input_series:
      - series: 'probe_success{instance="https://grafana.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "1+0x5 0 0 1+0x40"
    alert_rule_test:
      # pending at its longest under the shipped range, still not firing…
      - eval_time: 12m
        alertname: EndpointProbeFailing
        exp_alerts: []
      # …and spent one evaluation later, without ever having fired
      - eval_time: 13m
        alertname: EndpointProbeFailing
        exp_alerts: []
      # THE assertion of the ruling: 16m is the instant the [10m] port pages (below), and the
      # shipped range must be silent there.
      - eval_time: 16m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 17m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 30m
        alertname: EndpointProbeFailing
        exp_alerts: []
      # the counter-witness, on the same two-minute flake: a page nine minutes after the endpoint
      # came back, for a front that missed two probes.
      - eval_time: 15m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: []
      - eval_time: 16m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: &bridge10m_alert
          - exp_labels:
              severity: warning
              instance: https://grafana.teststuff.net
              job: blackbox-lan
              namespace: monitoring
      # …and it is gone one evaluation later, having paged for a single tick. That is not a
      # mitigating detail: Alertmanager's group_wait is 30s and the notification is already sent.
      - eval_time: 17m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: []

  # ── 4. THE SIZE, and the boundary is ONE PROBE ────────────────────────────────────────────────
  # The same 17:06Z event as seen by argo / specs.oracle / transcripts: one missed probe, not two.
  # Even the refused [10m] port stays silent here — true for ten evaluations, one short of the
  # eleven `for: 10m` demands. That is not a coincidence, it is `for: − B` = 0 evaluated at the
  # boundary, and the live replay discriminated at exactly this line: the two fronts that missed
  # two probes would have paged, the three that missed one would not. Pinned so the arithmetic in
  # the manifest is a check rather than a paragraph.
  - interval: 1m
    name: the same flake at ONE missed probe — even the [10m] port is one evaluation short
    input_series:
      - series: 'probe_success{instance="https://argo.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "1+0x5 0 1+0x40"
    alert_rule_test:
      - eval_time: 15m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: []
      - eval_time: 16m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: []
      - eval_time: 20m
        alertname: EndpointProbeFailingBridge10m
        exp_alerts: []
      - eval_time: 16m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 30m
        alertname: EndpointProbeFailing
        exp_alerts: []

  # ── 5. THE DIRECTION — `max_over_time` is the class's default and the wrong function here ──────
  # Class rule (ii): max is alert-PRESERVING only where HIGH is the bad reading. Here it holds the
  # healthiest sample of the window, so the range must fill entirely with failures before it flips
  # — four of the five minutes, on a 1m grid — and the page lands four minutes late on an endpoint
  # that went down at t=5 and stayed down.
  - interval: 1m
    name: max_over_time delays the page by nearly the whole range (why the direction is min)
    input_series:
      - series: 'probe_success{instance="https://grafana.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "1+0x4 0+0x60"
    alert_rule_test:
      - eval_time: 14m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 15m
        alertname: EndpointProbeFailing
        exp_alerts: *grafana_alert
      # the wrong direction is still pending here — four minutes of a dead endpoint, unreported
      - eval_time: 15m
        alertname: EndpointProbeFailingMaxDirection
        exp_alerts: []
      - eval_time: 18m
        alertname: EndpointProbeFailingMaxDirection
        exp_alerts: []
      - eval_time: 19m
        alertname: EndpointProbeFailingMaxDirection
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: https://grafana.teststuff.net
              job: blackbox-lan
              namespace: monitoring

  # ── 6. THE TEMPLATED COPY — the platform lane behaves identically, and the partition holds ────
  # `agentstack-slo-rendered` is the composition's alert at $sloStack = oracle. Same hole as case
  # 1, same outcome, which is the executed half of #336's "both or neither" requirement.
  # The exp_alerts LENGTH is the second assertion: three rules across two manifests share this
  # alertname, and the mcp endpoint must raise exactly the templated one — blackbox rule 1 wants
  # specs.oracle and rule 2 excludes mcp|specs.oracle, so a double-page here would be a selector
  # bug. `stack: oracle` surviving is the third: the responder's routing precedence reads it, and
  # it comes from the rule's own labels, not from the series.
  - interval: 1m
    name: the AgentStack-rendered copy rides the same roll, alone and with its stack label
    input_series:
      - series: 'probe_success{instance="https://mcp.oracle.teststuff.net/mcp",job="slo-oracle",namespace="monitoring"}'
        values: "0+0x20 stale _x2 0+0x60"
    alert_rule_test:
      - eval_time: 9m
        alertname: EndpointProbeFailing
        exp_alerts: []
      - eval_time: 10m
        alertname: EndpointProbeFailing
        exp_alerts: &mcp_alert
          - exp_labels:
              severity: warning
              stack: oracle
              instance: https://mcp.oracle.teststuff.net/mcp
              job: slo-oracle
              namespace: monitoring
      - eval_time: 23m
        alertname: EndpointProbeFailing
        exp_alerts: *mcp_alert
      - eval_time: 40m
        alertname: EndpointProbeFailing
        exp_alerts: *mcp_alert
      # the un-bridged form on the templated lane, for the same reason and at the same instants
      - eval_time: 23m
        alertname: EndpointProbeFailingPre336
        exp_alerts: []
      - eval_time: 34m
        alertname: EndpointProbeFailingPre336
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: https://mcp.oracle.teststuff.net/mcp
              job: slo-oracle
              namespace: monitoring

  # ── 7. UnboundGithubServfail (homelab#1125) — DNS probe through Unbound ──────────────────────
  # The alert fires when probe_success == 0 for 3m (three consecutive failed probes at 1m
  # interval). A single failed probe does not fire; recovery is immediate on the first success.
  - interval: 1m
    name: UnboundGithubServfail fires after 3m of probe_success == 0 and recovers on success
    input_series:
      - series: 'probe_success{instance="192.168.2.1:53",job="blackbox-unbound-github",namespace="monitoring"}'
        values: "1+0x2 0+0x5 1+0x10"
      # Decoy: a real http_2xx_lan target also failing — makes the fixture red against the
      # unselected expr (probe_success == 0 without instance/job selector) and green after
      # the selector is added. exp_alerts below expects exactly ONE alert (the unbound one).
      - series: 'probe_success{instance="https://grafana.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "0+0x20"
    alert_rule_test:
      # pending — only 1-2 failures so far
      - eval_time: 3m
        alertname: UnboundGithubServfail
        exp_alerts: []
      - eval_time: 4m
        alertname: UnboundGithubServfail
        exp_alerts: []
      # fires — 3 consecutive failures (t=3,4,5) have elapsed the for: 3m
      - eval_time: 6m
        alertname: UnboundGithubServfail
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: 192.168.2.1:53
              job: blackbox-unbound-github
              namespace: monitoring
      # still firing
      - eval_time: 7m
        alertname: UnboundGithubServfail
        exp_alerts:
          - exp_labels:
              severity: warning
              instance: 192.168.2.1:53
              job: blackbox-unbound-github
              namespace: monitoring
      # recovered — probe_success == 1 at t=8
      - eval_time: 9m
        alertname: UnboundGithubServfail
        exp_alerts: []
      - eval_time: 15m
        alertname: UnboundGithubServfail
        exp_alerts: []

  # ── 8. The hand-listed oracle rule — its own selector, its own stack label, and no overlap ────
  # specs.oracle is the one target blackbox rule 1 claims (FU-104 left it hand-listed until the
  # claim grows a multi-endpoint `slos` array). Rule 2 excludes it explicitly, so again exactly one
  # alert — and `stack: oracle` must be on it or the responder routes this to the wrong repo.
  - interval: 1m
    name: specs.oracle raises rule 1 only, keeps its stack label, and rides the roll
    input_series:
      - series: 'probe_success{instance="https://specs.oracle.teststuff.net",job="blackbox-lan",namespace="monitoring"}'
        values: "0+0x20 stale _x2 0+0x60"
    alert_rule_test:
      - eval_time: 10m
        alertname: EndpointProbeFailing
        exp_alerts: &specs_alert
          - exp_labels:
              severity: warning
              stack: oracle
              instance: https://specs.oracle.teststuff.net
              job: blackbox-lan
              namespace: monitoring
      - eval_time: 23m
        alertname: EndpointProbeFailing
        exp_alerts: *specs_alert
      - eval_time: 60m
        alertname: EndpointProbeFailing
        exp_alerts: *specs_alert
