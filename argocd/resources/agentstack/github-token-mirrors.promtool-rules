# Drift-pinned copy of prometheusrule.yaml's github-token-mirrors group for
# `promtool test rules` (scripts/prometheus-rules-lint.sh runs the fixture beside it). Recipe:
#   yq '{"groups": [.spec.groups[] | select(.name == "github-token-mirrors") | del(.rules[].annotations.description)]}' prometheusrule.yaml
groups:
  # GitHub-token mirror belt (oracle handoff 2026-09-22; oracle-fleet's 02:30Z retention cron
  # 401'd on 09-21 + 09-22). A GithubAccessToken generator's central ES in agent-coordinator
  # mints a 60-min App token; a kubernetes-provider MIRROR ES copies that Secret into a consumer
  # namespace (the composition's readOnlyGrants mirror, agents/coordinator/retro-git.yaml's).
  # Two independent refresh clocks: a mirror that refreshes φ minutes after each mint holds a
  # token aged φ..φ+interval — with 45m/45m, φ > 15m = a dead copy for a fixed window of every
  # cycle while both ES read SecretSynced. The observable: the mirror's last refresh PRECEDES the
  # latest mint of the Secret it copies. A healthy mirror catches up within its own (short)
  # interval; still behind after 10m = it serves a token ≥ central interval + 10m old.
  # Source: kube-state-metrics custom-resource-state (kube-prometheus-stack values).
  - name: github-token-mirrors
    rules:
      - alert: GithubTokenMirrorBehind
        expr: |
          (
              max by (remote_key) (
                label_replace(
                  kube_externalsecret_refresh_time{namespace="agent-coordinator", generator_kind="GithubAccessToken"},
                  "remote_key", "$1", "target", "(.+)"))
            - on (remote_key) group_right
              kube_externalsecret_refresh_time{namespace!="agent-coordinator", remote_key!=""}
          ) > 0
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.name }} still holds the token before the latest mint of {{ $labels.remote_key }} (10m+)"
      # The mint itself stalled (generator erroring, ESO down): the served token dies at 60m.
      - alert: GithubTokenMintStale
        expr: |
          time() - kube_externalsecret_refresh_time{generator_kind="GithubAccessToken"} > 3300
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.name }} has not minted a GitHub token for 55m+ — it expires within minutes"
      # Blind-belt guard (FU-125/FU-108 class): if the series stop, both rules above go quiet.
      - alert: GithubTokenMirrorMetricAbsent
        expr: |
          absent(kube_externalsecret_refresh_time{generator_kind="GithubAccessToken"})
        for: 30m
        labels: {severity: warning}
        annotations:
          summary: "No GithubAccessToken ExternalSecret refresh_time series for 30m — the token mirror belt is blind"
