# Behaviour fixture for the agent-loop-kpi group (homelab#3728) — the loop's own KPI series and their alerts.
#
#   devbox run -- promtool test rules argocd/resources/pushgateway/agent-loop-kpi.promtool-test
#   (in CI: `devbox run prometheus-rules-lint` runs every *.promtool-test under argocd/)
#
# The W cases run at a 5-minute input interval because the rule's `[7d:5m]` subquery counts 5-minute steps.
rule_files:
  - agent-loop-kpi.promtool-rules

evaluation_interval: 1h

tests:
  - interval: 1h
    name: U1 recorded — three ended rides, each with its run record, read 0 and stay silent
    input_series:
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-101-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-102-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-103-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="101",role="worker",round="1",exit_status="clean"}'
        values: "_x2 1x30"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="102",role="worker",round="1",exit_status="clean"}'
        values: "_x2 1x30"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="103",role="worker",round="1",exit_status="clean"}'
        values: "_x2 1x30"
    promql_expr_test:
      - expr: agent_loop:rides_ended:count_7d
        eval_time: 10h
        exp_samples:
          - labels: 'agent_loop:rides_ended:count_7d{project="homelab"}'
            value: 3
      - expr: agent_loop:rides_unrecorded:count_7d
        eval_time: 10h
        exp_samples:
          - labels: 'agent_loop:rides_unrecorded:count_7d{project="homelab"}'
            value: 0
    alert_rule_test:
      - eval_time: 10h
        alertname: AgentRidesUnrecorded
        exp_alerts: []
  - interval: 1h
    name: U2 unrecorded — three of four ended rides have no record (one a Failed pod deleted since, one recorded on another round only) and the alert fires
    input_series:
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-101-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-102-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-103-r2",phase="Failed",job="kube-state-metrics"}'
        values: "0x2 1x3 _x26"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-104-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="101",role="worker",round="1",exit_status="clean"}'
        values: "_x2 1x30"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="103",role="worker",round="1",exit_status="clean"}'
        values: "1x32"
    promql_expr_test:
      - expr: agent_loop:rides_unrecorded:count_7d
        eval_time: 10h
        exp_samples:
          - labels: 'agent_loop:rides_unrecorded:count_7d{project="homelab"}'
            value: 3
    alert_rule_test:
      - eval_time: 3h
        alertname: AgentRidesUnrecorded
        exp_alerts: []
      - eval_time: 10h
        alertname: AgentRidesUnrecorded
        exp_alerts:
          - exp_labels:
              severity: warning
              triage: dig
              project: homelab
            exp_annotations:
              summary: '3 worker rides on homelab ended in the last 7 days without a run record — above the KPI target (at most 1)'
              description: 'agent_loop:rides_unrecorded:count_7d{project="homelab"} is 3 (target: at most 1). A ride counts when its pod agent-<project>-issue-<n>-r<round> reached Succeeded or Failed in the 7 d and no agent_run_total series carries the same project, issue and round — the cost boards, the ledger and the retro never saw it. Check: (1) the expression of the record rule without its outer count names each issue and round; (2) the issue''s timeline comment for that round (a strike, a re-dispatch); (3) s3://agent-transcripts/<project>/issue-<n>/ for a worker-r<round>-* prefix — none means the pod died before its finalize step. The KPI and its target are named in docs/agents/observability-and-retro.md §Part D.'
  - interval: 30m
    name: U3 at target — one unrecorded ride stays silent, a running pod is not an ended ride, and a record absent for under an hour is still a record
    input_series:
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-101-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-102-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x2 1x30"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-105-r1",phase="Running",job="kube-state-metrics"}'
        values: "1x32"
      - series: 'kube_pod_status_phase{namespace="homelab",pod="agent-homelab-issue-105-r1",phase="Succeeded",job="kube-state-metrics"}'
        values: "0x32"
      - series: 'agent_run_total{job="agent_run",project="homelab",issue="101",role="worker",round="1",exit_status="clean"}'
        values: "_x2 1x7 stale 1x20"
    promql_expr_test:
      - expr: agent_loop:rides_ended:count_7d
        eval_time: 5h
        exp_samples:
          - labels: 'agent_loop:rides_ended:count_7d{project="homelab"}'
            value: 2
      - expr: agent_loop:rides_unrecorded:count_7d
        eval_time: 5h
        exp_samples:
          - labels: 'agent_loop:rides_unrecorded:count_7d{project="homelab"}'
            value: 1
    alert_rule_test:
      - eval_time: 12h
        alertname: AgentRidesUnrecorded
        exp_alerts: []
