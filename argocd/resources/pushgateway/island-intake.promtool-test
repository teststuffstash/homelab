# Behaviour fixture for IslandIntakeStale (FU-320, 2026-10-28) — island intake's own belt, deep-dig.promtool-test's
# three cases (same schedule shape, same 2 d threshold, same restart-gap bridge) on ONE island's series,
# then (d): the alert is PER ISLAND (homelab#3579) — the pushgateway's grouping label `island` is on
# every series, a fresh island never hides a silent one, and an island that never pushed is silent.
#
#   devbox run -- promtool test rules argocd/resources/pushgateway/island-intake.promtool-test
#   (in CI: `devbox run prometheus-rules-lint` runs every *.promtool-test under argocd/)
#
# The same three cases as retro-report.promtool-test, at this alert's 2-day threshold: a fresh
# run is quiet; a pushgateway wipe of a <2d-old run must NOT page (the restart-gap bridge —
# the `stale` marker, not `_`, is what reproduces the wipe, see that file's header); a run that
# genuinely stops happening fires after 2 d + the 6 h for-window.
#
# CLOCK: promtool's test clock starts at 0; a push VALUE is the epoch the run happened at, so
# "ran at test-hour H" is literally H*3600, and `time() - value` at any later eval is the run's age.
rule_files:
  - island-intake.promtool-rules

evaluation_interval: 1m

tests:
  # ── (a) a run 10 minutes ago is nowhere near stale ───────────────────────────────────────────
  - interval: 1m
    name: "(a) a run pushed 10 minutes ago stays quiet"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="gateway"}'
        values: "0+0x30"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "0+0x30"
    alert_rule_test:
      - eval_time: 10m
        alertname: IslandIntakeStale
        exp_alerts: []

  # ── (b) THE RESTART GAP — a wipe of a 20h-old run must not page ──────────────────────────────
  # A run lands at test-hour 40 (value 144000) and the gateway is wiped two hours later (`stale`
  # at hour 42, nothing pushed again). At hour 60 the real run is 20 h old — well under 2 d — and
  # the bridge must read straight through the wipe: `max_over_time(...[8d])` still returns the
  # hour-40 push. (The alert carried `or vector(0)` until homelab#3579 — an absent series then read
  # as epoch 0 and fired; per island an absent series is silent, so this case now pins that the
  # bridge keeps the REAL age across the wipe: case (b2) below is the same wipe aged past 2 d.)
  - interval: 1h
    name: "(b) a pushgateway wipe of a <2d-old run must not page"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="gateway"}'
        values: "_x40 144000 stale"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "_x40 144000 stale"
    alert_rule_test:
      - eval_time: 50h
        alertname: IslandIntakeStale
        exp_alerts: []
      - eval_time: 60h
        alertname: IslandIntakeStale
        exp_alerts: []
      # (b2) the wiped island is NOT forgotten: at hour 96 the hour-40 run is 56 h old (past 2 d
      # since hour 88, `for: 6h` served at hour 94) and nothing was pushed since the wipe — it fires
      # from the bridged value. Without `max_over_time(...[8d])` the series is absent and it is silent.
      - eval_time: 96h
        alertname: IslandIntakeStale
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
              island: gateway
            exp_annotations:
              summary: "Island intake has not run for the gateway island in >2 days — its findings, issues and waits are not being admitted"
              description: "The daily 05:00Z island-intake CronWorkflow (ns agent-coordinator) holds a sitting per island; the gateway island's has not pushed a run in over 2 days. Its dig findings, unruled issues and waits stay unread until it does. Check: argo -n agent-coordinator cron get island-intake and the newest island-intake-* workflow (the `sitting` step of that island, or a walk that ended before reaching it); re-fire that island via: argo -n agent-coordinator submit --from cronworkflow/island-intake -p island=gateway. Brief: islands/intake/rules/intake.md; the island list: islands/intake/scripts/intake-select.sh --list-islands."

  # ── (c) a run that genuinely stops — fires after 2 d + for:6h ────────────────────────────────
  - interval: 1h
    name: "(c) a continuously-present run ages past 2d and fires after for:6h"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="gateway"}'
        values: "0+0x60"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "0+0x60"
    alert_rule_test:
      - eval_time: 47h
        alertname: IslandIntakeStale
        exp_alerts: []
      # 48h is when the condition turns true; `for: 6h` holds it pending here
      - eval_time: 53h
        alertname: IslandIntakeStale
        exp_alerts: []
      - eval_time: 55h
        alertname: IslandIntakeStale
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
              island: gateway
            exp_annotations:
              summary: "Island intake has not run for the gateway island in >2 days — its findings, issues and waits are not being admitted"
              description: "The daily 05:00Z island-intake CronWorkflow (ns agent-coordinator) holds a sitting per island; the gateway island's has not pushed a run in over 2 days. Its dig findings, unruled issues and waits stay unread until it does. Check: argo -n agent-coordinator cron get island-intake and the newest island-intake-* workflow (the `sitting` step of that island, or a walk that ended before reaching it); re-fire that island via: argo -n agent-coordinator submit --from cronworkflow/island-intake -p island=gateway. Brief: islands/intake/rules/intake.md; the island list: islands/intake/scripts/intake-select.sh --list-islands."

  # ── (d) PER ISLAND — a fresh island does not hide a silent one; a never-seen one is silent ───
  # gateway pushes every hour (value = the hour's epoch, so its age is always 0). scan ran once at
  # test-hour 0 (value 0) and the pushgateway keeps serving that push: at hour 78 its run is 3 d 6 h
  # old — past 2 d since hour 48, past `for: 6h` since hour 54. launch never pushed the series.
  # The old `max(…)` over all islands read gateway's fresh push and stayed quiet at every eval here.
  # exp_alerts is the WHOLE set: exactly one alert, scan's.
  - interval: 1h
    name: "(d) gateway fresh, scan last seen 3 days ago (fires as island=scan), launch never seen (silent)"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="gateway"}'
        values: "0+3600x90"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "0+0x90"
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="scan"}'
        values: "0+0x90"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="scan"}'
        values: "0+0x90"
    alert_rule_test:
      # 47h: scan's run is under 2 d old — nobody fires
      - eval_time: 47h
        alertname: IslandIntakeStale
        exp_alerts: []
      - eval_time: 78h
        alertname: IslandIntakeStale
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
              island: scan
            exp_annotations:
              summary: "Island intake has not run for the scan island in >2 days — its findings, issues and waits are not being admitted"
              description: "The daily 05:00Z island-intake CronWorkflow (ns agent-coordinator) holds a sitting per island; the scan island's has not pushed a run in over 2 days. Its dig findings, unruled issues and waits stay unread until it does. Check: argo -n agent-coordinator cron get island-intake and the newest island-intake-* workflow (the `sitting` step of that island, or a walk that ended before reaching it); re-fire that island via: argo -n agent-coordinator submit --from cronworkflow/island-intake -p island=scan. Brief: islands/intake/rules/intake.md; the island list: islands/intake/scripts/intake-select.sh --list-islands."

  # ── (f) AN ISLAND THAT LEFT THE LIST is not reported stale (the assembly review of #3574) ────
  # The Pushgateway serves scan's last run for good, so by age alone scan would fire from hour 54
  # for ever. The list step's gauge is the gate: every listed island carries the list run's epoch.
  # Day 0's list holds gateway and scan (value 0); from day 1 the list holds gateway only — the
  # replaced group no longer carries scan (`stale`), and gateway's value moves to that run's epoch.
  # scan's bridged listed value (0) is then older than the newest (86400, 172800, …): silent at
  # hour 78, where case (d) — scan still listed — fires. gateway is fresh throughout.
  - interval: 1h
    name: "(f) scan left the list on day 1: its old push is never reported stale"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="gateway"}'
        values: "0+3600x90"
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="scan"}'
        values: "0+0x90"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "0+0x23 86400+0x23 172800+0x23 259200+0x18"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="scan"}'
        values: "0+0x23 stale"
    alert_rule_test:
      - eval_time: 60h
        alertname: IslandIntakeStale
        exp_alerts: []
      - eval_time: 78h
        alertname: IslandIntakeStale
        exp_alerts: []
  # (f2) a name that was never listed (a mistyped `-p island=`): its push ages, nothing fires.
  - interval: 1h
    name: "(f2) a never-listed island name pushes a timestamp and is never reported stale"
    input_series:
      - series: 'island_intake_last_run_timestamp_seconds{job="island_intake", island="scna"}'
        values: "0+0x90"
      - series: 'island_intake_listed_timestamp_seconds{job="island_intake_list", island="gateway"}'
        values: "0+0x90"
    alert_rule_test:
      - eval_time: 78h
        alertname: IslandIntakeStale
        exp_alerts: []

  # ── (e) IslandIntakeClaimsUnread (homelab#3580) — the stack islands' source went unread ───────
  # The list step pushes island_intake_claims_read_ok once per daily run (1 = the claims were read,
  # 0 = the read failed or answered no claim) and the Pushgateway serves that value until the next
  # run. Sampled every MINUTE, as a scrape sees it (the alert reads the instant value, with no
  # `max_over_time` bridge: at a 1 h sample interval the series would go stale between samples and
  # `for:` would never be served). A "day" is 1440 samples; `for: 2d` = 48 h at 0.
  #   (e1) every run reads the claims: 1 throughout — silent.
  - interval: 1m
    name: "(e1) the claims are read on every run: silent"
    input_series:
      - series: 'island_intake_claims_read_ok{job="island_intake_claims"}'
        values: "1+0x7200"
    alert_rule_test:
      - eval_time: 100h
        alertname: IslandIntakeClaimsUnread
        exp_alerts: []
  #   (e2) ONE failed day: 1 for hours 0–24, 0 for hours 24–48 (the failed run's value, served for a
  #   day), 1 again from hour 48 (the next run reads them). 0 never lasted 48 h — silent at the end of
  #   the failed day (47 h), right after the recovery (49 h) and two days on (96 h).
  - interval: 1m
    name: "(e2) one failed day, then a good run: silent"
    input_series:
      - series: 'island_intake_claims_read_ok{job="island_intake_claims"}'
        values: "1+0x1439 0+0x1439 1+0x4320"
    alert_rule_test:
      - eval_time: 47h
        alertname: IslandIntakeClaimsUnread
        exp_alerts: []
      - eval_time: 49h
        alertname: IslandIntakeClaimsUnread
        exp_alerts: []
      - eval_time: 96h
        alertname: IslandIntakeClaimsUnread
        exp_alerts: []
  #   (e3) TWO failed days: 1 for hours 0–24, 0 from hour 24 on (the runs of hours 24 and 48 both
  #   failed, and nothing has read the claims since). At hour 71 the gauge has been 0 for 47 h —
  #   pending; at hour 73 for 49 h — firing.
  - interval: 1m
    name: "(e3) two failed days: fires once the gauge has been 0 for 2 d"
    input_series:
      - series: 'island_intake_claims_read_ok{job="island_intake_claims"}'
        values: "1+0x1439 0+0x5760"
    alert_rule_test:
      - eval_time: 71h
        alertname: IslandIntakeClaimsUnread
        exp_alerts: []
      - eval_time: 73h
        alertname: IslandIntakeClaimsUnread
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
            exp_annotations:
              summary: "Island intake has not read the AgentStack claims for 2 days — no stack island is getting a sitting"
              description: "The daily 05:00Z island-intake CronWorkflow (ns agent-coordinator) reads the live AgentStack claims in its list step to find the stack islands (repos[].intake.facts). That read has failed or answered no claim on every run for 2 days: the platform islands are still walked, every stack island is skipped. Check the `islands` step's log of the newest island-intake-* workflow (the line `island-intake: claims read FAILED — stack islands not walked` and the one after it), and: kubectl auth can-i list agentstacks.platform.teststuff.net --as=system:serviceaccount:agent-coordinator:island-intake (the rule is on ClusterRole island-intake-read, agents/coordinator/rbac.yaml). Reader: islands/intake/scripts/claims-read.sh."

  # ── (g) IntakeExperimentOverdue / IntakeExperimentReadStale (homelab#3604) ────────────────────
  # The experiment read pushes island_intake_experiments_oldest_overdue_seconds (now − the bound of the
  # oldest experiment still open past it; 0 when none) and ..._last_run_timestamp_seconds once per run,
  # job island_intake_experiments. Sampled every MINUTE, as a scrape sees it (an hourly series goes stale between samples and `for:` is never served); "ran at test-hour H" is H*3600.
  #   (g1) quiet: a run every day, nothing overdue — silent at every check.
  - interval: 1m
    name: "(g1) a daily read with nothing overdue stays quiet"
    input_series:
      - series: 'island_intake_experiments_oldest_overdue_seconds{job="island_intake_experiments"}'
        values: "0+0x7200"
      - series: 'island_intake_experiments_last_run_timestamp_seconds{job="island_intake_experiments"}'
        values: "0+0x1439 86400+0x1439 172800+0x1439 259200+0x1439 345600+0x1439"
    alert_rule_test:
      - eval_time: 30h
        alertname: IntakeExperimentOverdue
        exp_alerts: []
      - eval_time: 100h
        alertname: IntakeExperimentOverdue
        exp_alerts: []
      - eval_time: 100h
        alertname: IntakeExperimentReadStale
        exp_alerts: []
  #   (g2) an experiment 1 day overdue (86400) is below the 2 d line; the value grows by an hour per hour,
  #   crosses 2 d (172800) at hour 48 and — `for: 1h` — fires from hour 49.
  - interval: 1m
    name: "(g2) an experiment left open past 2 days over its bound fires; one day over does not"
    input_series:
      - series: 'island_intake_experiments_oldest_overdue_seconds{job="island_intake_experiments"}'
        values: "0+60x7200"
      - series: 'island_intake_experiments_last_run_timestamp_seconds{job="island_intake_experiments"}'
        values: "0+60x7200"
    alert_rule_test:
      - eval_time: 24h
        alertname: IntakeExperimentOverdue
        exp_alerts: []
      - eval_time: 48h
        alertname: IntakeExperimentOverdue
        exp_alerts: []
      - eval_time: 50h
        alertname: IntakeExperimentOverdue
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
            exp_annotations:
              summary: "An intake experiment is still open more than 2 days past its bound \u2014 its verdict was not written"
              description: "An issue labelled experiment/open is still undecided two days after its window ended. The scheduled island-intake CronWorkflow (ns agent-coordinator) reads every such issue in its `experiments` step, before the sittings. Check that step's log in the newest island-intake-* workflow (a Prometheus or GitHub read that failed, a GitHub write or a report upload that failed \u2014 the issue keeps experiment/open until one run finishes it) and read by hand: bash islands/intake/scripts/experiment-read.sh --dry-run. Reader: islands/intake/scripts/experiment-read.sh."
  #   (g3) the read stops: last run at hour 0, nothing pushed since. Fires after 2 d + `for: 6h`.
  - interval: 1m
    name: "(g3) a read that last ran 2 days ago fires IntakeExperimentReadStale after for:6h"
    input_series:
      - series: 'island_intake_experiments_last_run_timestamp_seconds{job="island_intake_experiments"}'
        values: "0+0x7200"
    alert_rule_test:
      - eval_time: 47h
        alertname: IntakeExperimentReadStale
        exp_alerts: []
      - eval_time: 53h
        alertname: IntakeExperimentReadStale
        exp_alerts: []
      - eval_time: 55h
        alertname: IntakeExperimentReadStale
        exp_alerts:
          - exp_labels:
              severity: warning
              platform_machinery: "true"
              triage: none
            exp_annotations:
              summary: "The intake experiment read has not run for more than 2 days \u2014 open experiments are not being decided"
              description: "The daily 05:00Z island-intake CronWorkflow (ns agent-coordinator) runs the experiment read as its first step; no run has pushed island_intake_experiments_last_run_timestamp_seconds in over 2 days. Check: argo -n agent-coordinator cron get island-intake and the `experiments` step of the newest island-intake-* workflow (a clone or devbox install that failed, a pod that never started). Reader: islands/intake/scripts/experiment-read.sh."
