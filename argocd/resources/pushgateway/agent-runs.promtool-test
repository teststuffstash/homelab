# Behaviour fixture for the agent-runs alerts (FU-158 behaviour half, homelab#288).
#
#   devbox run -- promtool test rules argocd/resources/pushgateway/agent-runs.promtool-test
#
# `devbox run prometheus-rules-lint` checks that every alert PARSES; this checks that these four
# fire on the shapes they were written for and stay quiet on the shapes that look like them —
# (RetroReportOverdue moved to its own retro-report.promtool-rules/-test, homelab#591 — see this
# directory's agent-runs.promtool-rules header) —
# above all the PUSHGATEWAY-RESIDUE class, where a rule that merely parses is exactly how
# sleep-tracking#20's 3-day-old auth-storm kept AgentRunInfraDeathBurst ringing for two days
# (FU-021, found 2026-07-12). It IS wired into CI as of 2026-08-11: the codeowner's follow-on
# landed, and `devbox run prometheus-rules-lint` (which `.github/workflows/ci.yaml` runs) now
# executes `promtool test rules` over every `*.promtool-test` under `argocd/`. A red fixture here
# is a red required check, not a note to whoever remembers to run it by hand.
#
# Named .promtool-test, not .yaml: manifest-lint kubeconforms every *.yaml under argocd/resources,
# and a non-manifest there would fail it.
#
# CLOCK: promtool's test clock starts at 0, so `time()` is small. Two consequences are used
# deliberately below: (1) a push AT the start of the test is `push_time_seconds 0`, and (2) a
# STALE residue pushed three days before the test window is `push_time_seconds -259200`. Negative
# is not a trick — it is "3 days before t=0" on this clock, and only the difference is asserted.
#
# LABELS are the real pushed sets read off the live series on 2026-08-11, minus the scrape target
# labels (container/endpoint/namespace/pod/service on the pushgateway itself), which no expr here
# reads. The join keys (project, issue, role, round) and every matcher label are complete.
rule_files:
  - agent-runs.promtool-rules

evaluation_interval: 1m

tests:
  # ── AgentRunNegativeCost — a data-quality bug, no `for:`, fires on the first evaluation ──────
  # The positive-cost run in the same push window is the discriminator: this must be a sign test,
  # not a "cost looks odd" test.
  - interval: 1m
    name: a negative cost fires immediately; a normal one never does
    input_series:
      - series: 'agent_run_cost_usd{exit_status="failed",harness="goose",issue="30",job="agent_run",model="anthropic/claude-haiku-4.5",node="wk-metal-03",project="oracle-fleet",role="worker",round="2"}'
        values: "-0.42+0x30"
      - series: 'agent_run_cost_usd{exit_status="clean",harness="goose",issue="31",job="agent_run",model="anthropic/claude-haiku-4.5",node="wk-metal-01",project="oracle-fleet",role="worker",round="1"}'
        values: "0.0356+0x30"
    alert_rule_test:
      - eval_time: 1m
        alertname: AgentRunNegativeCost
        exp_alerts:
          - exp_labels:
              severity: warning
              exit_status: failed
              harness: goose
              issue: "30"
              job: agent_run
              model: anthropic/claude-haiku-4.5
              node: wk-metal-03
              project: oracle-fleet
              role: worker
              round: "2"
            exp_annotations:
              summary: "Agent run reported NEGATIVE cost (oracle-fleet issue 30)"
              description: "agent_run_cost_usd=-0.42 for pod-pushed run (model anthropic/claude-haiku-4.5, round 2) — a probe failed into a value somewhere in the cost pipeline. See agent-runtime#12 for the class."

  # ── AgentRunInfraDeathBurst — three FRESH walls on one project ───────────────────────────────
  # The meta-2 pattern as an alert. Note the second half of the assertion: the same three groups,
  # untouched, stop counting once their pushes age past an hour. Pushgateway keeps serving them
  # forever, so "stops counting" is a property of the expr, not of the data disappearing.
  - interval: 1m
    name: three fresh non-clean runs fire, and stop counting an hour after the push
    input_series:
      - series: 'agent_run_total{exit_status="auth-storm",harness="goose",issue="101",job="agent_run",model="qwen/qwen3-max",node="wk-metal-01",project="oracle-fleet",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="no-artifact",harness="goose",issue="102",job="agent_run",model="qwen/qwen3-max",node="wk-metal-02",project="oracle-fleet",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="harness-death",harness="goose",issue="103",job="agent_run",model="qwen/qwen3-max",node="wk-metal-03",project="oracle-fleet",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'push_time_seconds{issue="101",job="agent_run",project="oracle-fleet",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="102",job="agent_run",project="oracle-fleet",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="103",job="agent_run",project="oracle-fleet",role="worker",round="1"}'
        values: "0+0x120"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts:
          - exp_labels:
              severity: warning
              project: oracle-fleet
            exp_annotations:
              summary: "3+ non-clean agent runs in 1h on oracle-fleet"
              description: "Repeated infra-class terminals (auth-storm/no-artifact/harness-death/…) — check the strike comments on the active issue before more budget burns. Deliberate stops (exit_status=blocked-deliberate) and model-scout canary rides (issue=scout-*) are excluded by design and cannot raise this."
      # 70m after the pushes: same series, same values, no alert — the freshness join is what
      # makes this alert a rate rather than a permanent statement about the past.
      - eval_time: 70m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []

  # ── AgentRunInfraDeathBurst — the FU-021 regression, as a permanent test ─────────────────────
  # Three non-clean groups pushed THREE DAYS before the window. The pre-FU-021 `count_over_time`
  # form counted scrapes of these stale gauges and rang for two days on sleep-tracking#20; the
  # push-freshness form must never look at them at all.
  - interval: 1m
    name: three-day-old pushgateway residue never fires (FU-021)
    input_series:
      - series: 'agent_run_total{exit_status="auth-storm",harness="goose",issue="20",job="agent_run",model="qwen/qwen3-max",node="wk-01",project="sleep-tracking",role="worker",round="1"}'
        values: "1+0x180"
      - series: 'agent_run_total{exit_status="auth-storm",harness="goose",issue="21",job="agent_run",model="qwen/qwen3-max",node="wk-01",project="sleep-tracking",role="worker",round="1"}'
        values: "1+0x180"
      - series: 'agent_run_total{exit_status="auth-storm",harness="goose",issue="22",job="agent_run",model="qwen/qwen3-max",node="wk-01",project="sleep-tracking",role="worker",round="1"}'
        values: "1+0x180"
      - series: 'push_time_seconds{issue="20",job="agent_run",project="sleep-tracking",role="worker",round="1"}'
        values: "-259200+0x180"
      - series: 'push_time_seconds{issue="21",job="agent_run",project="sleep-tracking",role="worker",round="1"}'
        values: "-259200+0x180"
      - series: 'push_time_seconds{issue="22",job="agent_run",project="sleep-tracking",role="worker",round="1"}'
        values: "-259200+0x180"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []
      - eval_time: 180m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []

  # ── AgentRunInfraDeathBurst — model-scout canaries stay out (homelab#235) ────────────────────
  # A scout tick runs MAX_CANARIES=3 trivial probes against brand-new models and treats their
  # deaths as expected. Three dead canaries plus one genuine failure is ONE real datum, not a
  # burst — and the `issue!~"scout-.*"` matcher must count exactly the genuine one.
  - interval: 1m
    name: three dead canaries plus one real failure do not make a burst
    input_series:
      - series: 'agent_run_total{exit_status="harness-death",harness="goose",issue="scout-x-ai-grok-5",job="agent_run",model="x-ai/grok-5",node="wk-metal-04",project="openrouter-operator",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="no-artifact",harness="goose",issue="scout-moonshot-kimi-k3",job="agent_run",model="moonshotai/kimi-k3",node="wk-metal-04",project="openrouter-operator",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="budget-403",harness="goose",issue="scout-deepseek-v4",job="agent_run",model="deepseek/deepseek-v4",node="wk-metal-04",project="openrouter-operator",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="failed",harness="goose",issue="44",job="agent_run",model="qwen/qwen3-max",node="wk-metal-04",project="openrouter-operator",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'push_time_seconds{issue="scout-x-ai-grok-5",job="agent_run",project="openrouter-operator",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="scout-moonshot-kimi-k3",job="agent_run",project="openrouter-operator",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="scout-deepseek-v4",job="agent_run",project="openrouter-operator",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="44",job="agent_run",project="openrouter-operator",role="worker",round="1"}'
        values: "0+0x120"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []

  # ── AgentRunInfraDeathBurst — clean and ci-failed are not walls ──────────────────────────────
  # `ci-failed` is the loop WORKING (the gate caught something); six of them in ten minutes is a
  # busy afternoon, not an outage.
  - interval: 1m
    name: clean and ci-failed terminals never raise the burst
    input_series:
      - series: 'agent_run_total{exit_status="clean",harness="goose",issue="60",job="agent_run",model="deepseek/deepseek-v4-flash",node="wk-01",project="circles",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="clean",harness="goose",issue="61",job="agent_run",model="deepseek/deepseek-v4-flash",node="wk-01",project="circles",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="ci-failed",harness="goose",issue="62",job="agent_run",model="deepseek/deepseek-v4-flash",node="wk-01",project="circles",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="ci-failed",harness="goose",issue="63",job="agent_run",model="deepseek/deepseek-v4-flash",node="wk-01",project="circles",role="worker",round="2"}'
        values: "1+0x120"
      - series: 'push_time_seconds{issue="60",job="agent_run",project="circles",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="61",job="agent_run",project="circles",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="62",job="agent_run",project="circles",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="63",job="agent_run",project="circles",role="worker",round="2"}'
        values: "0+0x120"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []

  # ── AgentRunInfraDeathBurst — a deliberate stop is not a death (homelab#314) ─────────────────
  # `blocked-deliberate` is a live exit_status (4 of them in the pushgateway on 2026-08-11) and it
  # is the OPPOSITE of an infra death: the agent read the issue, judged it unworkable, emitted its
  # structured stop report and exited 0 — "a DECISION, not a death" (agent-finalize `classify()`).
  # Until homelab#314 the `exit_status!~"clean|ci-failed"` denylist counted it anyway, so three
  # deliberate blocks on one project inside an hour raised a burst whose description says
  # "auth-storm/no-artifact/harness-death/…". This fixture was written by homelab#288 pinning that
  # BUG (exp_alerts: one sleep-iac alert) with a note that fixing it flips the expectation in the
  # same commit; #314 is that commit and this is that flip. It is now an ordinary regression test:
  # if the matcher ever loses `blocked-deliberate`, this goes red.
  - interval: 1m
    name: three blocked-deliberate terminals never raise the burst (homelab#314)
    input_series:
      - series: 'agent_run_total{exit_status="blocked-deliberate",harness="goose",issue="70",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="blocked-deliberate",harness="goose",issue="71",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="blocked-deliberate",harness="goose",issue="72",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'push_time_seconds{issue="70",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="71",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="72",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []

  # ── AgentRunInfraDeathBurst — the MIXED shape, which is the one production actually makes ────
  # homelab#314's real damage: not three deliberate blocks in a row (rare), but a deliberate block
  # padding two genuine walls up to the `>= 3` line. Two infra deaths on a project IS bad luck by
  # this alert's own definition, so the burst must stay silent — the deliberate one must not be
  # allowed to cast the deciding vote. `failed` is in the same input on purpose as the other half
  # of the classification: it is neither infra nor deliberate (nonzero-exit / no-output), so it
  # STAYS counted, and with it the count is 3 and the alert DOES fire at the second assertion.
  - interval: 1m
    name: two infra deaths plus a deliberate block stay under the threshold; a `failed` tips it
    input_series:
      - series: 'agent_run_total{exit_status="harness-death",harness="goose",issue="80",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="auth-storm",harness="goose",issue="81",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      - series: 'agent_run_total{exit_status="blocked-deliberate",harness="goose",issue="82",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "1+0x120"
      # pushed 20m into the window, so the first assertion sees two walls + one deliberate block
      # and the second sees the `failed` run join them
      - series: 'agent_run_total{exit_status="failed",harness="goose",issue="83",job="agent_run",model="qwen/qwen3-max",node="wk-02",project="sleep-iac",role="worker",round="1"}'
        values: "_x20 1+0x100"
      - series: 'push_time_seconds{issue="80",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="81",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="82",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "0+0x120"
      - series: 'push_time_seconds{issue="83",job="agent_run",project="sleep-iac",role="worker",round="1"}'
        values: "_x20 1200+0x100"
    alert_rule_test:
      - eval_time: 10m
        alertname: AgentRunInfraDeathBurst
        exp_alerts: []
      - eval_time: 25m
        alertname: AgentRunInfraDeathBurst
        exp_alerts:
          - exp_labels:
              severity: warning
              project: sleep-iac
            exp_annotations:
              summary: "3+ non-clean agent runs in 1h on sleep-iac"
              description: "Repeated infra-class terminals (auth-storm/no-artifact/harness-death/…) — check the strike comments on the active issue before more budget burns. Deliberate stops (exit_status=blocked-deliberate) and model-scout canary rides (issue=scout-*) are excluded by design and cannot raise this."

  # ── AgentEventInfraSpinning — the 2026-08-05 Sensor spin, and the pods that must stay quiet ──
  # Measured baselines (live, 2026-08-11): the four Argo Events infra pods idle at 0.1-5.3
  # millicores; the 2026-08-05 fault sat at 1887m. The spinning series below runs at 1.887 cores
  # and the idle one at 5m, i.e. the real separation the 0.5-core threshold sits inside.
  # The workflow-controller series is the matcher's job: it burns 2 cores here and is not a
  # sensor/eventsource, so it must never appear.
  - interval: 1m
    name: a sensor spin fires at 15m; idle sensors and a busy non-sensor stay silent
    input_series:
      # 5.3 millicores for half an hour, then the leaked-goroutine spin at 1.887 cores
      - series: 'container_cpu_usage_seconds_total{container="main",namespace="agent-coordinator",pod="coordinator-sensor-kfmcv-7864c69448-zcwml"}'
        values: "0+0.3x30 9.3+113.2x29"
      - series: 'container_cpu_usage_seconds_total{container="main",namespace="agent-coordinator",pod="review-sensor-h5j67-6dd767d4b9-mzn8x"}'
        values: "0+0.3x120"
      - series: 'container_cpu_usage_seconds_total{container="main",namespace="agent-coordinator",pod="agent-loop-eventsource-npcgm-6f85454985-wk9s6"}'
        values: "0+0.006x120"
      - series: 'container_cpu_usage_seconds_total{container="controller",namespace="agent-coordinator",pod="argo-workflows-workflow-controller-7d6c9f8b45-q2xnm"}'
        values: "0+120x120"
    alert_rule_test:
      # still idle
      - eval_time: 30m
        alertname: AgentEventInfraSpinning
        exp_alerts: []
      # spinning since ~31m — inside `for: 15m`, so pending, not firing
      - eval_time: 40m
        alertname: AgentEventInfraSpinning
        exp_alerts: []
      - eval_time: 50m
        alertname: AgentEventInfraSpinning
        exp_alerts: &spin_alert
          - exp_labels:
              severity: warning
              pod: coordinator-sensor-kfmcv-7864c69448-zcwml
            exp_annotations:
              summary: "Argo Events infra pod coordinator-sensor-kfmcv-7864c69448-zcwml is burning CPU (idle baseline is ~5m)"
              description: "coordinator-sensor-kfmcv-7864c69448-zcwml in agent-coordinator has held >0.5 cores for 15m; these pods idle near zero, so this is a spin, not load. THE LOG MAY BE COMPLETELY EMPTY — the 2026-08-05 12:48 recurrence logged nothing at all while burning 1692m, so an empty log is NOT evidence the pod is fine. If it does log, look for `AckSync() on message: nats: timeout` with one event id retriggering (a redelivery loop, whose CPU outlives it). Fix: delete the pod, the Deployment recreates it; then check for spurious workflows it submitted (`kubectl -n agent-coordinator get wf --sort-by=.metadata.creationTimestamp`). It RECURS — homelab#103, a restart is palliative."
      # ⚠ THE DOCUMENTED TAIL, asserted: the pod is deleted at 60m and the alert keeps naming it
      # while its samples are still inside the [5m] rate window. The rule's own comment warns
      # about this ("expect a ~5-10 min tail naming the DELETED pod"); here it is, executed.
      - eval_time: 63m
        alertname: AgentEventInfraSpinning
        exp_alerts: *spin_alert
      # …and then it goes on its own, with no staleness handling anywhere
      - eval_time: 67m
        alertname: AgentEventInfraSpinning
        exp_alerts: []

  # ── AgentRunPhaseSlow — the launcher's phases doubled, and the two phases that must stay quiet ─
  # FU-160 / homelab#287. The alert has no hard-coded seconds threshold — it ships in the same PR
  # as its emitter, so any number would have been invented — and instead splits the SAME metric on
  # push freshness: the last hour of rides against everything older still in the gateway. That
  # makes three things testable that prose could only promise, and all three are asserted here.
  #
  # THE FLOOR IS THE POINT OF THIS FIXTURE. `dispatch-gates` below runs 6s at baseline and 13s in
  # the last hour — a 2.2× ratio, comfortably past the alert's `> 2 *` arm, and utterly
  # meaningless: seven seconds. Without the `> 60` floor this ride set would page someone about a
  # phase that costs less than the alert's own evaluation interval. It is in the same input as the
  # real regression so that removing the floor turns ONE test red with TWO alerts, not a test
  # nobody wrote.
  - interval: 1m
    name: pod-spinup doubles and fires at 30m; a 6s→13s dispatch-gates stays under the floor
    input_series:
      # ── BASELINE: four rides pushed 2h before the test clock, so `time() - push_time >= 3600`
      # holds at every eval below. Negative push times are this clock's way of saying "before
      # t=0" — the same device the FU-021 residue test uses, and only the difference is read.
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="90",round="1",role="worker",phase="pod-spinup"}'
        values: "30x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="91",round="1",role="worker",phase="pod-spinup"}'
        values: "35x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="92",round="1",role="worker",phase="pod-spinup"}'
        values: "35x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="93",round="1",role="worker",phase="pod-spinup"}'
        values: "40x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="90",round="1",role="worker",phase="dispatch-gates"}'
        values: "5x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="91",round="1",role="worker",phase="dispatch-gates"}'
        values: "6x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="92",round="1",role="worker",phase="dispatch-gates"}'
        values: "6x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="93",round="1",role="worker",phase="dispatch-gates"}'
        values: "7x90"
      - series: 'push_time_seconds{job="agent_run_phase",project="oracle-fleet",issue="90",round="1",role="worker"}'
        values: "-7200x90"
      - series: 'push_time_seconds{job="agent_run_phase",project="oracle-fleet",issue="91",round="1",role="worker"}'
        values: "-7200x90"
      - series: 'push_time_seconds{job="agent_run_phase",project="oracle-fleet",issue="92",round="1",role="worker"}'
        values: "-7200x90"
      - series: 'push_time_seconds{job="agent_run_phase",project="oracle-fleet",issue="93",round="1",role="worker"}'
        values: "-7200x90"
      # ── THE LAST HOUR: three rides pushed at t=0. pod-spinup p50 = 300 (baseline 35 → 8.6×);
      # dispatch-gates p50 = 13 (baseline 6 → 2.2×, and 13s is nothing).
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="101",round="1",role="worker",phase="pod-spinup"}'
        values: "300x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="102",round="1",role="worker",phase="pod-spinup"}'
        values: "300x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="103",round="1",role="worker",phase="pod-spinup"}'
        values: "320x90"
      - series: 'agent_run_phase_seconds{project="oracle-fleet",issue="101",round="1",role="worker",phase="dispatch-gates"}'
