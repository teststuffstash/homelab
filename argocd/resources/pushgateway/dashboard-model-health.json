{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "agent-issue drill-down",
      "type": "link",
      "url": "/d/agent-issue",
      "targetBlank": false
    },
    {
      "title": "goals registry",
      "type": "link",
      "url": "/d/agent-goals",
      "targetBlank": false
