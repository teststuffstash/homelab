# DispatchClauseStorm, lifted VERBATIM out of prometheusrule.yaml (annotations stripped — the
# manifest is their one home) — the rules file dispatch-clause-storm.promtool-test loads. Same
# shape and reasons as dispatch-cron-woken.promtool-rules (upstream-format `groups:`, not a
# manifest, named .promtool-rules so manifest-lint skips it).
#
# DRIFT-PINNED, both directions, by `devbox run prometheus-rules-lint`: expr and `for` must equal
# the CR's. Re-copy after every expr edit:
#
#   yq -o=json '{"groups": [{"name": "dispatch-clause-storm", "rules": [.spec.groups[].rules[] | select(.alert == "DispatchClauseStorm") | del(.annotations)]}]}' argocd/resources/pushgateway/prometheusrule.yaml | yq -P '.'
groups:
  - name: dispatch-clause-storm
    rules:
      - alert: DispatchClauseStorm
        expr: (sum by (project, clause, base) (changes(agent_dispatch_wake_clause_timestamp{clause="goal-checkpoint"}[1h])) >= 6) or (sum by (project, clause, base) (changes(agent_dispatch_wake_clause_timestamp{clause="merged-closeout"}[1h])) >= 16)
        for: 15m
        labels:
          severity: warning
          platform_machinery: "true"
          triage: dig
