# HAND COPY of the control-plane-health group in prometheusrule.yaml (this dir) — the drift pin in
# scripts/prometheus-rules-lint.sh asserts expr+for equality per alert name against the CR.
# Re-render with:  devbox run -- yq '.spec.groups[] | select(.name == "control-plane-health")' prometheusrule.yaml
# Loaded by control-plane-health.promtool-test.
groups:
  - name: control-plane-health
    rules:
      - alert: ControlPlaneNodeMemoryLow
        expr: |
          (
            node_memory_MemAvailable_bytes{job="node-exporter"} / node_memory_MemTotal_bytes{job="node-exporter"} < 0.35
          )
            * on (instance) group_left (node)
              label_replace(max by (internal_ip, node) (kube_node_info{job="kube-state-metrics"}), "instance", "$1:9100", "internal_ip", "(.*)")
            and on (node) kube_node_role{job="kube-state-metrics", role="control-plane"}
        for: 30m
        labels: { severity: warning, triage: dig }
        annotations:
          summary: "control plane {{ $labels.node }} has {{ $value | humanizePercentage }} of its memory available (30 m under 35 %)"
      - alert: ControlPlaneComponentRestarted
        expr: |
          increase(kube_pod_container_status_restarts_total{job="kube-state-metrics", namespace="kube-system", container=~"kube-apiserver|kube-controller-manager|kube-scheduler"}[30m]) > 0
        for: 0m
        labels: { severity: warning, triage: now }
        annotations:
          summary: "{{ $labels.pod }} restarted {{ $value | printf \"%.0f\" }}× in 30 m — a control-plane member went dark"
