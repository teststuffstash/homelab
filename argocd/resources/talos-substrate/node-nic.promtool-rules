# HAND COPY of the node-nic group in prometheusrule.yaml (this dir) — the drift pin in
# scripts/prometheus-rules-lint.sh asserts expr+for equality per alert name against the CR.
# Re-render with:  devbox run -- yq '.spec.groups[] | select(.name == "node-nic")' prometheusrule.yaml
# Loaded by node-nic.promtool-test.
groups:
  - name: node-nic
    rules:
      - alert: NodeNetworkReceiveDropStorm
        expr: |
          rate(node_network_receive_drop_total{device=~"en.*|eth.*|nic.*"}[30m]) > 1000
        for: 15m
        labels: { severity: warning, triage: dig }
      - alert: NodeLinkSpeedDegraded
        expr: |
          node_network_speed_bytes{device=~"en.*|eth.*|nic.*"} > 0 < 125000000
            and on (instance, device) node_network_carrier == 1
        for: 10m
        labels: { severity: warning, triage: none }
