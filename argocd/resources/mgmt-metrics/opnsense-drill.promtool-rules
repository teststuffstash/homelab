# The mgmt-opnsense-drill group, lifted VERBATIM out of opnsense-drill.yaml (annotations stripped —
# the manifest is their one home) — the rules file opnsense-drill.promtool-test loads.
# DRIFT-PINNED by `devbox run prometheus-rules-lint`. Re-copy after every expr edit:
#
#   yq -o=json '{"groups": [.spec.groups[] | .rules |= map(del(.annotations))]}' argocd/resources/mgmt-metrics/opnsense-drill.yaml | yq -P '.'
#
groups:
  - name: mgmt-opnsense-drill
    rules:
      - alert: MgmtOpnsenseDrillFailed
        expr: |
          mgmt_opnsense_drill_success == 0
        for: 5m
        labels:
          severity: warning
          triage: none
      - alert: MgmtOpnsenseDrillStale
        expr: |
          (time() - mgmt_opnsense_drill_last_run_timestamp_seconds) > 9 * 86400
        for: 1h
        labels:
          severity: warning
          triage: none
      - alert: MgmtOpnsenseDrillMetricsAbsent
        expr: |
          up{job="mgmt-node"} == 1
            unless on (instance) mgmt_opnsense_drill_last_run_timestamp_seconds
        for: 9d
        labels:
          severity: warning
          triage: none
      - alert: MgmtOpnsenseDrillScoreRegressed
        expr: |
          mgmt_opnsense_drill_realism_score > mgmt_opnsense_drill_realism_score_previous
        for: 5m
        labels:
          severity: warning
          triage: none
