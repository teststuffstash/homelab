# Behaviour fixture for the management box's belts (FU-252).
#
#   devbox run -- promtool test rules argocd/resources/mgmt-metrics/mgmt-metrics.promtool-test
#
# promtool's clock starts at 0, so a commit "at t=60" has timestamp 60 and time() is the test clock.
rule_files:
  - mgmt-metrics.promtool-rules

evaluation_interval: 1m

tests:
  # ── THE 2026-09-14..18 SHAPE: alive, correct, and saying no for days ──────────────────────────
  # The residue-age alert is github-exporter's (MgmtApplyResidueStanding); here the point is the
  # converse — a loop that is alive and refusing must NOT trip any box-side liveness belt.
  - interval: 5m
    name: "a standing refusal with a live loop trips none of the box-side belts"
    input_series:
      - series: 'mgmt_apply_unapplied_oldest_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "60x340"
      - series: 'mgmt_apply_refused{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x340"
      - series: 'mgmt_apply_last_ok_tick_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0+300x340"
      - series: 'up{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x340"
    alert_rule_test:
      - eval_time: 25h
        alertname: MgmtApplyLoopStale
        exp_alerts: []
      - eval_time: 25h
        alertname: MgmtApplyMetricsAbsent
        exp_alerts: []
      - eval_time: 25h
        alertname: MgmtBoxDown
        exp_alerts: []

  # ── the loop stops completing ticks ────────────────────────────────────────────────────────────
  - interval: 5m
    name: "a loop whose last ok tick stops advancing fires after an hour plus 15m"
    input_series:
      - series: 'mgmt_apply_last_ok_tick_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0+300x12 3600x30"
    alert_rule_test:
      - eval_time: 1h50m
        alertname: MgmtApplyLoopStale
        exp_alerts: []
      - eval_time: 2h20m
        alertname: MgmtApplyLoopStale
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}

  # ── scraped, but the loop's file is missing ────────────────────────────────────────────────────
  - interval: 1m
    name: "exporter up with no mgmt_apply series fires after 30m"
    input_series:
      - series: 'up{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x45"
    alert_rule_test:
      - eval_time: 25m
        alertname: MgmtApplyMetricsAbsent
        exp_alerts: []
      - eval_time: 40m
        alertname: MgmtApplyMetricsAbsent
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}

  # ── the post-apply health gate regressed after a Talos config apply ─────────────────────────────
  - interval: 1m
    name: "a regressed post-check fires after 5m; a clean one never does"
    input_series:
      - series: 'mgmt_apply_post_check_failed{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0x10 1x20 0x10"
      - series: 'mgmt_apply_post_check_failed{job="mgmt-node",instance="192.168.2.99:9100"}'
        values: "0x40"
    alert_rule_test:
      - eval_time: 10m
        alertname: MgmtApplyPostCheckFailed
        exp_alerts: []
      - eval_time: 14m
        alertname: MgmtApplyPostCheckFailed
        exp_alerts: []
      - eval_time: 20m
        alertname: MgmtApplyPostCheckFailed
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: now}
      - eval_time: 35m
        alertname: MgmtApplyPostCheckFailed
        exp_alerts: []

  # ── FU-301: a box helm apply STOPPED on its verdict (the marker gauge) ─────────────────────────
  # 0 for 10m, the marker for 20m (a human clears it), 0 again: fires once `for: 5m` has held, clears
  # when the marker goes. A box whose marker never rose stays quiet.
  - interval: 1m
    name: "a stopped helm apply fires after 5m and clears with the marker"
    input_series:
      - series: 'mgmt_apply_helm_stopped{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0x10 1x20 0x10"
      - series: 'mgmt_apply_helm_stopped{job="mgmt-node",instance="192.168.2.99:9100"}'
        values: "0x40"
    alert_rule_test:
      - eval_time: 10m
        alertname: MgmtHelmApplyStopped
        exp_alerts: []
      - eval_time: 14m
        alertname: MgmtHelmApplyStopped
        exp_alerts: []
      - eval_time: 20m
        alertname: MgmtHelmApplyStopped
        exp_alerts:
          - exp_labels: { severity: critical, job: mgmt-node, instance: "192.168.2.53:9100", triage: none }
      - eval_time: 38m
        alertname: MgmtHelmApplyStopped
        exp_alerts: []

  # ── FU-301: the second arm — the lease loop counts a box helm lease past its deadline every tick
  # (outcome forward_only; the counter rises by 1 per 5-min tick from t=10m). increase over 30m > 0 from
  # the first step, `for: 5m` → firing by t=16m. The other outcomes rising (a kps revert) never fire it.
  - interval: 1m
    name: "an expired box helm lease fires; a reverted kps lease does not"
    input_series:
      - series: 'mgmt_lease_revert_total{job="mgmt-node",instance="192.168.2.53:9100",outcome="forward_only"}'
        values: "0x10 1x4 2x5 3x5 4x5"
      - series: 'mgmt_lease_revert_total{job="mgmt-node",instance="192.168.2.98:9100",outcome="reverted"}'
        values: "0x10 1x4 2x5 3x5 4x5"
      - series: 'mgmt_apply_helm_stopped{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0x30"
    alert_rule_test:
      - eval_time: 9m
        alertname: MgmtHelmApplyStopped
        exp_alerts: []
      - eval_time: 18m
        alertname: MgmtHelmApplyStopped
        exp_alerts:
          - exp_labels: { severity: critical, job: mgmt-node, instance: "192.168.2.53:9100", outcome: forward_only, triage: none }

  # ── S9 #1988: an apply errors on a provider version no apply had run ───────────────────────────
  # The box publishes the series only while the refusal stands (absent otherwise): a blip shorter
  # than `for` stays quiet; a standing one fires with the provider attribution the revert chain keys on.
  - interval: 1m
    name: "an apply error on an unexercised provider fires after 5m, with its attribution"
    input_series:
      - series: 'mgmt_apply_errored_unexercised{job="mgmt-node",instance="192.168.2.53:9100",root="main",provider="kubernetes",exercised="2.38.0",locked="3.2.1"}'
        values: "_x5 1x3 _x5 1x20"
    alert_rule_test:
      - eval_time: 8m
        alertname: MgmtApplyErroredOnNewProvider
        exp_alerts: []
      - eval_time: 17m
        alertname: MgmtApplyErroredOnNewProvider
        exp_alerts: []
      - eval_time: 25m
        alertname: MgmtApplyErroredOnNewProvider
        exp_alerts:
          - exp_labels: { severity: warning, triage: now, job: mgmt-node, instance: "192.168.2.53:9100", root: main, provider: kubernetes, exercised: "2.38.0", locked: "3.2.1" }

  # ── FU-300: a declared window holds the apply loop ────────────────────────────────────────────
  # A 3 h window (seat-window's default) deferring and then closing never fires; a forgotten one
  # (8 h of deferral) fires after 6 h — and the converse: a deferring loop is a LIVE loop, so the
  # stale belt stays quiet throughout.
  - interval: 5m
    name: "a deferral fires after 6h; a default-length window never does"
    input_series:
      - series: 'mgmt_apply_deferred_window{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0x12 1x36 0x12 1x96"
      - series: 'mgmt_apply_last_ok_tick_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0+300x156"
    alert_rule_test:
      - eval_time: 4h
        alertname: MgmtApplyDeferredByWindow
        exp_alerts: []
      - eval_time: 11h
        alertname: MgmtApplyDeferredByWindow
        exp_alerts: []
      - eval_time: 12h
        alertname: MgmtApplyDeferredByWindow
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}
      - eval_time: 12h
        alertname: MgmtApplyLoopStale
        exp_alerts: []

  # ── FU-302: the box verdict holds the apply loop ───────────────────────────────────────────────
  # A 1 h DOWN (a real outage, its own alerts carry it) never fires; a 3 h deferral (from 3h15) fires 2 h in;
  # the deferring loop is LIVE, so the stale belt stays quiet.
  - interval: 5m
    name: "a verdict deferral fires after 2h; a 1h one never does"
    input_series:
      - series: 'mgmt_apply_deferred_verdict{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0x12 1x12 0x12 1x36"
      - series: 'mgmt_apply_last_ok_tick_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0+300x72"
    alert_rule_test:
      - eval_time: 2h
        alertname: MgmtApplyDeferredByVerdict
        exp_alerts: []
      - eval_time: 5h10m
        alertname: MgmtApplyDeferredByVerdict
        exp_alerts: []
      - eval_time: 5h20m
        alertname: MgmtApplyDeferredByVerdict
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", triage: dig }
      - eval_time: 5h20m
        alertname: MgmtApplyLoopStale
        exp_alerts: []

  # ── the box stops answering ────────────────────────────────────────────────────────────────────
  - interval: 1m
    name: "a down box fires after 15m"
    input_series:
      - series: 'up{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x5 0x25"
    alert_rule_test:
      - eval_time: 15m
        alertname: MgmtBoxDown
        exp_alerts: []
      - eval_time: 25m
        alertname: MgmtBoxDown
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}

  # ── FU-235: the node diff ──────────────────────────────────────────────────────────────────────
  # The 2026-09-12 shape: kata declared on a laptop, the label absent live. Live-applied axes get
  # an hour; a matched axis (0) never fires.
  - interval: 5m
    name: "a label drift fires after 1h; matched axes stay quiet"
    input_series:
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="wk-metal-03",axis="labels"}'
        values: "1x20"
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="wk-metal-03",axis="taints"}'
        values: "0x20"
    alert_rule_test:
      - eval_time: 45m
        alertname: MgmtNodeLiveStateDrift
        exp_alerts: []
      - eval_time: 75m
        alertname: MgmtNodeLiveStateDrift
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", node: wk-metal-03, axis: labels , triage: dig}

  # The 2026-09-21 shape: wk-metal-02 answers talosctl, no Node object. A reinstall window is under
  # 2h; this one is not.
  - interval: 5m
    name: "a declared node with no Node object fires after 2h"
    input_series:
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="wk-metal-02",axis="registered"}'
        values: "1x30"
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="wk-metal-02",axis="reachable"}'
        values: "0x30"
    alert_rule_test:
      - eval_time: 1h45m
        alertname: MgmtNodeMissing
        exp_alerts: []
      - eval_time: 2h15m
        alertname: MgmtNodeMissing
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", node: wk-metal-02, axis: registered , triage: dig}

  # The 2026-09-16 shape: nx-01's EPHEMERAL on the SATA disk after a clean plan. Install-time — a
  # window fixes it, and windows queue, so a day.
  - interval: 5m
    name: "an install-time drift is quiet for a day, then fires"
    input_series:
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="nx-01",axis="ephemeral_disk"}'
        values: "1x320"
      - series: 'mgmt_node_drift{job="mgmt-node",instance="192.168.2.53:9100",node="nx-01",axis="version"}'
        values: "1x320"
    alert_rule_test:
      - eval_time: 23h
        alertname: MgmtNodeInstallDrift
        exp_alerts: []
      - eval_time: 25h
        alertname: MgmtNodeInstallDrift
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", node: nx-01, axis: ephemeral_disk , triage: dig}
      # version is TalosFleetVersionSplit's, never these rules'
      - eval_time: 25h
        alertname: MgmtNodeLiveStateDrift
        exp_alerts: []
      - eval_time: 25h
        alertname: MgmtNodeMissing
        exp_alerts: []

  # ── the belt itself ────────────────────────────────────────────────────────────────────────────
  - interval: 5m
    name: "a belt whose last run stops advancing fires after an hour plus 15m"
    input_series:
      - series: 'mgmt_probe_last_run_timestamp{job="mgmt-node",instance="192.168.2.53:9100",mode="belt"}'
        values: "0+300x12 3600x30"
    alert_rule_test:
      - eval_time: 1h50m
        alertname: MgmtBeltStale
        exp_alerts: []
      - eval_time: 2h20m
        alertname: MgmtBeltStale
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", mode: belt , triage: none}

  - interval: 5m
    name: "exporter up with only the GATE's file (no belt) fires after 1h"
    input_series:
      - series: 'up{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x18"
      - series: 'mgmt_probe_last_run_timestamp{job="mgmt-node",instance="192.168.2.53:9100",mode="gate"}'
        values: "0x18"
    alert_rule_test:
      - eval_time: 55m
        alertname: MgmtBeltMetricsAbsent
        exp_alerts: []
      - eval_time: 80m
        alertname: MgmtBeltMetricsAbsent
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}

  # ── the node reconciler (ADR-132 §MB4, mgmt/scripts/mgmt-reconcile.sh) ─────────────────────────────
  - interval: 1m
    name: "a parked node fires after 5m; idle and pending never do"
    input_series:
      - series: 'mgmt_reconcile_node_state{job="mgmt-node",instance="192.168.2.53:9100",node="wk-03",state="parked"}'
        values: "0x10 1x20"
      - series: 'mgmt_reconcile_node_state{job="mgmt-node",instance="192.168.2.53:9100",node="wk-03",state="pending"}'
        values: "1x10 0x20"
    alert_rule_test:
      - eval_time: 10m
        alertname: MgmtReconcileParked
        exp_alerts: []
      - eval_time: 14m
        alertname: MgmtReconcileParked
        exp_alerts: []
      - eval_time: 17m
        alertname: MgmtReconcileParked
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", node: wk-03, state: parked , triage: dig}

  # A sync that started at t=60s: fine at 2h, stuck past 3h + 5m. The loop does not tick while it
  # runs, so its last-run stays at the sync start — and must NOT read as a stale loop.
  - interval: 5m
    name: "a long sync fires SyncStuck after 3h and never LoopStale"
    input_series:
      - series: 'mgmt_reconcile_sync_started_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100",node="wk-03"}'
        values: "60x60"
      - series: 'mgmt_reconcile_last_run_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "60x60"
    alert_rule_test:
      - eval_time: 2h
        alertname: MgmtReconcileSyncStuck
        exp_alerts: []
      - eval_time: 3h10m
        alertname: MgmtReconcileSyncStuck
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", node: wk-03 , triage: dig}
      - eval_time: 4h
        alertname: MgmtReconcileLoopStale
        exp_alerts: []

  - interval: 5m
    name: "no sync open and no tick for over an hour → LoopStale; an idle node is not stuck"
    input_series:
      - series: 'mgmt_reconcile_sync_started_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100",node="wk-03"}'
        values: "0x40"
      - series: 'mgmt_reconcile_last_run_timestamp_seconds{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "0+600x6 3600x34"
    alert_rule_test:
      - eval_time: 1h
        alertname: MgmtReconcileLoopStale
        exp_alerts: []
      - eval_time: 2h30m
        alertname: MgmtReconcileLoopStale
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100" , triage: none}
      - eval_time: 3h
        alertname: MgmtReconcileSyncStuck
        exp_alerts: []

  - interval: 1m
    name: "exporter up with no mgmt_reconcile series fires after 1h"
    input_series:
      - series: 'up{job="mgmt-node",instance="192.168.2.53:9100"}'
        values: "1x90"
    alert_rule_test:
      - eval_time: 50m
        alertname: MgmtReconcileMetricsAbsent
        exp_alerts: []
      - eval_time: 65m
        alertname: MgmtReconcileMetricsAbsent
        exp_alerts:
          - exp_labels: { job: mgmt-node, instance: "192.168.2.53:9100", severity: warning , triage: none}

  # The substrate cases (MgmtSubstrateBehind/Unsupported, FU-254 — eval clock out to 8d) live in
  # mgmt-metrics-substrate.promtool-test against a two-rule copy: run here they evaluated this
  # file's every rule (recording rules included) for ~22,000 steps (CI wall time, 2026-10-09).

  # ── THE BELT'S OWN VERDICTS (2026-09-23) ──────────────────────────────────────────────────────
  # MgmtBeltStale catches "the belt stopped running". Nothing read what it SAID: `mgmt_probe_check`
  # has carried a per-check status all along with no rule consuming it, so the `talos` check failed
  # on EVERY tick from the 2026-09-22 fleet move to v1.14.1 (box talosctl a minor behind) and the
  # only reason anyone knew is a seat running the unit by hand. What is pinned here: a standing
  # FAIL pages and names itself, a transient one does not, and a passing check never does.
  # The transient's shape is real: the textfile is rewritten WHOLE each run, so a check that stops
  # failing loses its status="fail" series — it does not sit at 0.
  - interval: 1m
    name: "a belt check failing for two hours pages and names itself; a transient one does not"
    input_series:
      - series: 'mgmt_probe_check{job="mgmt-node",instance="192.168.2.53:9100",mode="belt",check="talos",status="fail",reason="skew"}'
        values: "1x200"
      - series: 'mgmt_probe_check{job="mgmt-node",instance="192.168.2.53:9100",mode="belt",check="ansible",status="fail",reason="unreachable"}'
        values: "1x30"
      - series: 'mgmt_probe_check{job="mgmt-node",instance="192.168.2.53:9100",mode="belt",check="substrate",status="pass",reason="ok"}'
        values: "1x200"
    alert_rule_test:
      # t=1h: talos is pending (30 min short of the 2h `for:`), ansible's series went away 25 min
      # ago when the check passed. Nothing fires — a belt that fails a tick is not an incident.
      - eval_time: 1h
        alertname: MgmtBeltCheckFailing
        exp_alerts: []
      # t=2h5m: talos alone, named by its own label.
      - eval_time: 2h5m
        alertname: MgmtBeltCheckFailing
        exp_alerts:
          - exp_labels:
              severity: warning
              job: mgmt-node
              instance: "192.168.2.53:9100"
              mode: belt
              check: talos
              status: fail
              triage: none

  # ── THE REASON LABEL (2026-10-03, responder audit) ───────────────────────────────────────────
  # mgmt_probe_check carries a bounded `reason` word (mgmt-probe.sh REASONS). The rule aggregates it
  # OUT, so (a) the alert's labels above carry no reason, and (b) a check whose reason flips between
  # ticks is still ONE standing failure: ansible unreachable for an hour, then failed (the node came
  # back answering errors) — the 2h `for:` keeps counting from t=0. With `reason` in the alert's
  # identity the second series would restart the clock at 1h01m and nothing would fire at 2h05m.
  - interval: 1m
    name: "a belt check whose reason flips is one standing failure — the for: does not restart"
    input_series:
      - series: 'mgmt_probe_check{job="mgmt-node",instance="192.168.2.53:9100",mode="belt",check="ansible",status="fail",reason="unreachable"}'
        values: "1x60 _x100"
      - series: 'mgmt_probe_check{job="mgmt-node",instance="192.168.2.53:9100",mode="belt",check="ansible",status="fail",reason="failed"}'
        values: "_x60 1x100"
    alert_rule_test:
      - eval_time: 2h5m
        alertname: MgmtBeltCheckFailing
        exp_alerts:
          - exp_labels:
              severity: warning
              job: mgmt-node
              instance: "192.168.2.53:9100"
              mode: belt
              check: ansible
              status: fail
              triage: none
