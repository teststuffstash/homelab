# Behaviour fixture for the mgmt-substrate group (FU-254) — MgmtSubstrateBehind and
# MgmtSubstrateUnsupported, the long-horizon cases split out of mgmt-metrics.promtool-test (CI wall
# time, 2026-10-09).
#
#   devbox run -- promtool test rules argocd/resources/mgmt-metrics/mgmt-metrics-substrate.promtool-test
#
# WHY A SEPARATE PAIR: `promtool test rules` evaluates EVERY rule in its rule_files once per
# evaluation_interval from 0 to each test group's last eval_time. Behind's `for: 7d` puts these
# cases at 7d2h and 8d — inside mgmt-metrics.promtool-test that was every one of that file's ~30
# rules (the mgmt-rollout recording rules included) × ~22,000 one-minute steps. Here the rules file
# carries the mgmt-substrate group ALONE. Moved verbatim — same inputs, eval_times, assertions.
#
# promtool's clock starts at 0, so time() is the test clock.
rule_files:
  - mgmt-metrics-substrate.promtool-rules

evaluation_interval: 1m

tests:
  # ── FU-254: the DECLARATION going stale (mgmt/scripts/mgmt-probe.sh check_substrate) ────────────────
  # Behind is deliberately slow: a minor behind for a day is a window not yet taken, a minor behind
  # for a week is nobody's turn. A current component (0) never fires at any horizon.
  # interval 5m, not 1h: a sample gap past the 5-minute staleness horizon leaves the series absent
  # between samples and NOTHING ever fires (the first draft of this fixture did exactly that).
  - interval: 5m
    name: "a supported minor behind upstream fires after 7d; a current one never does"
    input_series:
      - series: 'mgmt_substrate_minors_behind{job="mgmt-node",instance="192.168.2.53:9100",component="kubernetes"}'
        values: "1x2100"
      - series: 'mgmt_substrate_supported{job="mgmt-node",instance="192.168.2.53:9100",component="kubernetes"}'
        values: "1x2100"
      - series: 'mgmt_substrate_minors_behind{job="mgmt-node",instance="192.168.2.53:9100",component="talos-worker"}'
        values: "0x2100"
      - series: 'mgmt_substrate_supported{job="mgmt-node",instance="192.168.2.53:9100",component="talos-worker"}'
        values: "1x2100"
    alert_rule_test:
      - eval_time: 6d
        alertname: MgmtSubstrateBehind
        exp_alerts: []
      - eval_time: 7d2h
        alertname: MgmtSubstrateBehind
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", component: kubernetes , triage: none}
      # a component that is current is not "behind" at any horizon, and nothing here is EOL
      - eval_time: 7d2h
        alertname: MgmtSubstrateUnsupported
        exp_alerts: []

  # The 2026-09-03 shape, exactly: Talos 1.13 with 1.14.0 shipped — ONE minor behind and already out
  # of community support (the window constant for talos is 1; #1949's review). An EOL verdict does
  # not flap (it moves only when upstream ships a minor), so the hour is a bad-tick filter. It is
  # Unsupported's page ALONE: without Behind's `supported == 1` guard this input would fire BOTH at
  # 8 days, which is the assertion at the end — and for talos that guard is the whole separation,
  # since one minor behind is simultaneously "behind" and "EOL".
  - interval: 5m
    name: "an out-of-support minor fires Unsupported after 1h and never Behind"
    input_series:
      - series: 'mgmt_substrate_minors_behind{job="mgmt-node",instance="192.168.2.53:9100",component="talos-controlplane"}'
        values: "1x2400"
      - series: 'mgmt_substrate_supported{job="mgmt-node",instance="192.168.2.53:9100",component="talos-controlplane"}'
        values: "0x2400"
    alert_rule_test:
      - eval_time: 30m
        alertname: MgmtSubstrateUnsupported
        exp_alerts: []
      - eval_time: 2h
        alertname: MgmtSubstrateUnsupported
        exp_alerts:
          - exp_labels: { severity: warning, job: mgmt-node, instance: "192.168.2.53:9100", component: talos-controlplane , triage: none}
      - eval_time: 8d
        alertname: MgmtSubstrateBehind
        exp_alerts: []
