      - series: 'kube_pod_container_status_restarts_total{namespace="y",pod="r2",uid="w2",container="c"}'
        values: "0x618 1+1x53"
      - series: 'kube_pod_container_status_restarts_total{namespace="y",pod="r3",uid="w3",container="c"}'
