# The mgmt-upgrade-lease group, lifted VERBATIM out of upgrade-lease.yaml (annotations stripped —
# the manifest is their one home) — the rules file upgrade-lease.promtool-test loads. DRIFT-PINNED
# by `devbox run prometheus-rules-lint`. Re-copy after every expr edit:
#
#   yq -o=json '{"groups": [.spec.groups[] | .rules |= map(del(.annotations))]}' argocd/resources/mgmt-metrics/upgrade-lease.yaml | yq -P '.'
#
groups:
  - name: mgmt-upgrade-lease
    rules:
      - alert: MgmtLeaseRevertFailed
        expr: |
          sum by (outcome) (increase(mgmt_lease_revert_total{outcome=~"error|not_pin_only|conflict|no_policy"}[30m])) > 0
        labels:
          severity: critical
          triage: now
      - alert: MgmtLeaseExpiredUnreverted
        expr: |
          mgmt_lease_expired > 0
        for: 15m
        labels:
          severity: warning
          triage: dig
      - alert: MgmtLeaseLoopStale
        expr: |
          (time() - mgmt_lease_last_run_timestamp_seconds) > 1200
        for: 10m
        labels:
          severity: warning
          triage: none
      - alert: MgmtLeaseMetricsAbsent
        expr: |
          up{job="mgmt-node"} == 1
            unless on (instance) mgmt_lease_last_run_timestamp_seconds
        for: 30m
        labels:
          severity: warning
          triage: none
