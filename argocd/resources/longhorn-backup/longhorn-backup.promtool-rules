# The longhorn-backup group lifted out of prometheusrule.yaml with annotations stripped (they are
# runbooks; their one home is the manifest) — the rules file longhorn-backup.promtool-test loads.
# Named .promtool-rules so manifest-lint does not kubeconform it. Re-copy after editing an expr:
#   yq -o=yaml '{"groups": [.spec.groups[] | .rules |= map(del(.annotations))]}' argocd/resources/longhorn-backup/prometheusrule.yaml
groups:
  - name: longhorn-backup
    rules:
      # max_over_time: one good probe in the window holds it off, so a blackbox-exporter roll
      # (replicas: 1 — the EndpointProbeFailing restart-gap class) never pages on its own.
      - alert: LonghornBackupTargetDown
        expr: max_over_time(probe_success{job="blackbox-longhorn-backup-target"}[10m]) == 0
        for: 5m
        labels:
          severity: warning
          # triage: BackupTarget CR message separates in-cluster credential or URL faults from LXC-down
          triage: dig
      # Only volumes that HAVE a backup (`> 0`): a volume nobody backs up exports 0 and is a
      # class decision (docs/longhorn-backup.md §Classes), not a stale backup. 36 h = a daily
      # job missed once plus slack.
      - alert: LonghornBackupStale
        expr: (time() - longhorn_volume_last_backup_at) > 36 * 3600 and longhorn_volume_last_backup_at > 0
        for: 1h
        labels:
          severity: warning
          # triage: recurring job runs and backup CRs are readable in-cluster
          triage: dig
  # UniFi's settings-only .unf (docs/longhorn-backup.md §UniFi). The controller writes it daily at
  # 01:00Z; the `backup-age` sidecar in tofu/unifi.tf pushes the newest file's mtime (0 = no file)
  # to the Pushgateway every 5 min. Stale = the export stopped, whatever the cause — a schedule
  # that did not converge, a Mongo fault (the 2026-10-01 corrupt collection failed it silently),
  # or the sidecar itself dead (its last value freezes and ages into this alert).
  - name: unifi-backup
    rules:
      - alert: UnifiAutobackupStale
        expr: (time() - unifi_autobackup_last_file_timestamp_seconds) > 36 * 3600
        for: 1h
        labels:
          severity: warning
          # triage: the controller's server.log and the sidecar/init logs say which link broke
          triage: dig
      # Nothing has been pushed at all: the sidecar never ran, or the Pushgateway lost its store.
      - alert: UnifiAutobackupAgeMissing
        expr: absent(unifi_autobackup_last_file_timestamp_seconds)
        for: 1h
        labels:
          severity: warning
          # triage: sidecar log + pushgateway state are readable in-cluster
          triage: dig
