# NOT synced (extension .example): the shape a stack's -iac ships. First live test: a claim in
# a scratch ns against a harmless echo backend; the capability stays inert until the operator
# arms CLOUDFLARE_INGRESS_WRITE in Infisical.
#
# v1alpha2: profile field is REQUIRED (no default on the object). consumer = edge caching on,
# challenges legal. api = per-IP rate limiting, no challenge-shaped mitigations, CORS at edge.
---
# Consumer profile example: edge caching on, challenges legal.
apiVersion: platform.teststuff.net/v1alpha2
kind: PublicRoute
metadata:
  name: probe
  namespace: default
spec:
  profile: consumer
  hostname: cf-probe.default.teststuff.net
  backend:
    service: podinfo.default.svc.cluster.local.
    port: 9898
---
# Api profile example: per-IP rate limiting, no challenges, CORS at edge.
apiVersion: platform.teststuff.net/v1alpha2
kind: PublicRoute
metadata:
  name: mcp
  namespace: oracle-fleet
spec:
  profile: api
  hostname: mcp.minutark.ee
  backend:
    service: oracle-gateway.oracle-fleet.svc.cluster.local.
    port: 8080
    protocol: https
  rateLimit:
    threshold: 1200
  origins:
    - https://app.minutark.ee
    - https://dashboard.minutark.ee