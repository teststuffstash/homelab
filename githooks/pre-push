#!/bin/sh
# pre-push — the jail's direct-to-master tripwire (operator direction, 2026-08-30).
# A master push from the jail bypasses CI (OrgAdmin), so THIS is the only lint gate that
# lane has — the 2026-08-30 miss (a bookkeeping push shipped a TERM-UNLINKED break and
# redded every open PR, the #953 class) is the founding incident. Branch pushes are
# untouched: the PR lane's required checks own them.
# Wired via `git config core.hooksPath githooks` (set by the jail entrypoint; persists in
# the host-side .git/config regardless).
#
# 2026-10-10 (the #2456 class): an operator-direct push edited docs/github-apps.yaml without
# regenerating docs/github-apps.json, and `ci` reported red on `github-apps-lint` from that
# commit (7c50f507) until #2456 fixed it — nothing in the fixed set below covers docs/. Rather
# than hand-copy one more path, this hook now ALSO runs every OTHER cheap, local, no-WAN `ci`
# gate whose path matches the pushed range, via
# `devbox run diff-ci -- --push-gates <changed-files>` — scripts/diff-ci.sh's own MAP, minus its
# PUSH_HEAVY exclusions (WAN-bound or just too slow for this budget; see diff-ci.sh for the
# measured cutoff). One home: a path that feeds a CI gate feeds this gate too, and the two
# cannot drift apart. The pushed-file list is pre-filtered to drop the pure BOOKKEEPING paths
# (jail-seat-card.md's direct-lane list: the tracker, TICK-LOG, meta-state, GAPS) before that
# call AND before the clause-replay check below — those are prose/log files with no code behind
# them, and diff-ci.sh deliberately buckets ALL of agents/ onto one broad `^agents/` trigger for
# its quick-regression suite (CI's budget can absorb that; this hook's ~2-minute one cannot), so
# an unfiltered push touching only agents/coordinator/TICK-LOG.md — the single most common
# direct-lane push there is — would otherwise select two dozen agents/ gates for a file with no
# executable content at all.
# `githooks/pre-push --dry-run <rev>` prints the selected set without running it, e.g.
# `--dry-run 7c50f507` reproduces the miss.
if [ "${1:-}" = "--dry-run" ]; then
  DRY_RUN=1
  dry_arg="${2:?usage: githooks/pre-push --dry-run <rev-or-range>}"
  case "$dry_arg" in *..*) range="$dry_arg" ;; *) range="${dry_arg}^..${dry_arg}" ;; esac
  cd "$(git rev-parse --show-toplevel)" || exit 1
else
  DRY_RUN=0
  remote_master_touched=0; local_sha=''; remote_sha=''
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/master" ] && { remote_master_touched=1; local_sha="$_local_sha"; remote_sha="$_remote_sha"; }
  done
  [ "$remote_master_touched" -eq 1 ] || exit 0
  cd "$(git rev-parse --show-toplevel)" || exit 1
  # The range being pushed. Used by gitleaks below and by the clause/push-gate steps further down.
  range="$remote_sha..$local_sha"
  case "$remote_sha" in 0000000000000000000000000000000000000000|'') range="$local_sha";; esac
fi
if [ "$DRY_RUN" -eq 1 ]; then
  echo "pre-push --dry-run: range $range — printing the selection, running nothing" >&2
else
  echo "pre-push: master push — running gitleaks + the doc lints (docs-graph-lint + follow-ups-lint) + tofu fmt -check + every other path-selected cheap local lint" >&2
fi

# SECRET SCAN, first because it is the one whose miss cannot be undone (2026-09-21): a stray
# talosconfig — os:admin cert AND private key — was swept into a bookkeeping commit by a bulk
# `git add` and pushed to this PUBLIC repo. The gitleaks engine already existed, but only in CI,
# and a master push from the jail bypasses CI; the pre-push gate ran three lints, none of them a
# secret scan. Scoped to the pushed RANGE (~0.1 s, vs ~5 s for the whole tree) and deliberately
# NOT `--no-git`: a working tree here always holds gitignored kubeconfig/talosconfig/tfstate, so
# a tree scan would block every push. Config comes from policy/iac/ — the same file the sentinel
# uses. Exit 9 is "found something"; anything else is a tool problem, reported but not a block
# (the sentinel's 2026-08-19 discrimination: a missing binary is not a finding).
if [ "$DRY_RUN" -eq 1 ]; then
  echo "  would run: gitleaks detect --log-opts=$range (secret scan)" >&2
else
  devbox run -- gitleaks detect --source . --log-opts="$range" --config policy/iac/gitleaks.toml \
    --no-banner --redact --exit-code 9 >/dev/null 2>&1
  grc=$?
  if [ "$grc" -eq 9 ]; then
    echo "pre-push: BLOCKED — gitleaks found secret material in the commits being pushed." >&2
    echo "  see it with: devbox run -- gitleaks detect --source . --log-opts=\"$range\" --config policy/iac/gitleaks.toml --redact -v" >&2
    echo "  a pushed secret cannot be unpushed — remove the file, then ROTATE the credential." >&2
    exit 1
  elif [ "$grc" -ne 0 ]; then
    echo "pre-push: gitleaks TOOL ERROR (rc=$grc) — scan did not run; not blocking on it." >&2
  fi
fi

# must <label> <devbox-task...> — the fixed baseline: always runs on a real push (unconditional,
# same set as before 2026-10-10); in --dry-run mode it only announces itself.
must() {
  label="$1"; shift
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "  would run: devbox run $* ($label, unconditional)" >&2
    return 0
  fi
  if ! devbox run "$@" >&2; then
    echo "pre-push: BLOCKED — $label red. Fix, commit, push again." >&2; exit 1
  fi
}
must "docs-graph-lint" docs-graph-lint
must "follow-ups-lint" follow-ups-lint
# CI's first step, for the same reason (2026-09-09, #1565): a direct quickfix (3e51f67e) shipped
# an unformatted tofu/longhorn.tf and every open PR went red on `fmt -check` the moment the
# updater merged master into it. Free (no provider download), ~2 s.
must "tofu fmt -check" -- tofu fmt -check -recursive tofu/

# The changed-file list every path-driven step below reads, with the pure BOOKKEEPING paths
# (agents/jail-seat-card.md's direct-lane "session state" bullet) dropped — see the header for
# why. Keep this list in sync with that bullet; it is a fixed, small, named set (exact paths,
# not a regex guess), so it cannot drift the way a hand-copied path REGEX would.
BOOKKEEPING_FILES='^(docs/agents/meta-state\.md|agents/coordinator/TICK-LOG\.md|\.claude/skills/GAPS\.md|docs/follow-ups\.md|docs/follow-ups-archive\.md)$'
changed_file=$(mktemp) || exit 1
trap 'rm -f "$changed_file"' EXIT
git diff --name-only "$range" 2>/dev/null | grep -vE "$BOOKKEEPING_FILES" > "$changed_file"

# ADR-103's ratchet for the DIRECT lane (2026-09-04): a master push that touches a clause path
# runs the clause replays too — CI's ratchet never sees a direct push, so c6262200 (a one-line
# pin-only-lint edit) shipped with a stale fixture and redded every fixer PR's replay for an
# hour. Same path set as scripts/diff-ci.sh's CLAUSE_PATHS plus scripts/ (the scan reads
# pin-only-lint.sh's GUARDED list — today's exact miss). ~76 s; skipped when nothing matches.
# Kept as its own step (not folded into the generic push-gates loop below) because its trigger
# is deliberately WIDER than diff-ci.sh's own CLAUSE_PATHS row (the `|^scripts/` arm) — the
# generic loop runs the MAP row verbatim and would otherwise narrow this back to the original miss.
eval "$(grep -m1 '^CLAUSE_PATHS=' scripts/diff-ci.sh)"
if [ -s "$changed_file" ] && grep -qE "${CLAUSE_PATHS:-^agents/}|^scripts/" "$changed_file"; then
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "  would run: devbox run clause-replay (ADR-103 direct-lane ratchet, clause path touched)" >&2
  else
    echo "pre-push: clause path touched — running the clause replays (devbox run clause-replay)" >&2
    if ! devbox run clause-replay >&2; then
      echo "pre-push: BLOCKED — a clause replay is red. A changed clause ships with its fixture (ADR-103)." >&2; exit 1
    fi
  fi
fi

# Every OTHER cheap/local/no-WAN `ci` gate whose path regex — scripts/diff-ci.sh's own MAP, the
# SAME map ci.yaml's skip step reads — matches this (bookkeeping-filtered) range. diff-ci.sh's
# PUSH_HEAVY list excludes WAN-bound or too-slow rows; see its header for the measured cutoff.
# This is what closes the #2456 class: docs/github-apps.yaml alone used to select nothing here.
# A range that is ALL bookkeeping (changed_file now empty) selects nothing — the unconditional
# baseline above already covers those paths; see diff-ci.sh's --push-gates for why an empty-but-
# present file means "nothing", not "everything" (the opposite of --ci-outputs' CI-side default).
# docs-graph-lint, follow-ups-lint and clause-replay are dropped from the result below — they
# already ran above, unconditionally or on their own wider trigger; running them twice would
# just spend the budget for nothing.
push_tasks=$(devbox run diff-ci -- --push-gates "$changed_file" 2>/dev/null \
  | grep -vxE 'docs-graph-lint|follow-ups-lint|-- tofu fmt -check -recursive tofu/|clause-replay')
if [ -n "$push_tasks" ]; then
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "  would run: devbox run $t (path-selected)" >&2
      continue
    fi
    echo "pre-push: path-selected — running devbox run $t" >&2
    # shellcheck disable=SC2086 — task strings intentionally word-split (args ride along), same
    # convention as scripts/diff-ci.sh's own run loop.
    if ! devbox run $t >&2; then
      echo "pre-push: BLOCKED — devbox run $t is red. Fix, commit, push again." >&2; exit 1
    fi
  done <<EOF
$push_tasks
EOF
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "pre-push --dry-run: done (nothing executed)" >&2
  exit 0
fi
echo "pre-push: lints green — pushing master" >&2
exit 0
