# OpenTofu / Terraform
# NB: .terraform.lock.hcl is intentionally NOT ignored — commit it for
# reproducible, pinned provider versions (deterministic by design).
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real secrets / rendered creds — never commit
*.tfvars
!*.tfvars.example
kubeconfig
talosconfig
*.auto.tfvars

# A stray talosconfig landed here once as `nix-shell-env` and was committed to PUBLIC master
# (2026-09-21, incident). The two names above are not enough — ignore anything in this
# directory that is not a tracked source file is not expressible, so the belt is the gitleaks
# pre-push hook; this line closes the exact hole.
nix-shell-env
