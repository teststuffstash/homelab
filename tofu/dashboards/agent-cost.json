  {
   "id": 1,
   "type": "stat",
   "title": "Worker $ (last 24h)",
   "description": "Sum of agent_run_cost_usd over runs pushed to the gateway in the last 24h (push_time_seconds gating). Workers are OpenRouter-metered \u2014 this is the real spend. Coordinator/reviewer run on the subscription (free at margin).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(agent_run_cost_usd and on(job, role, project, issue, round) (time() - push_time_seconds < 86400)) or vector(0)"
    }
