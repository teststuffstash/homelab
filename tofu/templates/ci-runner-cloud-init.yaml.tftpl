#cloud-config
hostname: ${name}
package_update: true
# qemu-guest-agent: so Proxmox sees the agent/IP + clean shutdowns (the VM sets agent.enabled=true).
# prometheus-node-exporter (2026-10-08 incident): the runner's root fs filled to 100 % from leaked
# anonymous docker volumes and nothing alerted — no exporter, so Prometheus had zero series for
# either runner. Debian's package listens on :9100 and is enabled on install; the cluster scrapes
# it as the static job `ci-runner-node` (argocd/resources/ci-runner-metrics/, the disk belts).
packages: [curl, jq, ca-certificates, git, sudo, openssl, qemu-guest-agent, skopeo, prometheus-node-exporter]
users:
  - name: debian
    groups: [sudo, docker]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_key}
  - name: runner
    groups: [docker]
    shell: /bin/bash
write_files:
  # GitHub App private key — used ONLY to mint short-lived runner registration tokens at boot.
  - path: /etc/runner-app/private-key.pem
    permissions: '0600'
    owner: root:root
    content: |
      ${indent(6, app_private_key)}
  # The minting primitive (same script as homelab scripts/gh-app-runner-token.sh).
  - path: /usr/local/bin/mint-runner-token.sh
    permissions: '0755'
    owner: root:root
    content: |
      ${indent(6, mint_script)}
  # FU-073(b): docker.io pulls ride the in-cluster pull-through mirror (ADR-091, BGP VIP —
  # reachable from the LAN). Hub-only by dockerd design (ghcr can't be daemon-mirrored); plain
  # http, hence insecure-registries. Written before the get.docker.com install, so dockerd
  # starts with it. Mirror down ⇒ dockerd falls back to Docker Hub (unlike the agent rides,
  # this host's egress is unrestricted). 192.168.40.31 (MCR mirror, ADR-091 extension PR#992)
  # joined 2026-08-30: sleep's render gate host-pulls playwright/python through it (sleep#133)
  # — applied live the same day per the inotify precedent below; this template covers recreates.
  - path: /etc/docker/daemon.json
    permissions: '0644'
    owner: root:root
    content: |
      {"registry-mirrors": ["http://192.168.40.20"], "insecure-registries": ["192.168.40.20", "192.168.40.21", "192.168.40.31"]}
  # BuildKit per-registry mirrors (homelab#1308): the daemon.json mirror above is Hub-only by
  # dockerd design (SERVICES.md's own row says so) — a non-Hub `FROM` (ghcr.io/astral-sh/uv:...,
  # mcr.microsoft.com/playwright) in a `docker build` still pulls direct WAN on every
  # layer-cache miss. BuildKit itself honors a per-registry mirror for ANY registry, but ONLY
  # for a docker-container (or remote) builder — the default `docker` driver builds inside
  # dockerd and reads daemon.json only, which is what this file's mirror covers and no more.
  # One block per mirror host: the `[registry."<mirror-ip>"]` blocks mark the mirror itself as
  # plain-HTTP (it's the BGP VIP registry:3 proxy, not a real registry with a cert) — without
  # them BuildKit tries HTTPS against the mirror IP and fails closed.
  - path: /etc/buildkit/buildkitd.toml
    permissions: '0644'
    owner: root:root
    content: |
      [registry."docker.io"]
        mirrors = ["192.168.40.20"]
      [registry."ghcr.io"]
        mirrors = ["192.168.40.21"]
      [registry."mcr.microsoft.com"]
        mirrors = ["192.168.40.31"]
      [registry."192.168.40.20"]
        http = true
        insecure = true
      [registry."192.168.40.21"]
        http = true
        insecure = true
      [registry."192.168.40.31"]
        http = true
        insecure = true
  # kind exhausts the Debian-default 128 inotify instances once ≥3 clusters coexist (two runner
  # slots + one leaked cluster is enough): the freshest cluster's CoreDNS starves and every DNS
  # lookup fails Errno -3 while pod/node status stays green (measured 116/128 with two leaked
  # clusters, 2026-08-09, oracle-fleet#228). Applied live the same day; runcmd covers first boot.
  # 512→1024 + watches 2026-09-02: 512 exhausted AGAIN (515 in use, SIX leaked clusters up to
  # 26h old — every fleet e2e failed at kind boot with "could not find ... Multi-User System").
  # Raising the limit buys headroom; the janitor below is the actual fix (leaks accumulate to
  # ANY limit). Applied live the same day, both.
  - path: /etc/sysctl.d/99-kind-inotify.conf
    permissions: '0644'
    owner: root:root
    content: |
      fs.inotify.max_user_instances=1024
      fs.inotify.max_user_watches=524288
  # Reap leaked kind-family containers: cancelled/timed-out CI jobs never run their teardown
  # (the 2026-09-02 exhaustion's cause). Hourly, ≥3h-old only — a live e2e run is minutes.
  # Belt only; the cause-side half is each stack's pre-create sweep (docs/patterns/kind-ci.md
  # rule 2 — landed for oracle in oracle-fleet#363, `scripts/lib/e2e-sweep.sh`).
  # ⚠ The prefixes must track the stacks' CURRENT cluster names: oracle renamed to
  # `oracle-fleet-e2e-*` in #363 and the pre-#363 names still appear on runner-local leftovers.
  # VOLUMES too (2026-10-08 disk-full, #2379): `kindest/node` declares `VOLUME /var`, so a reap
  # without `-v` left each node's 2–2.8 GB anonymous /var behind (runner-01: 698 leaked volumes,
  # 33.6 GB, root fs 100 %). `rm -f -v` drops a reaped container's anonymous volumes; the
  # trailing `volume prune -f` collects anonymous volumes leaked by ANY container removed
  # without `-v` (stacks' own cleanups — oracle's `registry:2` was the bulk of the count). On
  # Docker ≥23 (runners: 29.8.0, verified 2026-10-08) prune without `-a` removes only UNUSED
  # ANONYMOUS volumes: named ones (buildx_buildkit_*_state, stacks' named caches) are never
  # touched, nor is any volume a container (running or stopped) still references. Never add `-a`.
  - path: /usr/local/bin/kind-janitor.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # NB: {{.Names}} is docker's Go-template syntax — it passes through tftpl untouched
      # (Terraform templates only interpret $${ and %%{ sequences).
      docker ps -a --format '{{.Names}}'$'\t''{{.Status}}' \
        | grep -E "^(oracle-fleet-e2e-|oracle-e2e-|oracle-serve-|sleep-itest-|circles-test|kind-registry-)" \
        | grep -E "$(printf '%s' 'Up ([3-9]|[0-9]{2,}) hours|Up [0-9]+ (days|weeks|months)|Exited')" \
        | cut -f1 | xargs -r docker rm -f -v
      docker volume prune -f
  # Registry logins must not outlive their job (2026-10-06, #2379): a job's `docker/login-action`
  # wrote ghcr.io auth into the runner's docker config, the worker crashed (ENOSPC) before the
  # post-step logout, and the expired token broke every later default-builder `docker build`
  # ("denied: denied"). Fix = per-SLOT docker config + this job-started hook. Each slot's `.env`
  # (runcmd below) sets its own DOCKER_CONFIG, so one slot's reset never wipes the OTHER slot's
  # in-flight login (a hook on one shared config.json would — two slots, one $HOME). BUILDX_CONFIG
  # stays pinned to the shared ~/.docker/buildx: buildx keeps builder state under
  # $DOCKER_CONFIG/buildx by default, so without the pin a slot loses `homelab-mirrors`
  # (verified 2026-10-08 on runner-01: DOCKER_CONFIG alone lists only `default`).
  # ACTIONS_RUNNER_HOOK_JOB_STARTED runs it before every job's first step; it keeps any non-auth
  # keys and resets only `auths`.
  - path: /usr/local/bin/runner-job-started.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      set -eu
      cfg="$${DOCKER_CONFIG:-$HOME/.docker}/config.json"
      mkdir -p "$(dirname "$cfg")"
      if [ -s "$cfg" ] && jq -e 'type == "object"' "$cfg" >/dev/null 2>&1; then
        jq '.auths = {}' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
      else
        printf '{"auths": {}}\n' > "$cfg"
      fi
      chmod 0600 "$cfg"
  # systemd timer, NOT cron: the Debian 12 genericcloud image ships NO cron package, so the
  # /etc/cron.d drop-in this replaced was inert from the day it was written (found 2026-09-04 on
  # the freshly recreated VM — janitor script present, nothing ever ran it).
  - path: /etc/systemd/system/kind-janitor.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Reap leaked kind CI containers

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/kind-janitor.sh
  - path: /etc/systemd/system/kind-janitor.timer
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Hourly kind-janitor sweep

      [Timer]
      OnCalendar=*-*-* *:17:00
      Persistent=true

      [Install]
      WantedBy=timers.target
runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now prometheus-node-exporter
  - sysctl --system
  # Persistent journal so a first-boot kernel panic is debuggable next time (it wasn't).
  - mkdir -p /etc/systemd/journald.conf.d && printf '[Journal]\nStorage=persistent\n' > /etc/systemd/journald.conf.d/persistent.conf && systemctl restart systemd-journald
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  # BuildKit mirror builder (homelab#1308, see the buildkitd.toml write above for the design
  # note): `--driver-opt default-load=true` (buildx ≥0.14; get.docker.com's bundled buildx is
  # 0.37.0, live-verified 2026-09-05) makes the docker-container builder auto-`docker load` its
  # result, so existing `docker build && docker run`/`kind load docker-image` flows keep working
  # unmodified. Created for the `runner` user — the actions-runner systemd service's account
  # (`./svc.sh install runner` below) — because buildx state (`~/.docker/buildx`) is per-user;
  # both runner slots share it (same $HOME, live-verified: uid 1001, groups runner+docker).
  - su - runner -c 'docker buildx create --name homelab-mirrors --driver docker-container --driver-opt default-load=true --config /etc/buildkit/buildkitd.toml --use --bootstrap'
  - systemctl enable --now kind-janitor.timer
  # FU-015/ADR-082 parity: nix + devbox so the stacks' devbox-based gates (sleep `devbox run
  # test-integration`, oracle `e2e-kind`) run REPRODUCIBLY on this VM, not just the ARC runner —
  # same single-user install as docker/arc-runner/Dockerfile, owned by the sudo-less `runner`
  # (root does the /nix mkdir here; the user needs no sudo to USE it), LAN pull-through cache first.
  # devbox = pinned binary (not the install script, which floats to latest).
  - curl -fsSL "https://github.com/jetify-com/devbox/releases/download/0.17.5/devbox_0.17.5_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin devbox && chmod 0755 /usr/local/bin/devbox
  - install -d -m 0755 -o runner -g runner /nix
  - install -d -o runner -g runner /home/runner/.config/nix
  - printf 'experimental-features = nix-command flakes\nsubstituters = http://192.168.40.23 https://cache.nixos.org\n' > /home/runner/.config/nix/nix.conf && chown runner:runner /home/runner/.config/nix/nix.conf
  - su - runner -c 'curl -fsSL "https://releases.nixos.org/nix/nix-2.35.1/install" | sh -s -- --no-daemon --no-channel-add'
  # TWO runner slots (operator 2026-08-08): one e2e at a time serialized org-wide while 6 cores
  # sat at 17–26% — the e2e scripts are already run-scoped (oracle-e2e-$${GITHUB_RUN_ID}) so
  # concurrent runs on the shared docker daemon don't collide. Each slot is its own extracted
  # runner dir + its own systemd service; one boot-minted registration token registers both.
  - install -d -o runner -g runner /home/runner/actions-runner /home/runner/actions-runner-2
  - su - runner -c 'cd ~/actions-runner && curl -fsSL -o r.tar.gz https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-x64-${runner_version}.tar.gz && tar xzf r.tar.gz && rm r.tar.gz'
  - su - runner -c 'cp -a ~/actions-runner/. ~/actions-runner-2/'
  # The runner is a systemd service (non-login) → job steps don't source ~/.profile, so single-user
  # nix (~/.nix-profile) and devbox (/usr/local/bin) miss the PATH. The actions-runner `.env` is
  # loaded for every job step — put both on PATH there. `nix` must be present for `devbox run`.
  # Per-slot DOCKER_CONFIG + shared BUILDX_CONFIG + the job-started hook: see
  # runner-job-started.sh in write_files above (the stale-registry-login fix).
  - install -d -m 0700 -o runner -g runner /home/runner/.docker-slot-1 /home/runner/.docker-slot-2
  - |
    for slot in 1 2; do
      dir=/home/runner/actions-runner; [ "$slot" = 1 ] || dir=/home/runner/actions-runner-$slot
      printf 'PATH=/home/runner/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/runner/.local/bin\nDOCKER_CONFIG=/home/runner/.docker-slot-%s\nBUILDX_CONFIG=/home/runner/.docker/buildx\nACTIONS_RUNNER_HOOK_JOB_STARTED=/usr/local/bin/runner-job-started.sh\n' "$slot" > "$dir/.env"
      chown runner:runner "$dir/.env"
    done
  - |
    set -e
    TOKEN=$(GH_APP_ID='${app_id}' GH_APP_INSTALLATION_ID='${installation_id}' \
      GH_APP_PRIVATE_KEY_FILE=/etc/runner-app/private-key.pem GH_RUNNER_ORG='${org}' \
      /usr/local/bin/mint-runner-token.sh)
    su - runner -c "cd ~/actions-runner && ./config.sh --unattended --replace \
      --url https://github.com/${org} --token $TOKEN --name ${name} --labels '${labels}'"
    su - runner -c "cd ~/actions-runner-2 && ./config.sh --unattended --replace \
      --url https://github.com/${org} --token $TOKEN --name ${name}-2 --labels '${labels}'"
    cd /home/runner/actions-runner && ./svc.sh install runner && ./svc.sh start
    cd /home/runner/actions-runner-2 && ./svc.sh install runner && ./svc.sh start
