{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teststuff.net/agent-gateway/specs/endpoints/sessions.schema.json",
  "$comment": "MACHINE half of the /sessions contract; the HUMAN half (why/when, decision tables) is sessions.md. The service imports this file for request validation and the response/error envelopes — never re-declared in code. `x-requirements` couples shapes to requirement IDs; scripts/spec_gate.py fails CI on orphans in either direction and on `errors` keys the page never mentions.",
  "x-endpoint": "sessions",
  "x-use-cases": ["UC-1"],
  "$defs": {
    "stack": { "type": "string", "minLength": 1, "description": "AgentStack name (e.g. platform, oracle) — a key of the policy's `stacks`" },
    "role": { "type": "string", "enum": ["worker", "reviewer", "coordinator", "responder", "retro", "prober", "researcher"] },
    "tier": { "type": "string", "enum": ["light", "standard", "heavy"] },
    "harness": { "type": "string", "enum": ["claude", "opencode", "goose", "codex"] },
    "rail": { "type": "string", "enum": ["anthropic", "opencode", "openrouter"] },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "error_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "description": "a key of this file's `errors`" },
            "message": { "type": "string", "description": "one line, never containing a credential value", "x-requirements": ["GW-REDACT"] }
          }
        }
      }
    }
  },
  "post": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stack", "role", "task"],
      "properties": {
        "stack": { "$ref": "#/$defs/stack", "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "role": { "$ref": "#/$defs/role", "x-requirements": ["GW-SESSIONS-ADMIT", "GW-ACCESS"] },
        "task": { "type": "string", "minLength": 1, "description": "opaque task key (e.g. homelab-2588-r1); never a metric label", "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "round": { "type": "integer", "minimum": 0, "default": 0, "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "tier": { "$ref": "#/$defs/tier", "description": "default from policy roles.<role>.tier", "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "harness": { "$ref": "#/$defs/harness", "description": "default from policy roles.<role>.harness; fixes the dialect the walk may use", "x-requirements": ["GW-SESSIONS-ADMIT", "GW-SESSIONS-ENV"] },
        "rail": { "$ref": "#/$defs/rail", "description": "operator override — logged; normally absent", "x-requirements": ["GW-SESSIONS-ADMIT"] }
      }
    },
    "output": {
      "oneOf": [
        { "$ref": "#/post/dispatch" },
        { "$ref": "#/post/defer" }
      ]
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "session", "rail", "harness", "model", "env", "context_tokens"],
      "properties": {
        "decision": { "const": "dispatch" },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "token", "expires_at"],
          "properties": {
            "id": { "$ref": "#/$defs/session_id" },
            "token": { "type": "string", "pattern": "^gws_[A-Za-z0-9_-]{32}$", "description": "returned ONCE; stored only as sha256" },
            "expires_at": { "$ref": "#/$defs/timestamp" }
          },
          "x-requirements": ["GW-SESSIONS-TOKEN"]
        },
        "rail": { "$ref": "#/$defs/rail", "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "harness": { "$ref": "#/$defs/harness", "x-requirements": ["GW-SESSIONS-ADMIT"] },
        "model": { "type": "string", "description": "the policy id for (rail, tier) — the only place a model id comes from", "x-requirements": ["GW-SESSIONS-ADMIT", "GW-MODEL-RESOLVE"] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "the pod's COMPLETE LLM env for the harness; the launcher copies it verbatim",
          "x-requirements": ["GW-SESSIONS-ENV"]
        },
        "context_tokens": { "type": ["integer", "null"], "minimum": 1, "description": "the policy's declared window for the model; null = not declared, never a guess", "x-requirements": ["GW-SESSIONS-ENV"] }
      }
    },
    "defer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "retry_after_s"],
      "properties": {
        "decision": { "const": "defer" },
        "reason": {
          "type": "string",
          "enum": ["rail-capacity", "role-rail-denied", "stack-unknown", "credential-unresolved"],
          "x-requirements": ["GW-SESSIONS-ADMIT", "GW-CRED-RESOLVE"]
        },
        "retry_after_s": { "type": "integer", "minimum": 1 }
      },
      "x-requirements": ["GW-SESSIONS-ADMIT"]
    }
  },
  "get": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stack", "role", "task", "round", "rail", "harness", "model", "created_at", "expires_at", "released_at", "requests", "tokens_in", "tokens_out"],
      "properties": {
        "id": { "$ref": "#/$defs/session_id" },
        "stack": { "$ref": "#/$defs/stack" },
        "role": { "$ref": "#/$defs/role" },
        "task": { "type": "string" },
        "round": { "type": "integer", "minimum": 0 },
        "rail": { "$ref": "#/$defs/rail" },
        "harness": { "$ref": "#/$defs/harness" },
        "model": { "type": "string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "released_at": { "oneOf": [ { "$ref": "#/$defs/timestamp" }, { "type": "null" } ], "x-requirements": ["GW-SESSIONS-RELEASE"] },
        "requests": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 }
      },
      "x-requirements": ["GW-SESSIONS-TOKEN"]
    }
  },
  "delete": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "released_at"],
      "properties": {
        "id": { "$ref": "#/$defs/session_id" },
        "released_at": { "$ref": "#/$defs/timestamp" }
      },
      "x-requirements": ["GW-SESSIONS-RELEASE"]
    }
  },
  "errors": {
    "malformed-body": { "status": 400, "description": "the request body fails this schema's `post.input` (missing field, enum miss, negative round)", "x-requirements": ["GW-SESSIONS-ADMIT"] },
    "harness-rail-mismatch": { "status": 400, "description": "an explicit `harness` and `rail` whose dialects do not meet (claude x openrouter, opencode/goose x anthropic, codex x anything in v0)", "x-requirements": ["GW-SESSIONS-ADMIT"] },
    "session-not-found": { "status": 404, "description": "GET or DELETE on an id no row carries", "x-requirements": ["GW-SESSIONS-TOKEN", "GW-SESSIONS-RELEASE"] },
    "credential-transient": { "status": 503, "description": "the kube API failed or was unreachable while resolving a ref — nothing is known about the credential; retry", "x-requirements": ["GW-CRED-RESOLVE"] }
  }
}
