{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teststuff.net/agent-gateway/specs/endpoints/catalog.schema.json",
  "$comment": "MACHINE half of GET /catalog/opencode, GET /catalog/openrouter and of the normalised snapshots the two catalog legs keep in their store; the HUMAN half is catalog.md. GW-CATALOG-OR owns `openrouter_output`, `$defs.openrouter_snapshot` (the endpoint rows are openai-chat.schema.json $defs.endpoint_row), `$defs.catalog_block` and `$defs.canary_block` (the policy's two openrouter blocks), `$defs.cell_state`. Prices are $ per 1M tokens; a null cache rate = the vendor names none for that class. No error codes: the view answers 200, an absent snapshot is empty rows. A second rule, GW-MODEL-TIERS, owns $defs.benchmarks_snapshot (the committed tier-evidence snapshot, argocd/resources/agent-gateway/benchmarks.json) and $defs.tiers_block (the policy's derivation rules).",
  "x-endpoint": "catalog",
  "x-use-cases": ["UC-1"],
  "$defs": {
    "source": { "enum": ["config", "docs"] },
    "outcome": { "enum": ["ok", "fetch-failed", "parse-failed", "implausible"] },
    "plan": { "enum": ["go", "go-plus"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" },
    "rate": { "type": ["number", "null"], "minimum": 0 },
    "limit": {
      "description": "the plan's monthly limit in USD, \"unlimited\", or null = the page has no row for the model under the plan",
      "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unlimited" }, { "type": "null" }]
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetched_at", "age_s", "models", "last_outcome", "last_attempt_at"],
      "properties": {
        "fetched_at": { "$ref": "#/$defs/timestamp", "description": "the last good snapshot's fetch time; null = none yet" },
        "age_s": { "type": ["number", "null"] },
        "models": { "type": "integer", "minimum": 0 },
        "last_outcome": { "oneOf": [{ "$ref": "#/$defs/outcome" }, { "type": "null" }], "description": "null = no refresh attempted by this process yet" },
        "last_attempt_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "price_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out", "cache_read", "cache_write"],
      "properties": {
        "in": { "$ref": "#/$defs/rate" }, "out": { "$ref": "#/$defs/rate" },
        "cache_read": { "$ref": "#/$defs/rate" }, "cache_write": { "$ref": "#/$defs/rate" }
      }
    },
    "cost_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["above_tokens", "in", "out", "cache_read", "cache_write"],
      "properties": {
        "above_tokens": { "type": "integer", "minimum": 0, "description": "0 = the base row; N = the vendor's `tier: {type: context, size: N}` row" },
        "in": { "$ref": "#/$defs/rate" }, "out": { "$ref": "#/$defs/rate" },
        "cache_read": { "$ref": "#/$defs/rate" }, "cache_write": { "$ref": "#/$defs/rate" }
      }
    },
    "score_axis": { "enum": ["intelligence", "coding", "agentic"], "description": "the three Artificial Analysis indices of a capability row" },
    "cell_state": { "enum": ["candidate", "eligible", "excluded"], "description": "a (model, provider) cell's ENTRY state (GW-CATALOG-OR): new to the snapshot or back from exclusion → candidate; one canary ride completed clean on exactly that cell → eligible (the only state selection pins); a canary struck → excluded, with the class, for canary.cooldown_s" },
    "ranking_slice": { "enum": ["programming", "tool_calling"], "description": "the MCP list-daily-model-rankings slices the catalog may read (period week): a category and a modality" },
    "catalog_block": {
      "$comment": "the policy's `rails.openrouter.catalog` (GW-CATALOG-OR): the registry's SOURCES, never its candidates",
      "type": "object",
      "additionalProperties": false,
      "required": ["account_ref", "ranking_slices", "ranking_top_n"],
      "properties": {
        "account_ref": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9.-]+$", "description": "ns/name of the labelled Secret holding the openrouter ACCOUNT key the MCP reads ride (key OPENROUTER_API_KEY)" },
        "ranking_slices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ranking_slice" } },
        "ranking_top_n": { "type": "integer", "minimum": 1, "description": "per slice, the top N of the latest week by tokens" }
      },
      "x-requirements": ["GW-CATALOG-OR"]
    },
    "canary_block": {
      "$comment": "the policy's `rails.openrouter.canary` (GW-CATALOG-OR §The entry canary): who rides a canary and the cap — never code constants",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "harness", "max_per_refresh", "usd_per_day", "cooldown_s"],
      "properties": {
        "role": { "enum": ["worker", "reviewer", "coordinator", "responder", "retro", "prober", "researcher"] },
        "harness": { "enum": ["opencode", "goose", "claude"], "description": "the harness the openrouter cells serve; a canary body may name another the rail speaks" },
        "max_per_refresh": { "type": "integer", "minimum": 1, "description": "canary admissions between two catalog refreshes" },
        "usd_per_day": { "type": "number", "minimum": 0, "description": "metered canary spend over the trailing day, at the cell's endpoint price" },
        "cooldown_s": { "type": "number", "minimum": 0, "description": "an excluded cell is a candidate again after this" }
      },
      "x-requirements": ["GW-CATALOG-OR"]
    },
    "openrouter_snapshot": {
      "$comment": "the store's `catalog_snapshots.openrouter-endpoints` body as the catalog leg writes it (GW-CATALOG-OR) — openai-chat.schema.json $defs.endpoint_snapshot's `models` with the leg's provenance per model, plus `sources`",
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "sources"],
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["endpoints", "fetched_at", "ranking", "aa"],
            "properties": {
              "endpoints": { "type": "array", "minItems": 1, "description": "openai-chat.schema.json $defs.endpoint_row each" },
              "fetched_at": { "$ref": "#/$defs/timestamp" },
              "ranking": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "per slice the model ranked in, the latest week's tokens" },
              "aa": { "type": "object", "additionalProperties": false, "required": ["intelligence", "coding", "agentic"], "properties": { "intelligence": { "type": ["number", "null"] }, "coding": { "type": ["number", "null"] }, "agentic": { "type": ["number", "null"] } } }
            }
          }
        },
        "sources": {
          "type": "object", "additionalProperties": false, "required": ["ranking", "benchmarks", "candidates", "endpoint_failures"],
          "properties": {
            "ranking": { "type": "object", "additionalProperties": false, "required": ["slices", "top_n", "ranked"], "properties": { "slices": { "type": "array", "items": { "$ref": "#/$defs/ranking_slice" } }, "top_n": { "type": "integer" }, "ranked": { "type": "integer", "description": "distinct model ids across the slices' latest week" } } },
            "benchmarks": { "type": "object", "additionalProperties": false, "required": ["source", "as_of", "rows"], "properties": { "source": { "const": "artificial-analysis" }, "as_of": { "type": ["string", "null"] }, "rows": { "type": "integer" } } },
            "candidates": { "type": "integer", "description": "ranked ∩ benched" },
            "endpoint_failures": { "type": "integer", "description": "candidates whose endpoints could not be read this refresh (absent from it)" }
          }
        }
      },
      "x-requirements": ["GW-CATALOG-OR"]
    },
    "band": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "tiers_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "bands", "cap"],
      "properties": {
        "score": { "$ref": "#/$defs/score_axis" },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "standard", "heavy"],
          "properties": { "light": { "$ref": "#/$defs/band" }, "standard": { "$ref": "#/$defs/band" }, "heavy": { "$ref": "#/$defs/band" } },
          "description": "a candidate is in a tier when its score >= band x the rail's top score; heavy >= standard >= light"
        },
        "cap": { "type": "integer", "minimum": 1, "description": "each tier list keeps this many, cheapest-first" }
      },
      "x-requirements": ["GW-MODEL-TIERS"]
    },
    "candidate_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aa_id", "intelligence", "coding", "agentic", "out_price", "in_price", "monthly_limit_usd"],
      "properties": {
        "aa_id": { "type": ["string", "null"], "description": "the Artificial Analysis id the policy id joins (join_aa_id); null = unbenched" },
        "intelligence": { "type": ["number", "null"] }, "coding": { "type": ["number", "null"] }, "agentic": { "type": ["number", "null"] },
        "out_price": { "$ref": "#/$defs/rate", "description": "$ per 1M output tokens (the Go base cost row's out / OpenRouter pricing.completion x 1M); null = none (the subscription rail; a dynamic OpenRouter price)" },
        "in_price": { "$ref": "#/$defs/rate" },
        "monthly_limit_usd": { "$ref": "#/$defs/limit", "description": "the Go plan's monthly limit; null on the other rails" }
      }
    },
    "benchmarks_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_at", "sources", "rails"],
      "properties": {
        "snapshot_at": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "go_catalog", "openrouter_models"],
          "properties": {
            "capability": {
              "type": "object", "additionalProperties": false, "required": ["source", "pulled_at", "rows"],
              "properties": {
                "source": { "const": "artificial-analysis" },
                "pulled_at": { "$ref": "#/$defs/timestamp", "description": "the newest updated_ts of the old proxy's capability table" },
                "rows": { "type": "integer", "minimum": 0, "description": "the capability table's row count (the snapshot keeps only the candidates)" }
              }
            },
            "go_catalog": { "type": "object", "additionalProperties": false, "required": ["fetched_at"], "properties": { "fetched_at": { "$ref": "#/$defs/timestamp", "description": "GET /catalog/opencode sources.config.fetched_at" } } },
            "openrouter_models": { "type": "object", "additionalProperties": false, "required": ["fetched_at"], "properties": { "fetched_at": { "$ref": "#/$defs/timestamp" } } }
          }
        },
        "rails": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anthropic", "opencode", "openrouter"],
          "description": "per rail, the CANDIDATE rows keyed by POLICY model id (the rail's spelling: claude/<alias>, opencode-go/<id>, a bare openrouter id)",
          "properties": {
            "anthropic": { "type": "object", "additionalProperties": { "$ref": "#/$defs/candidate_row" } },
            "opencode": { "type": "object", "additionalProperties": { "$ref": "#/$defs/candidate_row" } },
            "openrouter": { "type": "object", "additionalProperties": { "$ref": "#/$defs/candidate_row" } }
          }
        }
      },
      "x-requirements": ["GW-MODEL-TIERS"]
    },
    "config_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "family", "tools", "context", "output", "cost"],
            "properties": {
              "name": { "type": ["string", "null"] }, "family": { "type": ["string", "null"] },
              "tools": { "type": "boolean" },
              "context": { "type": "integer" }, "output": { "type": "integer" },
              "cost": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cost_tier" } }
            }
          }
        }
      },
      "x-requirements": ["GW-CATALOG-GO"]
    },
    "docs_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plans", "bonus", "peak", "peak_hours_utc", "peak_weekdays", "window_shares"],
      "properties": {
        "plans": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go", "go-plus"],
          "properties": {
            "go": { "type": "object", "additionalProperties": { "$ref": "#/$defs/limit" } },
            "go-plus": { "type": "object", "additionalProperties": { "$ref": "#/$defs/limit" } }
          }
        },
        "bonus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "peak": { "type": "object", "additionalProperties": { "$ref": "#/$defs/price_row" } },
        "peak_hours_utc": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2 } },
        "peak_weekdays": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
        "window_shares": {
          "type": "object",
          "additionalProperties": false,
          "required": ["5h", "7d", "30d"],
          "properties": { "5h": { "type": "number" }, "7d": { "type": "number" }, "30d": { "type": "number" } }
        }
      },
      "x-requirements": ["GW-CATALOG-GO"]
    }
  },
  "openrouter_output": {
    "$comment": "GET /catalog/openrouter — the OpenRouter catalog's read-only view (GW-CATALOG-OR): the snapshot with every cell's entry state, the provider the data plane would pin per model, the canary budget; no auth, no error codes (no snapshot = empty models)",
    "type": "object",
    "additionalProperties": false,
    "required": ["fetched_at", "age_s", "models_count", "last_outcome", "last_attempt_at", "refresh_s", "sources", "endpoint_failures", "models", "cells", "canary"],
    "properties": {
      "fetched_at": { "$ref": "#/$defs/timestamp" },
      "age_s": { "type": ["number", "null"] },
      "models_count": { "type": "integer", "minimum": 0 },
      "last_outcome": { "oneOf": [{ "$ref": "#/$defs/outcome" }, { "type": "null" }] },
      "last_attempt_at": { "$ref": "#/$defs/timestamp" },
      "refresh_s": { "type": "number" },
      "sources": { "type": "object", "description": "the snapshot's `sources` (empty before the first good refresh)" },
      "endpoint_failures": { "type": "integer" },
      "models": {
        "type": "object",
        "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["ranking", "aa", "fetched_at", "endpoints", "selected", "order", "cells"],
          "properties": {
            "ranking": { "type": "object" }, "aa": { "type": "object" }, "fetched_at": { "$ref": "#/$defs/timestamp" },
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["slug", "tag", "provider_name", "quantization", "tool_choice", "uptime_1d", "p90_ms", "in_price", "out_price", "status", "service_tier", "state", "class", "cooldown_until"],
                "properties": {
                  "slug": { "type": "string" }, "tag": { "type": "string" }, "provider_name": { "type": "string" }, "quantization": { "type": "string" },
                  "tool_choice": { "type": "object" }, "uptime_1d": { "type": "number" }, "p90_ms": { "type": ["number", "null"] },
                  "in_price": { "type": ["number", "null"] }, "out_price": { "type": ["number", "null"] }, "status": { "type": "integer" }, "service_tier": { "type": ["string", "null"] },
                  "state": { "$ref": "#/$defs/cell_state" }, "class": { "type": ["string", "null"], "description": "the strike class that excluded the cell" }, "cooldown_until": { "$ref": "#/$defs/timestamp" }
                }
              }
            },
            "selected": { "type": ["string", "null"], "description": "the provider the data plane would pin first (GW-RAIL-OPENROUTER §Selection over the ELIGIBLE cells, the canary harness); null = none eligible — the model rides unpinned" },
            "order": { "type": "array", "items": { "type": "string" } },
            "cells": { "type": "object", "additionalProperties": false, "required": ["candidate", "eligible", "excluded"], "properties": { "candidate": { "type": "integer" }, "eligible": { "type": "integer" }, "excluded": { "type": "integer" } } }
          }
        }
      },
      "cells": { "type": "object", "additionalProperties": false, "required": ["candidate", "eligible", "excluded"], "properties": { "candidate": { "type": "integer" }, "eligible": { "type": "integer" }, "excluded": { "type": "integer" } } },
      "canary": {
        "type": "object", "additionalProperties": false,
        "required": ["max_per_refresh", "usd_per_day", "admitted_this_refresh", "spend_usd_1d", "exhausted", "cooldown_s"],
        "properties": {
          "max_per_refresh": { "type": ["integer", "null"] }, "usd_per_day": { "type": ["number", "null"] }, "admitted_this_refresh": { "type": "integer" },
          "spend_usd_1d": { "type": "number" }, "exhausted": { "type": "boolean" }, "cooldown_s": { "type": ["number", "null"] }
        }
      }
    },
    "x-requirements": ["GW-CATALOG-OR"]
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["plan", "sources", "peak_hours_utc", "peak_weekdays", "window_shares", "models", "policy_models"],
    "properties": {
      "plan": { "oneOf": [{ "$ref": "#/$defs/plan" }, { "type": "null" }], "description": "rails.opencode.plan; null = the policy has no opencode rail" },
      "sources": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config", "docs"],
        "properties": {
          "config": { "$ref": "#/$defs/source_state" },
          "docs": { "$ref": "#/$defs/source_state" }
        }
      },
      "peak_hours_utc": { "$ref": "#/$defs/docs_snapshot/properties/peak_hours_utc" },
      "peak_weekdays": { "$ref": "#/$defs/docs_snapshot/properties/peak_weekdays" },
      "window_shares": { "type": "object" },
      "models": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["listed", "family", "tools", "context", "output", "cost", "peak", "bonus", "monthly_limit_usd", "windows_usd"],
          "properties": {
            "listed": { "type": "boolean", "description": "in the config snapshot (the account's listed set — not a liveness signal)" },
            "family": { "type": ["string", "null"] }, "tools": { "type": ["boolean", "null"] },
            "context": { "type": ["integer", "null"] }, "output": { "type": ["integer", "null"] },
            "cost": { "type": "array", "items": { "$ref": "#/$defs/cost_tier" } },
            "peak": { "oneOf": [{ "$ref": "#/$defs/price_row" }, { "type": "null" }] },
            "bonus": { "type": ["integer", "null"] },
            "monthly_limit_usd": { "$ref": "#/$defs/limit" },
            "windows_usd": { "type": ["object", "null"], "description": "window_shares x the plan's monthly limit; null when the limit is not a number" }
          }
        }
      },
      "policy_models": {
        "type": "object",
        "description": "every opencode model the policy names (tiers + side_models), by wire id",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["listed", "monthly_limit_usd"],
          "properties": { "listed": { "type": "boolean" }, "monthly_limit_usd": { "$ref": "#/$defs/limit" } }
        }
      }
    },
    "x-requirements": ["GW-CATALOG-GO"]
  },
  "errors": {}
}
