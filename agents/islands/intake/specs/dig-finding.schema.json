{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teststuff.net/homelab/agents/islands/intake/specs/dig-finding.schema.json",
  "$comment": "MACHINE half of the dig-finding/v1 record; the HUMAN half is dig-finding.md. The session prints the block (fields up to tool_gaps); agents/deep-dig-select.sh harvest validates schema/group/verdict and adds ts, run, members. Spike (2026-11-07): the harvest checks three fields with jq and does not import this file.",
  "x-interface": "dig-finding",
  "x-use-cases": [],
  "type": "object",
  "required": ["schema", "group", "verdict", "ts", "run", "members"],
  "properties": {
    "schema": { "const": "dig-finding/v1", "x-requirements": ["INTAKE-DIG-FINDING"] },
    "group": { "type": "string", "description": "the digest group key verbatim (<onset>|<host>)", "x-requirements": ["INTAKE-DIG-FINDING"] },
    "alerts": { "type": "array", "items": { "type": "string", "description": "<alertname> (<subject>) — the session's prose; the legacy re-dig fallback" } },
    "verdict": { "enum": ["explained", "unexplained", "cause-found", "fix-proposed"], "x-requirements": ["INTAKE-DIG-FINDING", "INTAKE-SELECT-DIG"] },
    "cause": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string", "description": "<read> → <what it showed>" } },
    "recommendation": { "type": "string", "description": "the one next action and who takes it, or empty", "x-requirements": ["INTAKE-DIG-OUTPUT"] },
    "pr": { "type": "string", "description": "<repo>#<n> of the one mechanical, bot-mergeable PR, or empty", "x-requirements": ["INTAKE-DIG-OUTPUT"] },
    "related": { "type": "array", "items": { "type": "string", "description": "<repo>#<n> or FU-NNN — the existing record cited instead of duplicated" }, "x-requirements": ["INTAKE-DIG-OUTPUT"] },
    "tool_gaps": { "type": "array", "items": { "type": "string" } },
    "ts": { "type": "string", "format": "date-time", "description": "stamped by the harvest (DIG_TS)", "x-requirements": ["INTAKE-DIG-FINDING"] },
    "run": { "type": "string", "pattern": "^(dig-[0-9]{4}-[0-9]{2}-[0-9]{2}/dig-r1-[0-9]{8}T[0-9]{6}Z)?$", "description": "stamped by the harvest (DIG_RUN)", "x-requirements": ["INTAKE-DIG-FINDING"] },
    "members": {
      "type": "array",
      "description": "the {alertname, subject} pairs of the run's own digest group — the re-dig key; [] when the group is not in the digest",
      "items": { "type": "object", "required": ["alertname", "subject"], "properties": { "alertname": { "type": "string" }, "subject": { "type": "string" } } },
      "x-requirements": ["INTAKE-DIG-FINDING", "INTAKE-DIG-EXPLAINED"]
    }
  },
  "x-object-key": "homelab/dig-<date>/dig-r1-<ts>/finding-<N>.json",
  "exit": {
    "0": { "description": "≥ 1 block validated and was written", "x-requirements": ["INTAKE-DIG-FINDING"] },
    "1": { "description": "no valid block — the transcript is the only record", "x-requirements": ["INTAKE-DIG-FINDING"] }
  }
}
