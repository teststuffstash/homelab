{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teststuff.net/islands/review/specs/sentinel.schema.json",
  "$comment": "MACHINE half of the IAC-G04 sentinel's interface; the HUMAN half is sentinel.md. IAC-G04's design is docs/agents/iac-lane.md §L0b.",
  "x-interface": "sentinel",
  "x-use-cases": [],
  "type": "object",
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "context", "description"],
      "properties": {
        "state": { "enum": ["success", "failure", "error"] },
        "context": { "const": "iac-sentinel" },
        "description": {
          "enum": [
            "0 violations (kyverno + gitleaks + path-rule)",
            "sentinel probe failed (engine tool error) — retries next tick",
            "sentinel probe failed — retries next tick"
          ],
          "description": "or `<N> violation(s) — details in the iac-sentinel workflow logs` on failure"
        }
      },
      "x-requirements": ["REVIEW-SENTINEL-STATUS"]
    },
    "path_rule": {
      "type": "object",
      "properties": {
        "author": { "const": "app/homelab-agents-1234" },
        "paths": { "const": ["^\\.github/workflows/", "^scripts/ci"] },
        "rule": { "const": "workflow-touch" },
        "exempt": { "enum": ["master-reachable", "revert-wf-chain"] }
      },
      "x-requirements": ["REVIEW-SENTINEL-PATHRULE"]
    },
    "engines": {
      "type": "object",
      "properties": {
        "kyverno": { "type": "object", "properties": { "policies": { "const": "policy/iac/*.yaml" }, "exceptions": { "const": "policy/iac/exceptions/<repo>.yaml (the sentinel's own clone)" }, "audit": { "const": "warn, never counted" } } },
        "gitleaks": { "type": "object", "properties": { "config": { "const": "policy/iac/gitleaks.toml" } } },
        "rule_label": { "enum": ["workflow-touch", "kyverno", "gitleaks"] }
      },
      "x-requirements": ["REVIEW-SENTINEL-ENGINES"]
    },
    "smoke_exit": {
      "enum": [0, 1, 2],
      "description": "0 clean · 1 a policy/secret violation in the local tree · 2 an engine could not run (or the tree build failed)",
      "x-requirements": ["REVIEW-SENTINEL-SMOKE"]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "iac_sentinel_last_run_timestamp_seconds": { "type": "number", "description": "cron/edge tick only, never --tree / --smoke" },
        "iac_sentinel_wake_cron_timestamp_seconds": { "type": "number" },
        "iac_sentinel_wake_edge_timestamp_seconds": { "type": "number" },
        "iac_sentinel_violations": { "description": "{repo, pr, rule}" },
        "iac_sentinel_probe_failed": { "description": "{repo, pr}" },
        "iac_sentinel_engine_seconds": { "description": "{engine: fetch|path|collect|kyverno|gitleaks, repo, pr}" },
        "iac_sentinel_cron_serviced_timestamp_seconds": { "description": "{repo, pr} — a missed edge ring" }
      },
      "x-requirements": ["REVIEW-SENTINEL-STATUS"]
    }
  }
}
