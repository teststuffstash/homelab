#!/bin/sh
# Fixture-backed `gh`, installed on $PATH ahead of the real one by agents/replay/run.sh.
#
# Reads (`pr view`, `pr list`, `issue view`, `api` without a method) are answered from the fixture's
# world/gh/ recordings. Writes (`pr comment`, `issue edit`, `api -X POST`, …) are RECORDED and
# return success — they are the actions the fixture asserts on, so serving them a reply would be
# testing GitHub instead of the clause.
#
# No network, no credentials, no token: every call either hits a committed file or dies.
set -u
_RP_TOOL=gh
. "${REPLAY_STUB_DIR:?agents/replay/run.sh must export REPLAY_STUB_DIR}/_common.sh"

_rp_record "$@"
WORDS="$(_rp_words "$@")"
[ -n "$WORDS" ] || _rp_die "bare \`gh\` with no subcommand — nothing to key a world file on."

# `--json` FIELD VALIDATION (the #2333 class): the real gh refuses an unknown field BEFORE any
# network call (`Unknown JSON field: "lastEditedAt"` + the available list, exit 1) — and on
# 2026-10-06 that refusal aborted every stack's review tick while this fake, serving any field list,
# kept every fixture green. So the fake refuses exactly as gh does, from the allowlist GENERATED
# out of the pinned gh (gh-json-fields.tsv, by ../gh-json-fields.sh; its --check reds on a gh bump).
# Checked first, ahead of failure injection: gh validates flags before it can fail on the wire.
_rp_json=''; PREV=''
for a in "$@"; do
  case "$PREV" in --json) _rp_json="$a" ;; esac
  case "$a" in --json=*) _rp_json="${a#--json=}" ;; esac
  PREV="$a"
done
if [ -n "$_rp_json" ]; then
  _rp_cmd="$(printf '%s\n' "$WORDS" | awk '{print $1, $2}')"
  _rp_ff="$REPLAY_STUB_DIR/gh-json-fields.tsv"
  [ -f "$_rp_ff" ] || _rp_die "missing $_rp_ff — regenerate: devbox run gh-json-fields -- --write"
  _rp_allowed="$(awk -F'\t' -v c="$_rp_cmd" '$1 == c { print $2 }' "$_rp_ff")"
  [ -n "$_rp_allowed" ] || _rp_die "\`gh $_rp_cmd --json\` has no field list in gh-json-fields.tsv — add the subcommand to agents/replay/gh-json-fields.sh and regenerate"
  _rp_bad="$(printf '%s\n' "$_rp_json" | tr ',' '\n' | awk -v ok=",$_rp_allowed," 'NF && index(ok, "," $0 ",") == 0 { print; exit }')"
  if [ -n "$_rp_bad" ]; then
    printf 'Unknown JSON field: "%s"\nAvailable fields:\n' "$_rp_bad" >&2
    printf '%s\n' "$_rp_allowed" | tr ',' '\n' | sed 's/^/  /' >&2
    exit 1
  fi
fi

# Per-call failure injection (homelab#740): STUB_GH_<slugged-world-key> overrides the run-global
# $STUB_GH for ONE named call, evaluated for BOTH reads and writes. The slug is the same bare-words
# slug _rp_serve uses. Supports the same values as $STUB_GH plus `empty` (empty stdout, exit 0).
SLUG="$(_rp_slug "$WORDS")"
PC_OVERRIDE="$(_rp_per_call_override "$SLUG")" || PC_OVERRIDE=''
if [ -n "$PC_OVERRIDE" ]; then
  case "$PC_OVERRIDE" in
    fail)    printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1 ;;
    empty)   exit 0 ;;
    body404) printf 'gh: Not Found (HTTP 404)\n';     exit 0 ;;
    garbage) printf 'upstream connect error or disconnect/reset before headers\n'; exit 0 ;;
    *)       _rp_die "unknown per-call override value: $PC_OVERRIDE (want fail|empty|body404|garbage)" ;;
  esac
fi

# `gh api` is read-or-write depending on --method/-X; everything else keys off the verb.
IS_API_WRITE=0; IS_API_PAGINATE=0; PREV=''
[ "${WORDS%% *}" = api ] && for a in "$@"; do
  case "$PREV" in
    -X|--method) [ "$a" = GET ] || IS_API_WRITE=1 ;;
  esac
  case "$a" in
    -XGET|--method=GET) ;;
    -X?*|--method=*)    IS_API_WRITE=1 ;;
    -f|--field|-F|--raw-field|--input) IS_API_WRITE=1 ;;   # gh api implies POST once a field is set
    --paginate)         IS_API_PAGINATE=1 ;;
  esac
  PREV="$a"
done
# `gh api graphql` always carries -f/-F (query=, variables), which the loop above reads as a write.
# A graphql QUERY is a READ — it must be served from the world (and DIE unrecorded, like any read);
# only an operation that is a `mutation` is recorded-and-succeeds.
case "$WORDS" in
  'api graphql'|'api graphql '*)
    IS_API_WRITE=0
    for a in "$@"; do
      case "$a" in
        query=*) case "$(printf '%s' "${a#query=}" | tr -d ' \t\n')" in mutation*) IS_API_WRITE=1 ;; esac ;;
      esac
    done
    ;;
esac

MUTATING_VERBS="comment edit close reopen merge review ready create delete rename transfer lock
unlock pin unpin sync develop checkout add remove set"

if [ "${IS_API_WRITE:-0}" = 1 ] || _rp_is_mutation "$MUTATING_VERBS" "$WORDS"; then
  # A mutation MAY still have a recording (gh prints the new comment's URL, and a clause that pipes
  # it somewhere needs one) — but its absence is fine, unlike a read's.
  _rp_serve "$WORDS" optional || true
  exit 0
fi

# $STUB_GH (run-global) lets a fixture replay the failure modes a guarded probe must survive without
# recording a separate world: `fail` = non-zero (403/404/network), `body404` = gh's error text on
# STDOUT with exit 0 (the shape that turns an error string into a fingerprint if the caller skips
# `jq -e`), `garbage` = a 200 that is not JSON at all.
# Per-call STUB_GH_<slug> (homelab#740) is checked FIRST, above the read/write split — see the
# SLUG/PC_OVERRIDE block. Run-global $STUB_GH only applies when no per-call override is set.
case "${STUB_GH:-ok}" in
  fail)    printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1 ;;
  body404) printf 'gh: Not Found (HTTP 404)\n';     exit 0 ;;
  garbage) printf 'upstream connect error or disconnect/reset before headers\n'; exit 0 ;;
esac

# `gh --jq/-q` is EVALUATED here, not ignored. Serving the raw payload to a clause that asked for
# one field hands it the whole JSON blob, and a clause that then "works" is a fixture pinning
# nonsense — the responder's verdict half reads an issue NUMBER out of a list this way and would
# have gone on to fetch `issues/<the entire array>`. Nothing in the tree needed it before because
# coordinator-scan.sh's standing rule is to pipe to a REAL jq (`gh --jq` takes only an expression);
# the responder's embedded script does not follow that rule, and pinning it is what surfaced this.
# gh's own --jq is raw output, hence `jq -r`.
_rp_jq=''; PREV=''
for a in "$@"; do
  case "$PREV" in --jq|-q) _rp_jq="$a" ;; esac
  case "$a" in --jq=*) _rp_jq="${a#--jq=}" ;; esac
  PREV="$a"
done
if [ -n "$_rp_jq" ]; then
  command -v jq >/dev/null 2>&1 || _rp_die "a clause passed --jq but jq is not on PATH (run via devbox)"
  # Served into a variable, NOT piped: `_rp_serve`'s exit 9 for an unrecorded READ would only kill
  # the left half of a pipeline, and a silently-empty read is the exact lie that whole guard exists
  # to prevent.
  _rp_paginate_flag=""; [ "${IS_API_PAGINATE:-0}" = 1 ] && _rp_paginate_flag="paginate"
  _rp_body="$(_rp_serve "$WORDS" "$_rp_paginate_flag")" || exit 9
  printf '%s' "$_rp_body" | jq -r "$_rp_jq"
  exit $?
fi

_rp_paginate_flag=""; [ "${IS_API_PAGINATE:-0}" = 1 ] && _rp_paginate_flag="paginate"
_rp_serve "$WORDS" "$_rp_paginate_flag"
