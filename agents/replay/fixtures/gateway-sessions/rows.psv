# gateway-sessions — the decision table (family contract in fixture.yaml). Row state (the stack
# row, argv flags, the gateway's reply) lives in rows/<id>/vars.sh.
# id                           | world | patch | env                                       | expect                       | params
off                            |       |       |                                           | off                          |
other-stack                    |       |       | AGENT_GATEWAY=sessions                    | other-stack                  |
model-refused                  |       |       | AGENT_GATEWAY=sessions                    | model-refused                |
round-refused                  |       |       | AGENT_GATEWAY=sessions                    | round-refused                |
interactive-refused            |       |       | AGENT_GATEWAY=sessions                    | interactive-refused          |
dispatch-opencode              |       |       | AGENT_GATEWAY=sessions AGENT_GATEWAY_RAIL=opencode | dispatch-opencode   |
dispatch-claude-explicit       |       |       | AGENT_GATEWAY=sessions                    | dispatch-claude-explicit     |
dispatch-claude-subscription   |       |       | AGENT_GATEWAY=sessions                    | dispatch-claude-subscription |
dispatch-goose                 |       |       | AGENT_GATEWAY=sessions AGENT_GATEWAY_URL=http://127.0.0.1:18080 | dispatch-goose |
dispatch-codex                 |       |       | AGENT_GATEWAY=sessions AGENT_GATEWAY_ROLE=prober | dispatch-codex               |
defer                          |       |       | AGENT_GATEWAY=sessions                    | defer                        |
http-503                       |       |       | AGENT_GATEWAY=sessions                    | http-503                     |
unreachable                    |       |       | AGENT_GATEWAY=sessions                    | unreachable                  |
unknown-decision               |       |       | AGENT_GATEWAY=sessions                    | unknown-decision             |
unusable-env                   |       |       | AGENT_GATEWAY=sessions                    | unusable-env                 |
credential-in-answer           |       |       | AGENT_GATEWAY=sessions                    | credential-in-answer         |
bad-pull-url                   |       |       | AGENT_GATEWAY=sessions                    | bad-pull-url                 |
caller-minted                  |       |       | AGENT_GATEWAY=sessions AGENT_GATEWAY_RAIL=opencode AGENT_GATEWAY_CALLER_SA=platform-agents/agentstack-loop | caller-minted |
caller-mint-fails              |       |       | AGENT_GATEWAY=sessions AGENT_GATEWAY_CALLER_SA=platform-agents/agentstack-loop | caller-mint-fails |
