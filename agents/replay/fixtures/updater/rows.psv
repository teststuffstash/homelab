# updater — the decision table (family contract in fixture.yaml; legs 1-3).
# id                  | world | patch (relpath @ patches/*.jq)          | env | expect        | params
# The *-probeN templates carry leg 1's per-candidate `gh pr view --json commits` (p1, p2 in list
# order) — the commits live in rows/<id>/gh/pr-view-<n>.json, never in pr-list.json (the field
# is not listable at --limit 100: GitHub's 500k-node cap, 2026-09-08).
armed-only-noop       | board |                                         |     | noop          |
fifo-pick             | board | gh/pr-list.json @ patches/add-two-behind-ready.jq |  | picks-probe2 | p1=101 p2=102 n=101 oid=abc123def456
# ── homelab#2203: the lane's OLDEST merge-ready member is WEDGED (its update-branch 422s every
# pass, so `updatedAt` never moves and it re-enters as the pick forever) — the younger member must
# still be picked in the SAME pass. Same world as `fifo-pick` (two merge-ready PRs on one master
# lane, #101 older), differing only in the injected 422 on #101's PUT: the axis is the oldest
# member's update OUTCOME (clears → `fifo-pick`; stuck → this row). RED on the pre-#2203 source,
# which took `.[0]` per lane and stopped after the failed attempt.
lane-hop-wedged-oldest | board | gh/pr-list.json @ patches/add-two-behind-ready.jq | STUB_GH_api_repos_teststuffstash_testrepo_pulls_101_update_branch=fail | lane-hop | p1=101 p2=102 n1=101 oid1=abc123def456 n2=102 oid2=789012ghi345
unstrand-yes          | board | gh/pr-list.json @ patches/add-cr-behind.jq  |  | unstrand-yes  | n=120 oid=jkl012mno345
unstrand-no           | board | gh/pr-list.json @ patches/add-cr-behind.jq  |  | unstrand-no   | n=120
unstrand-unreadable   | board | gh/pr-list.json @ patches/add-cr-behind.jq  |  | unstrand-hold | n=120
conflict-dirty        | board | gh/pr-list.json @ patches/dirty-90.jq       |  | dirty-label   | n=90
conflict-clear        | board | gh/pr-list.json @ patches/label-conflict-90.jq | | label-clear | n=90
update-fail           | board | gh/pr-list.json @ patches/conflict-101.jq  | STUB_GH_api_repos_teststuffstash_testrepo_pulls_101_update_branch=fail | update-fail |
park-skip             | board | gh/pr-list.json @ patches/add-park-skip.jq       |     | noop          |
human-approved-pick   | board | gh/pr-list.json @ patches/add-human-approved.jq  |     | picks         | n=131 oid=human131oid456
null-author-no-crash   | board | gh/pr-list.json @ patches/add-null-author.jq      |     | noop          |
two-lanes-two-updates | board | gh/pr-list.json @ patches/add-two-lanes.jq          |     | picks-two-probe2 | p1=101 p2=110 n1=110 oid1=goal110oid789 n2=101 oid2=abc123def456
same-lane-one-update  | board | gh/pr-list.json @ patches/add-two-same-goal-lane.jq |     | picks-probe2  | p1=110 p2=111 n=110 oid=goal110oid789
# ── #1452: leg 1 updates only MERGE-READY PRs (the platform-native merge queue) ─────────────────
unreviewed-behind-no-update | board | gh/pr-list.json @ patches/add-two-behind.jq         |                             | noop  |
bot-approved-head-update    | board | gh/pr-list.json @ patches/add-bot-approved-head.jq  |                             | picks-probe1 | p1=141 n=141 oid=ready141oid123
stale-approval-no-update    | board | gh/pr-list.json @ patches/add-bot-approved-stale.jq |                             | noop-probe1 | p1=142
probe-unreadable            | board | gh/pr-list.json @ patches/add-bot-approved-head.jq  |                             | noop-probe-hold | p1=141
merge-ready-only-off-legacy-pick | board | gh/pr-list.json @ patches/add-two-behind.jq    | UPDATER_MERGE_READY_ONLY=0  | picks | n=101 oid=abc123def456
parked-approved-head-no-update | board | gh/pr-list.json @ patches/add-parked-approved-head.jq | | noop |
# ── ADR-141 (minted in homelab PR#2003 — GitHub Actions majors merge on their own; this carve-out is one of its consequences): Renovate owns the currency of its UNTOUCHED GROUPED-ACTIONS branches (the two rules with
# rebaseWhen behind-base-branch); any other Renovate class still rides this updater (PR#2004 review) ─
renovate-untouched-no-update   | board | gh/pr-list.json @ patches/add-renovate-approved.jq  |     | renovate-skip-probe1 | p1=150
renovate-worker-pushed-update  | board | gh/pr-list.json @ patches/add-renovate-approved.jq  |     | picks-probe1  | p1=150 n=150 oid=ren150oid789
renovate-untouched-cr-no-update | board | gh/pr-list.json @ patches/add-renovate-cr-behind.jq |     | unstrand-renovate-skip | n=151
renovate-other-class-update    | board | gh/pr-list.json @ patches/add-renovate-other-class.jq |     | picks         | n=152 oid=ren152oid789
# Login shape (homelab#2007): the rows carry the REAL `app/homelab-renovate-1234` list shape — the raw-prefix
# test missed it and the updater edited a live grouped-Actions branch; `renovate-untouched-cr-no-update`
# keeps the plain `homelab-renovate-1234[bot]` shape so both spellings stay pinned.
