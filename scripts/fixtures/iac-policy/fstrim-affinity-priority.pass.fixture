# The post-#2404 node-fstrim shape: hostname nodeAffinity + node-maintenance PriorityClass → passes.
apiVersion: batch/v1
kind: CronJob
metadata: { name: fstrim-guard-wk-01, namespace: node-maintenance }
spec:
  schedule: "3,18,33,48 * * * *"
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: Never
          priorityClassName: node-maintenance
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - { key: kubernetes.io/hostname, operator: In, values: [wk-01] }
          tolerations: [{ operator: Exists }]
          containers: [{ name: fstrim-guard, image: alpine:3.24 }]
