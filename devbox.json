{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "opentofu": {
      "version": "latest"
    },
    "kubectl": {
      "version": "latest"
    },
    "talosctl": {
      "version": "latest"
    },
    "kubernetes-helm": {
      "version": "latest"
    },
    "cilium-cli": {
      "version": "latest"
    },
    "hubble": {
      "version": "latest"
    },
    "k9s": {
      "version": "latest"
    },
    "ansible": {
      "version": "latest"
    },
    "sops": {
      "version": "latest"
    },
    "age": {
      "version": "latest"
    },
    "jq": {
      "version": "latest"
    },
    "nodejs_22": {
      "version": "latest"
    },
    "python3": {
      "version": "latest"
    },
    "nmap": {
      "version": "latest"
    },
    "curl": {
      "version": "latest"
    },
    "cloudflared": {
      "version": "latest"
    },
    "yq-go": {
      "version": "latest"
    },
    "bind": {
      "version": "latest"
    },
    "netcat-gnu": {
      "version": "latest"
    },
    "awscli2": {
      "version": "latest"
    },
    "openssl": {
      "version": "latest"
    },
    "tea": {
      "version": "latest"
    },
    "keepassxc": {
      "version": "latest"
    },
    "kyverno": {
      "version": "latest"
    },
    "gitleaks": {
      "version": "latest"
    },
    "wireguard-tools": {
      "version": "latest"
    },
    "qrencode": {
      "version": "latest"
    },
    "argocd": {
      "version": "latest"
    },
    "argo-workflows": {
      "version": "latest"
    },
    "infisical": {
      "version": "latest"
    },
    "gh": {
      "version": "latest"
    },
    "kubeconform": {
      "version": "latest"
    },
    "prometheus": {
      "version": "latest",
      "outputs": [
        "cli"
      ]
    }
  },
  "env": {
    "TALOSCONFIG": "$PWD/tofu/talosconfig",
    "KUBECONFIG": "$PWD/tofu/kubeconfig",
    "VENV_DIR": "$HOME/.cache/devbox-venv/homelab"
  },
  "shell": {
    "init_hook": [],
    "scripts": {
      "tf-validate": [
        "tofu -chdir=tofu init -backend=false -input=false",
        "tofu -chdir=tofu validate"
      ],
      "tf-plan": [
        "sh scripts/tf.sh plan \"$@\""
      ],
      "tf-apply": [
        "sh scripts/tf.sh apply \"$@\""
      ],
      "labels-handoff": [
        "bash scripts/labels-handoff.sh \"$@\""
      ],
      "tofu-state-migrate": [
        "bash scripts/tofu-state-migrate.sh \"$@\""
      ],
      "garage-backup": [
        "bash scripts/garage-backup.sh \"$@\""
      ],
      "github-secrets-sync": [
        "bash scripts/github-secrets-sync.sh \"$@\""
      ],
      "github-tofu": [
        "tofu -chdir=tofu/github init -input=false",
        "sh scripts/github-tf.sh \"$@\""
      ],
      "cloudflare-token-tofu": [
        "tofu -chdir=tofu/cloudflare-token init -input=false",
        "sh scripts/cloudflare-token-tf.sh \"$@\""
      ],
      "github-apps": [
        "bash scripts/github-apps.sh"
      ],
      "agents-registration-lint": [
        "bash scripts/agents-registration-lint.sh"
      ],
      "argocd-validate-pins": [
        "bash scripts/argocd-validate-pins.sh"
      ],
      "pin-only-lint": [
        "bash scripts/pin-only-lint.sh \"$@\""
      ],
      "goal-findings-self-test": [
        "bash agents/goal-findings.sh --self-test"
      ],
      "governance-lint": [
        "bash scripts/governance-lint.sh \"$@\""
      ],
      "manifest-lint": [
        "bash scripts/manifest-lint.sh \"$@\""
      ],
      "sentinel-smoke": [
        "bash scripts/iac-sentinel.sh --smoke"
      ],
      "machines-lint": [
        "bash scripts/machines-lint.sh"
      ],
      "prometheus-rules-lint": [
        "bash scripts/prometheus-rules-lint.sh"
      ],
      "responder-behaviour-test": [
        "bash agents/coordinator/responder-behaviour-test.sh \"$@\""
      ],
      "py-compile-lint": [
        "bash scripts/py-compile-lint.sh"
      ],
      "rail-degrade-replay": [
        "bash agents/rail-degrade-replay.sh"
      ],
      "prompt-transport-lint": [
        "python3 scripts/prompt-transport-lint.py \"$@\""
      ],
      "state-fp-replay": [
        "bash agents/state-fp-replay.sh"
      ],
      "diff-ci": [
        "bash scripts/diff-ci.sh \"$@\""
      ],
      "clause-replay": [
        "bash agents/replay/run.sh"
      ],
      "exporter-self-test": [
        "python3 argocd/resources/github-exporter/github-exporter.py --self-test"
      ],
      "spend-probe-self-test": [
        "python3 argocd/resources/cloudflare-exporter/spend-probe.py --self-test"
      ],
      "cloudflare-token-audit": [
        "bash scripts/cloudflare-token-audit.sh"
      ],
      "ring": [
        "bash scripts/coordinate-ring.sh \"$@\""
      ],
      "pr-wait": [
        "bash scripts/pr-wait.sh \"$@\""
      ],
      "k9s": [
        "KUBECONFIG=$PWD/tofu/kubeconfig k9s"
      ],
      "nodes": [
        "KUBECONFIG=$PWD/tofu/kubeconfig kubectl get nodes -o wide"
      ],
      "cordon": [
        "kubectl cordon \"$@\""
      ],
      "uncordon": [
        "kubectl uncordon \"$@\""
      ],
      "opnsense": [
        "echo 'Run an OPNsense playbook with creds+httpx interpreter:' && echo '  bash scripts/opnsense-playbook.sh ansible/opnsense-<play>.yml'"
      ],
      "kubeconfig": [
        "tofu -chdir=tofu output -raw kubeconfig > tofu/kubeconfig && chmod 600 tofu/kubeconfig && echo wrote tofu/kubeconfig"
      ],
      "talos-usb": [
        "bash scripts/talos-usb.sh"
      ],
      "keepass-init": [
        "bash scripts/keepass-init.sh"
      ],
      "infisical-secret": [
        "bash scripts/infisical-secret.sh \"$@\""
      ],
      "github-runner-bootstrap": [
        "bash scripts/github-runner-bootstrap.sh \"$@\""
      ],
      "garage-s3": [
        "bash scripts/garage-s3.sh \"$@\""
      ],
      "agent-session": [
        "bash agents/agent-session.sh \"$@\""
      ],
      "coordinator-session": [
        "bash agents/coordinator-session.sh \"$@\""
      ],
      "coordinator-scan": [
        "bash agents/coordinator-scan.sh \"$@\""
      ],
      "coordinator-logs": [
        "bash scripts/coordinator-logs.sh \"$@\""
      ],
      "review-reflex-now": [
        "bash scripts/reflex-now.sh review-reflex"
      ],
      "estimate-budget": [
        "python3 agents/estimate_budget.py \"$@\""
      ],
      "infisical-harden": [
        "bash scripts/infisical-harden.sh"
      ],
      "follow-ups-lint": [
        "sh scripts/follow-ups-lint.sh"
      ],
      "skill-retro-scan": [
        "sh scripts/skill-retro-scan.sh"
      ],
      "doc-heat": [
        "python3 scripts/doc-heat.py"
      ],
      "docs-graph-lint": [
        "sh scripts/docs-graph-lint.sh"
      ],
      "mermaid-lint": [
        "sh scripts/mermaid-lint.sh"
      ],
      "flash-irrigation": [
        "export PLATFORMIO_CORE_DIR=$PWD/esphome/.platformio",
        "test -x esphome/.flash-venv/bin/esphome || python3 -m venv esphome/.flash-venv",
        "esphome/.flash-venv/bin/pip install -q --upgrade esphome",
        "esphome/.flash-venv/bin/esphome run esphome/config/office-plants-irrigation.yaml --device 192.168.2.245 --no-logs",
        "chown -R $(stat -c %u:%g devbox.json) esphome/.flash-venv esphome/.platformio esphome/config/.esphome 2>/dev/null || true"
      ],
      "irrigation-logs": [
        "esphome/.flash-venv/bin/esphome logs esphome/config/office-plants-irrigation.yaml --device 192.168.2.245"
      ],
      "stack-lint": [
        "bash scripts/stack-lint.sh \"$@\""
      ],
      "recipe-lint": [
        "bash agents/recipe-lint.sh \"$@\""
      ],
      "new-stack": [
        "bash scripts/new-stack.sh \"$@\""
      ],
      "merge-path-lint": [
        "python3 scripts/merge-path-lint.py \"$@\""
      ],
      "footprint-test": [
        "bash agents/footprint-test.sh"
      ],
      "touches-check-test": [
        "bash agents/touches-check-test.sh"
      ],
      "model-id-test": [
        "bash agents/model-id-test.sh"
      ],
      "board": [
        "bash agents/board.sh \"$@\""
      ],
      "github-apps-lint": [
        "python3 scripts/github-apps-lint.py"
      ],
      "hubble": [
        "bash scripts/hubble-observe.sh \"$@\""
      ],
      "proxy-self-test": [
        "python3 argocd/resources/openrouter-proxy/openrouter-proxy.py --self-test"
      ],
      "router-self-test": [
        "python3 argocd/resources/openrouter-proxy/router.py --self-test"
      ],
      "shim-self-test": [
        "python3 scripts/claude-model-shim.py --self-test"
      ],
      "storage-ledger": [
        "bash scripts/storage-ledger-check.sh"
      ],
      "ci-timing": [
        "bash scripts/ci-timing.sh \"$@\""
      ]
    }
  }
}